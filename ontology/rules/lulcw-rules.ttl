@prefix lulcw:   <https://w3id.org/lulcw#> .
@prefix lulcwr:  <https://w3id.org/lulcw/rules#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# SHACL-AF rules of the LULC-Water knowledge graph (task 12.6; pySHACL in advanced mode,
# run by src/kg/apply_rules.py). They derive, inside the graph, the links the model's graph is
# made of, from the facts of src/kg/build_kg.py:
#   order 10  stratigraphic relations per elementary polygon, and the `overlies` shortcut (CQ3)
#   order 20  selection of unit attributions by each export policy (CQ1, CQ2)
#   order 21  `monitors` and `pumpsFrom`, the main policy's view of the selected attributions
#   order 30  same-unit well links within the reference radius (CQ11)
#   order 31  pumping influences, facility -> piezometer, through a shared unit or group (CQ8)
#   order 50  land use (CQ7): the crop class of each RPG crop code, the clipped area of each
#             class per zone and RPG year (unmapped codes kept), and a dated high-irrigation-
#             demand assessment per zone and year
#   order 60  recharge-related forcing (CQ4): per reference extent and unit mapped at outcrop,
#             the outcrop area, its part inside weather cells and the weight of each cell
#   order 61  recharge-proxy influences, weather cell -> piezometer, through the outcrop of the
#             unit the well is attributed to, in its search zone or in the unit-wide extent (CQ4,
#             CQ8)
#   order 62  river-unit associations per reach search zone (on outcrop, over cover,
#             documented lateral) and the exchange statements that apply to them (CQ5)
#   order 63  river influences, gauge of arm C's pool -> piezometer (CQ5, CQ8)
#   order 64  canal-unit associations, the canal-return statements that apply, and canal
#             influences from the plain's canal intake group (CQ6, CQ8)
#   order 90  a well link or an influence is selected by a policy only if every unit
#             attribution it derives from is (an unaccepted segment blocks the path); last, so
#             that it sees every derived path (it ran at order 40 until the recharge influences)
# Distances are horizontal, in Lambert-93 metres, parsed from the GeoSPARQL WKT points;
# math:sqrt is the XPath 3.1 function (W3C), registered in rdflib by the runner.
# The rules' descriptions and parameters are the data nodes at the end of this file
# (namespace https://w3id.org/lulcw/data/); the runner copies them into the graph first.
# The graph-wide rules take their own rule node as focus ($this): they read their parameters
# from it, cite it, and run once. (Run once per well instead, rdflib re-joined the pumping
# rule's candidates in a nested loop for every well: 34 s for one well.)

<https://w3id.org/lulcw/rules> a owl:Ontology ;
    dcterms:title "LULC-Water SHACL-AF rules"@en , "Règles SHACL-AF LULC-Water"@fr ;
    dcterms:description "SHACL-AF SPARQL rules that derive stratigraphic relations, policy selections, same-unit well links, pumping influences, land-use classes and categories, outcrop coverages and recharge-proxy influences from the facts of the LULC-Water knowledge graph."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-25"^^xsd:date ;
    sh:declare
        [ sh:prefix "lulcw" ; sh:namespace "https://w3id.org/lulcw#"^^xsd:anyURI ] ,
        [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
        [ sh:prefix "geo" ; sh:namespace "http://www.opengis.net/ont/geosparql#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "xsd" ; sh:namespace "http://www.w3.org/2001/XMLSchema#"^^xsd:anyURI ] ,
        [ sh:prefix "math" ; sh:namespace "http://www.w3.org/2005/xpath-functions/math#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
        [ sh:prefix "sosa" ; sh:namespace "http://www.w3.org/ns/sosa/"^^xsd:anyURI ] .

#################################################################
# CQ3: stratigraphic relations, spatially qualified
#################################################################

lulcwr:StratigraphyShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/stratigraphic-relation> ;
    sh:order 10 ;
    sh:rule lulcwr:stratigraphicRelation , lulcwr:overlies .

# Every pair of units of one polygon's stack, the upper above the lower: a direct contact when
# no layer lies between them, else an indirect ordering with its intervening units. Pairs are
# formed inside one stack only, so an ordering is never chained across polygons.
lulcwr:stratigraphicRelation a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?rel a lulcw:StratigraphicRelation ;
        lulcw:upperUnit ?u1 ; lulcw:lowerUnit ?u2 ; lulcw:relationKind ?kind ;
        lulcw:witnessedBy ?p ; lulcw:interveningUnit ?um ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?l1 , ?l2 ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    ?p a lulcw:ElementaryPolygon ; lulcw:hasStackLayer ?l1 , ?l2 .
    ?l1 lulcw:layerOrder ?o1 ; lulcw:layerUnit ?u1 .
    ?l2 lulcw:layerOrder ?o2 ; lulcw:layerUnit ?u2 .
    FILTER (?o1 < ?o2)
    OPTIONAL {
        ?p lulcw:hasStackLayer ?lm .
        ?lm lulcw:layerOrder ?om ; lulcw:layerUnit ?um .
        FILTER (?o1 < ?om && ?om < ?o2)
    }
    BIND (IF(BOUND(?um), lulcw:IndirectOrdering, lulcw:DirectContact) AS ?kind)
    ?u1 lulcw:bdlisaCode ?c1 .
    ?u2 lulcw:bdlisaCode ?c2 .
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/stratigraphic-relation/",
                     STRAFTER(STR(?p), "/polygon/"), "/", ENCODE_FOR_URI(?c1), "/",
                     ENCODE_FOR_URI(?c2))) AS ?rel)
}
""" .

# The shortcut: a unit overlies another where a polygon shows them in direct contact.
# Deliberately not transitive.
lulcwr:overlies a sh:SPARQLRule ;
    sh:order 2 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?u1 lulcw:overlies ?u2 . }
WHERE {
    ?rel lulcw:derivationRule $this ; lulcw:relationKind lulcw:DirectContact ;
         lulcw:upperUnit ?u1 ; lulcw:lowerUnit ?u2 .
}
""" .

#################################################################
# CQ1, CQ2: selection of unit attributions by the export policies
#################################################################

lulcwr:PolicySelectionShape a sh:NodeShape ;
    sh:targetClass lulcw:ExportPolicy ;
    sh:order 20 ;
    sh:rule lulcwr:selectAttributions .

# A policy selects the attributions whose confidence it admits, at the resolution they were
# assessed (a group-level attribution stays a group-level selection). Unknowns have no
# confidence and are never selected.
lulcwr:selectAttributions a sh:SPARQLRule ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?a lulcw:selectedUnder $this . }
WHERE {
    $this lulcw:admitsConfidence ?c .
    ?a a lulcw:UnitAttribution ; lulcw:confidence ?c .
    { ?a lulcw:candidateUnit ?t } UNION { ?a lulcw:candidateGroup ?t }
}
""" .

lulcwr:MainProjectionShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/policy/main> ;
    sh:order 21 ;
    sh:rule lulcwr:monitors , lulcwr:pumpsFrom .

# The main policy's view: exact-unit attributions only (lulcw:monitors and lulcw:pumpsFrom
# point to a unit, never to a group). Other policies are read through lulcw:selectedUnder.
lulcwr:monitors a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?e lulcw:monitors ?u . }
WHERE {
    ?a lulcw:selectedUnder $this ; lulcw:role lulcw:MonitoringRole ;
       lulcw:attributedEntity ?e ; lulcw:candidateUnit ?u .
}
""" .

lulcwr:pumpsFrom a sh:SPARQLRule ;
    sh:order 2 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?e lulcw:pumpsFrom ?u . }
WHERE {
    ?a lulcw:selectedUnder $this ; lulcw:role lulcw:AbstractionRole ;
       lulcw:attributedEntity ?e ; lulcw:candidateUnit ?u .
}
""" .

#################################################################
# CQ11: same-unit well links; CQ8: pumping influences
#################################################################

lulcwr:WellLinkShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/well-link> ;
    sh:order 30 ;
    sh:rule lulcwr:wellLink .

# Two piezometers attributed to the same exact unit (any confidence; policies select later),
# within the rule's search radius (inclusive). Stored once per unordered pair, the well whose
# BSS code sorts first as wellA. The depth difference is stated only when both investigation
# depths are known: a missing depth stays missing, never 0. Confidence = the lower of the two.
lulcwr:wellLink a sh:SPARQLRule ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?link a lulcw:WellLink ;
        lulcw:wellA ?w1 ; lulcw:wellB ?w2 ; lulcw:sharedUnit ?u ;
        lulcw:horizontalDistanceM ?d ; lulcw:investigationDepthDifferenceM ?dz ;
        lulcw:confidence ?conf ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?a1 , ?a2 ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    $this lulcw:searchRadiusM ?r .
    ?a1 lulcw:role lulcw:MonitoringRole ; lulcw:attributedEntity ?w1 ;
        lulcw:candidateUnit ?u ; lulcw:confidence ?c1 .
    ?a2 lulcw:role lulcw:MonitoringRole ; lulcw:attributedEntity ?w2 ;
        lulcw:candidateUnit ?u ; lulcw:confidence ?c2 .
    ?w1 lulcw:bssCode ?b1 .
    ?w2 lulcw:bssCode ?b2 .
    FILTER (?b1 < ?b2)
    ?w1 geo:hasGeometry/geo:asWKT ?g1 .
    ?w2 geo:hasGeometry/geo:asWKT ?g2 .
    BIND (STRAFTER(STR(?g1), "POINT(") AS ?p1)
    BIND (STRAFTER(STR(?g2), "POINT(") AS ?p2)
    BIND (xsd:double(STRBEFORE(?p1, " ")) - xsd:double(STRBEFORE(?p2, " ")) AS ?dx)
    BIND (xsd:double(STRBEFORE(STRAFTER(?p1, " "), ")"))
          - xsd:double(STRBEFORE(STRAFTER(?p2, " "), ")")) AS ?dy)
    FILTER (?dx * ?dx + ?dy * ?dy <= ?r * ?r)
    BIND (math:sqrt(?dx * ?dx + ?dy * ?dy) AS ?d)
    OPTIONAL {
        ?w1 lulcw:investigationDepthM ?z1 .
        ?w2 lulcw:investigationDepthM ?z2 .
        BIND (ABS(?z1 - ?z2) AS ?dz)
    }
    BIND (IF(?c1 = lulcw:Possible || ?c2 = lulcw:Possible, lulcw:Possible,
             IF(?c1 = lulcw:Probable || ?c2 = lulcw:Probable, lulcw:Probable, lulcw:Confident))
          AS ?conf)
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/well-link/",
                     STRAFTER(STR(?w1), "/piezometer/"), "/",
                     STRAFTER(STR(?w2), "/piezometer/"))) AS ?link)
}
""" .

lulcwr:PumpingInfluenceShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/pumping-influence> ;
    sh:order 31 ;
    sh:rule lulcwr:pumpingInfluenceExact , lulcwr:pumpingInfluenceGroup .

# One influence per evidence path: a facility attribution (abstraction role) and a well
# attribution (monitoring role) meeting at the exact unit the well monitors (first rule), or at
# a unit group that contains it (second rule), within the rule's search radius. Exact-unit
# paths carry the non-increasing sign of pumping drawdown and are eligible to constrain a
# model; group-level paths keep an unknown (conditional) sign and are not eligible: the
# facility may pump a different member of the group, so the connection condition is not
# established. Unknown attributions have no target and never produce an influence.
lulcwr:pumpingInfluenceExact a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?inf a lulcw:Influence ;
        lulcw:driverEntity ?f ; lulcw:targetEntity ?w ;
        lulcw:driverVariable lulcw:ReconstructedWeeklyVolume ;
        lulcw:mechanism lulcw:PumpingDrawdown ;
        lulcw:responseSign lulcw:NegativeResponse ;
        lulcw:driverGroup lulcw:SummerDemand ;
        lulcw:horizontalDistanceM ?d ;
        lulcw:resolution lulcw:ExactUnitResolution ;
        lulcw:confidence ?conf ;
        lulcw:constraintEligibility lulcw:EligibleConstraint ;
        lulcw:eligibilityReason "The facility and the well are attributed to the same exact unit: the non-increasing response of pumping drawdown applies. The constraint is applied only under a policy that selects both attributions." ;
        lulcw:conditions ?cond ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?af , ?aw ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {   # the candidate pairs within the radius (filtered before the texts are built)
        $this lulcw:searchRadiusM ?r .
        ?aw lulcw:role lulcw:MonitoringRole ; lulcw:attributedEntity ?w ;
            lulcw:candidateUnit ?u ; lulcw:confidence ?cw .
        ?af lulcw:candidateUnit ?u .
        ?af lulcw:role lulcw:AbstractionRole ; lulcw:attributedEntity ?f ; lulcw:confidence ?cf .
        ?w geo:hasGeometry/geo:asWKT ?g1 .
        ?f geo:hasGeometry/geo:asWKT ?g2 .
        BIND (STRAFTER(STR(?g1), "POINT(") AS ?p1)
        BIND (STRAFTER(STR(?g2), "POINT(") AS ?p2)
        BIND (xsd:double(STRBEFORE(?p1, " ")) - xsd:double(STRBEFORE(?p2, " ")) AS ?dx)
        BIND (xsd:double(STRBEFORE(STRAFTER(?p1, " "), ")"))
              - xsd:double(STRBEFORE(STRAFTER(?p2, " "), ")")) AS ?dy)
        FILTER (?dx * ?dx + ?dy * ?dy <= ?r * ?r)
    }
    ?u lulcw:bdlisaCode ?code .
    BIND (math:sqrt(?dx * ?dx + ?dy * ?dy) AS ?d)
    BIND (CONCAT("The facility pumps from ", CONCAT("unit ", ?code), ", which the well monitors; horizontal distance ",
                 STR(xsd:integer(ROUND(?d))), " m, within the reference search radius of ",
                 STR(xsd:integer(ROUND(?r))), " m (the export may apply a threshold frozen on the training period); ",
                 "the sign refers to an increase of the facility's weekly abstraction with the other drivers held fixed.")
          AS ?cond)
    BIND (IF(?cw = lulcw:Possible || ?cf = lulcw:Possible, lulcw:Possible,
             IF(?cw = lulcw:Probable || ?cf = lulcw:Probable, lulcw:Probable, lulcw:Confident))
          AS ?conf)
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/influence/pumping/",
                     STRAFTER(STR(?af), "/attribution/facility/"), "/to/",
                     STRAFTER(STR(?aw), "/attribution/piezometer/"))) AS ?inf)
}
""" .

lulcwr:pumpingInfluenceGroup a sh:SPARQLRule ;
    sh:order 2 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?inf a lulcw:Influence ;
        lulcw:driverEntity ?f ; lulcw:targetEntity ?w ;
        lulcw:driverVariable lulcw:ReconstructedWeeklyVolume ;
        lulcw:mechanism lulcw:PumpingDrawdown ;
        lulcw:responseSign lulcw:UnknownResponse ;
        lulcw:driverGroup lulcw:SummerDemand ;
        lulcw:horizontalDistanceM ?d ;
        lulcw:resolution lulcw:UnitGroupResolution ;
        lulcw:confidence ?conf ;
        lulcw:constraintEligibility lulcw:IneligibleConstraint ;
        lulcw:eligibilityReason "The facility is attributed only to a unit group that contains the well's unit: it may pump another member of the group, so the connection condition of pumping drawdown is not established; an unsigned graph edge at most." ;
        lulcw:conditions ?cond ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?af , ?aw ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {   # the candidate pairs within the radius (filtered before the texts are built)
        $this lulcw:searchRadiusM ?r .
        ?aw lulcw:role lulcw:MonitoringRole ; lulcw:attributedEntity ?w ;
            lulcw:candidateUnit ?u ; lulcw:confidence ?cw .
        ?g lulcw:hasMemberUnit ?u ; rdfs:label ?gl .
        FILTER (LANGMATCHES(LANG(?gl), "en"))
        ?af lulcw:candidateGroup ?g .
        ?af lulcw:role lulcw:AbstractionRole ; lulcw:attributedEntity ?f ; lulcw:confidence ?cf .
        ?w geo:hasGeometry/geo:asWKT ?g1 .
        ?f geo:hasGeometry/geo:asWKT ?g2 .
        BIND (STRAFTER(STR(?g1), "POINT(") AS ?p1)
        BIND (STRAFTER(STR(?g2), "POINT(") AS ?p2)
        BIND (xsd:double(STRBEFORE(?p1, " ")) - xsd:double(STRBEFORE(?p2, " ")) AS ?dx)
        BIND (xsd:double(STRBEFORE(STRAFTER(?p1, " "), ")"))
              - xsd:double(STRBEFORE(STRAFTER(?p2, " "), ")")) AS ?dy)
        FILTER (?dx * ?dx + ?dy * ?dy <= ?r * ?r)
    }
    ?u lulcw:bdlisaCode ?code .
    BIND (math:sqrt(?dx * ?dx + ?dy * ?dy) AS ?d)
    BIND (CONCAT("The facility pumps from ", CONCAT("unit group '", STR(?gl), "', which contains unit ", ?code), ", which the well monitors; horizontal distance ",
                 STR(xsd:integer(ROUND(?d))), " m, within the reference search radius of ",
                 STR(xsd:integer(ROUND(?r))), " m (the export may apply a threshold frozen on the training period); ",
                 "the sign refers to an increase of the facility's weekly abstraction with the other drivers held fixed.")
          AS ?cond)
    BIND (IF(?cw = lulcw:Possible || ?cf = lulcw:Possible, lulcw:Possible,
             IF(?cw = lulcw:Probable || ?cf = lulcw:Probable, lulcw:Probable, lulcw:Confident))
          AS ?conf)
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/influence/pumping/",
                     STRAFTER(STR(?af), "/attribution/facility/"), "/to/",
                     STRAFTER(STR(?aw), "/attribution/piezometer/"))) AS ?inf)
}
""" .

#################################################################
# Path selection: every segment selected, or the path is not
#################################################################

lulcwr:PathSelectionShape a sh:NodeShape ;
    sh:targetClass lulcw:ExportPolicy ;
    sh:order 90 ;
    sh:rule lulcwr:selectPaths .

# Counted rather than tested with nested NOT EXISTS: a path is selected when the number of
# its attributions selected by the policy equals the number of its attributions (rdflib took
# over a minute per policy with the nested form).
lulcwr:selectPaths a sh:SPARQLRule ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?x lulcw:selectedUnder $this . }
WHERE {
    {
        SELECT $this ?x WHERE {
            ?x prov:wasDerivedFrom ?a ; a ?kind .
            FILTER (?kind = lulcw:WellLink || ?kind = lulcw:Influence)
            ?a a lulcw:UnitAttribution .
            OPTIONAL { ?a lulcw:selectedUnder $this . BIND (?a AS ?selected) }
        }
        GROUP BY $this ?x
        HAVING (COUNT(DISTINCT ?a) = COUNT(DISTINCT ?selected))
    }
}
""" .

#################################################################
# CQ7: land use
#################################################################

lulcwr:CropClassMappingShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/crop-class> ;
    sh:order 50 ;
    sh:rule lulcwr:cropClassOfCode .

# The mapping of configs/lu_crop_classes.csv: a code listed as an override of a class takes
# that class; otherwise the class that takes its RPG crop group; otherwise none (its area is
# then counted as unmapped).
lulcwr:cropClassOfCode a sh:SPARQLRule ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?code lulcw:cropClass ?class . }
WHERE {
    ?code a lulcw:CropCode ; skos:notation ?n .
    {
        ?class a lulcw:CropClass ; lulcw:overrideCode ?n .
    } UNION {
        ?code lulcw:rpgGroupCode ?g .
        ?class a lulcw:CropClass ; lulcw:rpgGroupCode ?g .
        FILTER NOT EXISTS { ?other a lulcw:CropClass ; lulcw:overrideCode ?n . }
    }
}
""" .

lulcwr:CropClassAreaShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/crop-class-area> ;
    sh:order 51 ;
    sh:rule lulcwr:cropClassArea , lulcwr:cropClassAreaEvidence .

# Clipped area per zone, RPG edition and class: the sum of its codes' observations. Codes
# without a class go to the "unmapped" class, so every total keeps them.
lulcwr:cropClassArea a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?ca a lulcw:CropClassArea ;
        sosa:hasFeatureOfInterest ?zone ; sosa:observedProperty lulcw:ClippedCropArea ;
        sosa:hasSimpleResult ?ha ; sosa:phenomenonTime ?t ; lulcw:rpgEdition ?ed ;
        lulcw:cropClass ?cls ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {
        SELECT ?zone ?t ?ed ?cls (SUM(?a) AS ?ha) WHERE {
            ?o a lulcw:CropAreaObservation ; sosa:hasFeatureOfInterest ?zone ;
               sosa:phenomenonTime ?t ; lulcw:rpgEdition ?ed ; lulcw:cropCode ?code ;
               sosa:hasSimpleResult ?a .
            OPTIONAL { ?code lulcw:cropClass ?c . }
            BIND (COALESCE(?c, <crop-class/unmapped>) AS ?cls)
        }
        GROUP BY ?zone ?t ?ed ?cls
    }
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/crop-class-area/", STRAFTER(STR(?zone), "/zone/"),
                     "/", STR(?ed), "/", STRAFTER(STR(?cls), "/crop-class/"))) AS ?ca)
}
""" .

lulcwr:cropClassAreaEvidence a sh:SPARQLRule ;
    sh:order 2 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT { ?ca prov:wasDerivedFrom ?o . }
WHERE {
    ?o a lulcw:CropAreaObservation ; sosa:hasFeatureOfInterest ?zone ; lulcw:rpgEdition ?ed ;
       lulcw:cropCode ?code .
    OPTIONAL { ?code lulcw:cropClass ?c . }
    BIND (COALESCE(?c, <crop-class/unmapped>) AS ?cls)
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/crop-class-area/", STRAFTER(STR(?zone), "/zone/"),
                     "/", STR(?ed), "/", STRAFTER(STR(?cls), "/crop-class/"))) AS ?ca)
    ?ca lulcw:derivationRule $this .
}
""" .

lulcwr:DemandAssessmentShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/high-irrigation-demand> ;
    sh:order 52 ;
    sh:rule lulcwr:assessDemand .

# A dated category for every zone and calendar year with a main demand estimate: high when the
# estimate reaches the rule's threshold (lulcw:demandThresholdM3), below otherwise.
lulcwr:assessDemand a sh:SPARQLRule ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?as a lulcw:IrrigationDemandAssessment ;
        sosa:hasFeatureOfInterest ?zone ; sosa:observedProperty lulcw:PotentialIrrigationDemandMain ;
        sosa:phenomenonTime ?t ; lulcw:demandCategory ?cat ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?est ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    $this lulcw:demandThresholdM3 ?thr .
    ?est a lulcw:CropDemandEstimate ; sosa:observedProperty lulcw:PotentialIrrigationDemandMain ;
         sosa:hasFeatureOfInterest ?zone ; sosa:phenomenonTime ?t ; sosa:hasSimpleResult ?v .
    BIND (IF(?v >= ?thr, lulcw:HighIrrigationDemand, lulcw:BelowHighIrrigationDemand) AS ?cat)
    BIND (IRI(CONCAT(STR(?est), "/assessment")) AS ?as)
}
""" .

#################################################################
# CQ4: outcrop coverage and cell weights per unit and reference extent
#################################################################

lulcwr:OutcropCoverageShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/outcrop-coverage> ;
    sh:order 60 ;
    sh:rule lulcwr:outcropCoverage , lulcwr:outcropCoverageEvidence , lulcwr:cellWeight .

# For each reference extent and each unit mapped at outcrop (order 1) in a polygon that has a
# part in the extent: the outcrop area (every part of those polygons in the extent), the
# covered area (the parts inside a weather cell) and their ratio. A unit with no outcrop in the
# extent gets no coverage: "no mapped outcrop", never a zero recharge.
# Join order: rdflib sorts a basic graph pattern again when it evaluates it, by the number of
# terms not yet bound (a stable sort), so a constant such as "lulcw:layerOrder 1" would pull its
# pattern ahead of the piece's own polygon and cross every piece with every order-1 layer (the
# first version ran for over 25 minutes). The order is therefore a variable tested by a FILTER,
# and each pattern follows the one that binds its subject.
lulcwr:outcropCoverage a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?cov a lulcw:OutcropCoverage ; lulcw:coverageUnit ?u ; lulcw:withinExtent ?s ;
         lulcw:outcropAreaM2 ?area ; lulcw:coveredAreaM2 ?covered ; lulcw:coveredFraction ?frac ;
         lulcw:evidenceKind lulcw:DerivedAssertion ;
         lulcw:derivationRule $this ;
         prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {
        SELECT ?s ?u (SUM(?a) AS ?area) (SUM(?in) AS ?covered) WHERE {
            ?x a lulcw:PolygonCellIntersection ; lulcw:intersectedPolygon ?p ;
               lulcw:withinExtent ?s ; lulcw:intersectionAreaM2 ?a .
            ?p lulcw:hasStackLayer ?l .
            ?l lulcw:layerOrder ?order ; lulcw:layerUnit ?u .
            FILTER (?order = 1)
            OPTIONAL { ?x lulcw:intersectedCell ?c . }
            BIND (IF(BOUND(?c), ?a, 0.0) AS ?in)
        }
        GROUP BY ?s ?u
    }
    BIND (?covered / ?area AS ?frac)
    BIND (IRI(CONCAT(STR(?s), "/outcrop-coverage/", STRAFTER(STR(?u), "/unit/"))) AS ?cov)
}
""" .

# The pieces are the subjects of lulcw:intersectedPolygon (its domain): no class pattern for ?x,
# which as a one-variable pattern would be sorted ahead and crossed with every coverage.
lulcwr:outcropCoverageEvidence a sh:SPARQLRule ;
    sh:order 2 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?cov prov:wasDerivedFrom ?x . }
WHERE {
    ?cov lulcw:derivationRule $this ; a lulcw:OutcropCoverage ; lulcw:coverageUnit ?u ;
         lulcw:withinExtent ?s .
    ?x lulcw:withinExtent ?s ; lulcw:intersectedPolygon ?p .
    ?p lulcw:hasStackLayer ?l .
    ?l lulcw:layerUnit ?u ; lulcw:layerOrder ?order .
    FILTER (?order = 1)
}
""" .

# The weight of each cell: the covered outcrop area inside it divided by the coverage's covered
# area (renormalised over the covered area; the coverage's covered fraction says how much of the
# outcrop that is).
lulcwr:cellWeight a sh:SPARQLRule ;
    sh:order 3 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?cov lulcw:hasCellWeight ?cw .
    ?cw a lulcw:CellWeight ; lulcw:weightCell ?c ; lulcw:coveredAreaM2 ?ca ; lulcw:cellWeight ?wgt ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {
        SELECT ?s ?u ?c (SUM(?a) AS ?ca) WHERE {
            ?x a lulcw:PolygonCellIntersection ; lulcw:intersectedPolygon ?p ;
               lulcw:withinExtent ?s ; lulcw:intersectedCell ?c ; lulcw:intersectionAreaM2 ?a .
            ?p lulcw:hasStackLayer ?l .
            ?l lulcw:layerOrder ?order ; lulcw:layerUnit ?u .
            FILTER (?order = 1)
        }
        GROUP BY ?s ?u ?c
    }
    ?cov lulcw:coverageUnit ?u ; lulcw:withinExtent ?s ; a lulcw:OutcropCoverage ;
         lulcw:derivationRule $this ; lulcw:coveredAreaM2 ?tot .
    FILTER (?tot > 0)
    BIND (?ca / ?tot AS ?wgt)
    BIND (IRI(CONCAT(STR(?cov), "/", STRAFTER(STR(?c), "/weather-cell/"))) AS ?cw)
}
""" .

#################################################################
# CQ4, CQ8: recharge-proxy influences, weather cell -> piezometer
#################################################################

lulcwr:RechargeInfluenceShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/recharge-influence> ;
    sh:order 61 ;
    sh:rule lulcwr:rechargeInfluenceLocal , lulcwr:rechargeInfluenceUnitWide .

# One influence per weather cell and well attribution: the cell holds part of the outcrop of the
# exact unit the well is attributed to (any confidence; the policies select later), inside the
# well's outcrop search zone (first rule: the main runs, decided by Assil on 2026-10-26) or inside
# a fixed extent of the rule (second rule: the unit-wide sensitivity, the forcing cells, where
# every well of a unit gets the same cells). The driver is the cell's weekly effective rainfall,
# the one recharge proxy of the main runs: soil drainage is part of the same surplus, so a
# sensitivity replaces PE by it and never adds it (analysis plan §14 item 15). Its sign is the
# non-decreasing response of diffuse recharge; the influence names the pathways it does not
# represent. A unit without outcrop in the extent gives no influence, which is not zero recharge
# (CQ4). Join order (see the CQ4 rules): no constant object and no class pattern in the joins,
# each pattern after the one that binds its subject; the role is tested by a FILTER.
lulcwr:rechargeInfluenceLocal a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?inf a lulcw:Influence ;
        lulcw:driverEntity ?c ; lulcw:targetEntity ?w ;
        lulcw:driverVariable lulcw:EffectiveRainfall ; lulcw:proxyFor lulcw:GroundwaterRecharge ;
        lulcw:mechanism lulcw:DiffuseRecharge ;
        lulcw:responseSign lulcw:PositiveResponse ;
        lulcw:driverGroup lulcw:RechargeProxies ;
        lulcw:withinExtent ?s ;
        lulcw:resolution lulcw:ExactUnitResolution ;
        lulcw:confidence ?conf ;
        lulcw:constraintEligibility lulcw:EligibleConstraint ;
        lulcw:eligibilityReason "The cell holds mapped outcrop of the exact unit the well is attributed to, so the non-decreasing response of diffuse recharge applies to its effective rainfall: more rain on the unit's outcrop does not lower the unit's head. A recharge proxy, not a recharge: outcrop does not prove infiltration, and the pathways named by lulcw:omitsPathway are not represented. Whether recharge signs constrain the model, and with which proxy (effective rainfall in the main runs, soil drainage as a sensitivity, never both), is settled at Gate 3 (analysis plan, section 14 item 15)." ;
        lulcw:conditions ?cond ;
        lulcw:omitsPathway lulcw:LateralInflow , lulcw:VerticalLeakage , lulcw:RiverExchange , lulcw:CanalReturnFlow ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?aw , ?cov , ?cw ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {   # the well's zone, its attribution and unit, the unit's coverage in the zone, its cells
        ?s lulcw:zoneOf ?w .
        ?aw lulcw:attributedEntity ?w ; lulcw:role ?role ; lulcw:candidateUnit ?u ; lulcw:confidence ?conf .
        FILTER (?role = lulcw:MonitoringRole)
        ?cov lulcw:withinExtent ?s ; lulcw:coverageUnit ?u ; lulcw:coveredFraction ?frac ;
             lulcw:hasCellWeight ?cw .
        ?cw lulcw:weightCell ?c ; lulcw:cellWeight ?wt .
        ?s lulcw:zoneRadiusM ?r .
    }
    ?u lulcw:bdlisaCode ?code .
    BIND (CONCAT("Effective rainfall of this weather cell over the outcrop of unit ", ?code,
                 " mapped within ", STR(xsd:integer(ROUND(?r))), " m of the well (the main runs' local extent): ",
                 "the cell holds a share ", IF(?wt < 0.001, "under 0.001", STR(ROUND(?wt * 1000) / 1000)), " of that outcrop, the shares renormalised ",
                 "over the part inside weather cells (covered fraction ", STR(ROUND(?frac * 1000) / 1000), "). ",
                 "The sign refers to an increase of the cell's weekly effective rainfall with the other drivers held fixed.")
          AS ?cond)
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/influence/recharge/local/",
                     STRAFTER(STR(?c), "/weather-cell/"), "/to/",
                     STRAFTER(STR(?aw), "/attribution/piezometer/"))) AS ?inf)
}
""" .

lulcwr:rechargeInfluenceUnitWide a sh:SPARQLRule ;
    sh:order 2 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?inf a lulcw:Influence ;
        lulcw:driverEntity ?c ; lulcw:targetEntity ?w ;
        lulcw:driverVariable lulcw:EffectiveRainfall ; lulcw:proxyFor lulcw:GroundwaterRecharge ;
        lulcw:mechanism lulcw:DiffuseRecharge ;
        lulcw:responseSign lulcw:PositiveResponse ;
        lulcw:driverGroup lulcw:RechargeProxies ;
        lulcw:withinExtent ?s ;
        lulcw:resolution lulcw:ExactUnitResolution ;
        lulcw:confidence ?conf ;
        lulcw:constraintEligibility lulcw:EligibleConstraint ;
        lulcw:eligibilityReason "The cell holds mapped outcrop of the exact unit the well is attributed to, so the non-decreasing response of diffuse recharge applies to its effective rainfall: more rain on the unit's outcrop does not lower the unit's head. A recharge proxy, not a recharge: outcrop does not prove infiltration, and the pathways named by lulcw:omitsPathway are not represented. Whether recharge signs constrain the model, and with which proxy (effective rainfall in the main runs, soil drainage as a sensitivity, never both), is settled at Gate 3 (analysis plan, section 14 item 15)." ;
        lulcw:conditions ?cond ;
        lulcw:omitsPathway lulcw:LateralInflow , lulcw:VerticalLeakage , lulcw:RiverExchange , lulcw:CanalReturnFlow ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?aw , ?cov , ?cw ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {   # the rule's fixed extents, the coverages there, the wells attributed to their units
        $this lulcw:appliesInExtent ?s .
        ?cov lulcw:withinExtent ?s ; lulcw:coverageUnit ?u ; lulcw:coveredFraction ?frac ;
             lulcw:outcropAreaM2 ?o .
        ?aw lulcw:candidateUnit ?u ; lulcw:attributedEntity ?w .
        ?w lulcw:bssCode ?b .
        ?aw lulcw:role ?role ; lulcw:confidence ?conf .
        FILTER (?role = lulcw:MonitoringRole)
        ?cov lulcw:hasCellWeight ?cw .
        ?cw lulcw:weightCell ?c ; lulcw:cellWeight ?wt .
    }
    ?u lulcw:bdlisaCode ?code ; lulcw:mappedOutcropAreaM2 ?m .
    BIND (IF(?o < ?m * (1 - 1e-6) - 10.0,
             CONCAT(" The extent holds a share ", STR(ROUND(?o / ?m * 1000) / 1000), " of the unit's mapped outcrop: ",
                    "rain on the rest is not represented."), "") AS ?clip)
    BIND (CONCAT("Effective rainfall of this weather cell over the outcrop of unit ", ?code,
                 " in the forcing extent (the unit-wide sensitivity: every well of the unit gets the same cells): ",
                 "the cell holds a share ", IF(?wt < 0.001, "under 0.001", STR(ROUND(?wt * 1000) / 1000)), " of that outcrop, the shares renormalised ",
                 "over the part inside weather cells (covered fraction ", STR(ROUND(?frac * 1000) / 1000), ").", ?clip,
                 " The sign refers to an increase of the cell's weekly effective rainfall with the other drivers held fixed.")
          AS ?cond)
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/influence/recharge/unit-wide/",
                     STRAFTER(STR(?c), "/weather-cell/"), "/to/",
                     STRAFTER(STR(?aw), "/attribution/piezometer/"))) AS ?inf)
}
""" .

#################################################################
# CQ5: river-unit associations in each reach search zone, and the statements that apply
#################################################################

lulcwr:RiverAssociationShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/river-association> ;
    sh:order 62 ;
    sh:rule lulcwr:riverOnOutcrop , lulcwr:riverOverCover , lulcwr:riverCoverUnits ,
        lulcwr:riverDocumentedLateral , lulcwr:riverApplicableStatement .

# For each reach search zone, watercourse and unit that a monitoring attribution of the zone's
# well names (any confidence: the policies select later, through the influences): the length of
# the watercourse's reach pieces that run on polygons where the unit is at outcrop (order 1).
# Each piece is counted once even when two attributions of the well name the same unit (the
# DISTINCT sub-select). A geometric association, not a hydraulic connection (CQ5). Join order
# (see the CQ4 rules): no constant object and no class pattern in the joins; the orders and the
# role are tested by FILTERs.
lulcwr:riverOnOutcrop a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?as a lulcw:RiverUnitAssociation ; lulcw:withinExtent ?z ; lulcw:associationWatercourse ?wc ;
        lulcw:associationUnit ?u ; lulcw:associationType lulcw:OnOutcrop ; lulcw:lengthOnOutcropM ?len ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {
        SELECT ?z ?wc ?u (SUM(?l) AS ?len) WHERE {
            {
                SELECT DISTINCT ?z ?wc ?u ?p ?l WHERE {
                    ?p lulcw:pieceOfReach ?r ; lulcw:withinExtent ?z ; lulcw:piecePolygon ?poly ;
                       lulcw:pieceLengthM ?l .
                    ?r lulcw:reachOf ?wc .
                    ?z lulcw:zoneOf ?w .
                    ?aw lulcw:attributedEntity ?w ; lulcw:role ?role ; lulcw:candidateUnit ?u .
                    FILTER (?role = lulcw:MonitoringRole)
                    ?poly lulcw:hasStackLayer ?ly .
                    ?ly lulcw:layerUnit ?u ; lulcw:layerOrder ?o .
                    FILTER (?o = 1)
                }
            }
        }
        GROUP BY ?z ?wc ?u
    }
    BIND (IRI(CONCAT(STR(?z), "/river/", STRAFTER(STR(?wc), "/watercourse/"), "/",
                     STRAFTER(STR(?u), "/unit/"), "/on-outcrop")) AS ?as)
}
""" .

# The same where the unit lies below other mapped units under the reach (order above 1): any
# exchange with the river passes through those units (e.g. the Quaternary over the Pliocene).
lulcwr:riverOverCover a sh:SPARQLRule ;
    sh:order 2 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?as a lulcw:RiverUnitAssociation ; lulcw:withinExtent ?z ; lulcw:associationWatercourse ?wc ;
        lulcw:associationUnit ?u ; lulcw:associationType lulcw:OverCover ; lulcw:lengthOverCoverM ?len ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {
        SELECT ?z ?wc ?u (SUM(?l) AS ?len) WHERE {
            {
                SELECT DISTINCT ?z ?wc ?u ?p ?l WHERE {
                    ?p lulcw:pieceOfReach ?r ; lulcw:withinExtent ?z ; lulcw:piecePolygon ?poly ;
                       lulcw:pieceLengthM ?l .
                    ?r lulcw:reachOf ?wc .
                    ?z lulcw:zoneOf ?w .
                    ?aw lulcw:attributedEntity ?w ; lulcw:role ?role ; lulcw:candidateUnit ?u .
                    FILTER (?role = lulcw:MonitoringRole)
                    ?poly lulcw:hasStackLayer ?ly .
                    ?ly lulcw:layerUnit ?u ; lulcw:layerOrder ?o .
                    FILTER (?o > 1)
                }
            }
        }
        GROUP BY ?z ?wc ?u
    }
    BIND (IRI(CONCAT(STR(?z), "/river/", STRAFTER(STR(?wc), "/watercourse/"), "/",
                     STRAFTER(STR(?u), "/unit/"), "/over-cover")) AS ?as)
}
""" .

# The cover: the units above the associated unit in the polygons under the association's pieces.
lulcwr:riverCoverUnits a sh:SPARQLRule ;
    sh:order 3 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?as lulcw:coverUnit ?cu . }
WHERE {
    ?as lulcw:derivationRule $this ; lulcw:associationType ?t ; lulcw:withinExtent ?z ;
        lulcw:associationWatercourse ?wc ; lulcw:associationUnit ?u .
    FILTER (?t = lulcw:OverCover)
    ?p lulcw:withinExtent ?z ; lulcw:pieceOfReach ?r ; lulcw:piecePolygon ?poly .
    ?r lulcw:reachOf ?wc .
    ?poly lulcw:hasStackLayer ?ly .
    ?ly lulcw:layerUnit ?u ; lulcw:layerOrder ?o .
    ?poly lulcw:hasStackLayer ?ly2 .
    ?ly2 lulcw:layerOrder ?o2 ; lulcw:layerUnit ?cu .
    FILTER (?o2 < ?o)
}
""" .

# A documented lateral association: no reach of the watercourse in the zone runs on or over the
# unit, but a source documents an exchange (a direction other than no exchange or not qualified)
# between the unit and a section that holds reach pieces of the watercourse in the zone, e.g. the
# ancient alluvium of the Têt draining laterally to the river (BRGM/RP-71486-FR).
lulcwr:riverDocumentedLateral a sh:SPARQLRule ;
    sh:order 4 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?as a lulcw:RiverUnitAssociation ; lulcw:withinExtent ?z ; lulcw:associationWatercourse ?wc ;
        lulcw:associationUnit ?u ; lulcw:associationType lulcw:DocumentedLateral ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {
        SELECT DISTINCT ?z ?wc ?u WHERE {
            ?s lulcw:aboutSection ?sec ; lulcw:aboutUnit ?u ; lulcw:statedMechanism ?m ;
               lulcw:exchangeDirection ?dir .
            FILTER (?m = lulcw:RiverExchange
                    && (?dir = lulcw:AquiferToSurface || ?dir = lulcw:SurfaceToAquifer
                        || ?dir = lulcw:ExchangeEquilibrium))
            ?p lulcw:inSection ?sec ; lulcw:withinExtent ?z ; lulcw:pieceOfReach ?r .
            ?r lulcw:reachOf ?wc .
            ?z lulcw:zoneOf ?w .
            ?aw lulcw:attributedEntity ?w ; lulcw:role ?role ; lulcw:candidateUnit ?u .
            FILTER (?role = lulcw:MonitoringRole)
        }
    }
    FILTER NOT EXISTS {
        ?b lulcw:withinExtent ?z ; lulcw:associationWatercourse ?wc ; lulcw:associationUnit ?u ;
           lulcw:derivationRule $this .
    }
    BIND (IRI(CONCAT(STR(?z), "/river/", STRAFTER(STR(?wc), "/watercourse/"), "/",
                     STRAFTER(STR(?u), "/unit/"), "/documented-lateral")) AS ?as)
}
""" .

# The statements that apply to an association: about its unit and about a section that holds a
# reach piece of its watercourse in its zone (a statement that does not delimit its stretch
# applies to no zone).
lulcwr:riverApplicableStatement a sh:SPARQLRule ;
    sh:order 5 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?as lulcw:applicableStatement ?s . }
WHERE {
    ?as lulcw:derivationRule $this ; lulcw:withinExtent ?z ; lulcw:associationWatercourse ?wc ;
        lulcw:associationUnit ?u .
    ?s lulcw:aboutUnit ?u ; lulcw:aboutSection ?sec ; lulcw:statedMechanism ?m .
    FILTER (?m = lulcw:RiverExchange)
    ?p lulcw:inSection ?sec ; lulcw:withinExtent ?z ; lulcw:pieceOfReach ?r .
    ?r lulcw:reachOf ?wc .
}
""" .

#################################################################
# CQ5, CQ8: river influences, gauge -> piezometer
#################################################################

lulcwr:RiverInfluenceShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/river-influence> ;
    sh:order 63 ;
    sh:rule lulcwr:riverInfluence .

# One influence per river-unit association and well attribution naming its unit, from the gauge of
# the rule's pool (arm C's gauges: analysis plan §14 item 16) on the association's watercourse
# that lies nearest to the zone's reach pieces of that watercourse (ties: the smaller code). The
# driver is the gauge's weekly discharge, standing in for the river stage near the well. Where
# river and aquifer are connected the exchange grows with the stage whatever its direction
# (Harbaugh 2005, doi:10.3133/tm6A16), so the sign is non-decreasing on outcrop and for a
# documented lateral exchange; it is eligible only where a source documents an exchange (a
# direction other than no exchange or not qualified) and none says the unit is independent; over
# cover the sign stays conditional and never eligible (the rivers meet the Quaternary, not the
# Pliocene below it: FRDG243). An association without a pool gauge gives no influence (CQ5: a
# documented pathway may have no usable gauge). Join order as in the CQ4 rules.
lulcwr:riverInfluence a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?inf a lulcw:Influence ;
        lulcw:driverEntity ?g ; lulcw:targetEntity ?w ;
        lulcw:driverVariable lulcw:RiverDischarge ; lulcw:proxyFor lulcw:RiverStage ;
        lulcw:mechanism lulcw:RiverExchange ;
        lulcw:responseSign ?sign ;
        lulcw:driverGroup lulcw:RiverDischargeGroup ;
        lulcw:withinExtent ?z ;
        lulcw:resolution lulcw:ExactUnitResolution ;
        lulcw:confidence ?conf ;
        lulcw:constraintEligibility ?elig ;
        lulcw:eligibilityReason ?why ;
        lulcw:conditions ?cond ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?aw , ?as , ?x ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {   # the nearest pool gauge of each association (distance zero-padded, then the code)
        SELECT ?as (MIN(?key) AS ?best) WHERE {
            $this lulcw:usesGaugePool ?pool .
            ?pool lulcw:poolMember ?g0 .
            ?g0 lulcw:onWatercourse ?wc0 ; lulcw:gaugeCode ?c0 .
            ?as lulcw:associationWatercourse ?wc0 ; lulcw:withinExtent ?z0 .
            ?x0 lulcw:relatedGauge ?g0 ; lulcw:withinExtent ?z0 ; lulcw:horizontalDistanceM ?d0 .
            BIND (CONCAT(STR(100000000 + xsd:integer(ROUND(?d0))), "|", ?c0) AS ?key)
        }
        GROUP BY ?as
    }
    BIND (STRAFTER(?best, "|") AS ?code)
    ?g lulcw:gaugeCode ?code ; lulcw:onWatercourse ?wc ; rdfs:label ?glabel .
    ?as lulcw:associationWatercourse ?wc ; lulcw:withinExtent ?z ; lulcw:associationType ?type ;
        lulcw:associationUnit ?u .
    ?z lulcw:zoneOf ?w ; lulcw:zoneRadiusM ?radius .
    ?aw lulcw:attributedEntity ?w ; lulcw:role ?role ; lulcw:candidateUnit ?u ; lulcw:confidence ?conf .
    FILTER (?role = lulcw:MonitoringRole)
    ?x lulcw:relatedGauge ?g ; lulcw:withinExtent ?z ; lulcw:horizontalDistanceM ?d ;
       lulcw:alongRiverPosition ?pos .
    ?g lulcw:hasDischargeSeries ?se .
    ?se lulcw:observedTrainingWeeks ?nobs ; lulcw:trainingWeeks ?ntrain .
    ?u lulcw:bdlisaCode ?ucode .
    ?wc lulcw:bdCarthageCode ?wcode .
    OPTIONAL { ?x lulcw:alongRiverDistanceM ?along }
    OPTIONAL { ?g lulcw:localInfluenceCode ?infl }
    OPTIONAL {
        SELECT ?as (COUNT(DISTINCT ?sc) AS ?nconn) WHERE {
            ?as lulcw:applicableStatement ?sc .
            ?sc lulcw:exchangeDirection ?dc .
            FILTER (?dc = lulcw:AquiferToSurface || ?dc = lulcw:SurfaceToAquifer || ?dc = lulcw:ExchangeEquilibrium)
        }
        GROUP BY ?as
    }
    OPTIONAL {
        SELECT ?as (COUNT(DISTINCT ?sn) AS ?nno) WHERE {
            ?as lulcw:applicableStatement ?sn .
            ?sn lulcw:exchangeDirection ?dn .
            FILTER (?dn = lulcw:NoExchange)
        }
        GROUP BY ?as
    }
    BIND (COALESCE(?nconn, 0) AS ?kc)
    BIND (COALESCE(?nno, 0) AS ?kn)
    BIND (?type = lulcw:OnOutcrop || ?type = lulcw:DocumentedLateral AS ?direct)
    BIND (IF(?direct, lulcw:PositiveResponse, lulcw:UnknownResponse) AS ?sign)
    BIND (IF(?direct && ?kc > 0 && ?kn = 0, lulcw:EligibleConstraint, lulcw:IneligibleConstraint) AS ?elig)
    BIND (IF(!?direct,
             "The river runs over the units that cover the well's unit, not on it: any exchange passes through the cover (vertical leakage), so the sign of the head response to the river stage stays conditional and never constrains a model (the rivers meet the Quaternary aquifers overlying the Pliocene: FRDG243, page 3).",
             IF(?kn > 0,
                "A source states that this unit is independent of the river in a section of the zone: no sign is used.",
                IF(?kc > 0,
                   "A source documents an exchange between this unit and a section of the zone. Where river and aquifer are connected, the exchange flux grows with the river stage whatever its direction (the MODFLOW river package, Harbaugh 2005, doi:10.3133/tm6A16), so a higher stage does not lower the head. The documented direction is a state kept with its period, not the sign. The gauge's discharge stands for the stage near the well only up to the withdrawals and inflows in between; the use of this sign as a constraint is settled at Gate 3 (analysis plan, section 14 item 16).",
                   "No source documents an exchange between this unit and the sections of the zone: the association is geometric only, so no sign is used.")))
          AS ?why)
    BIND (IF(?type = lulcw:OnOutcrop, "runs on the outcrop of",
             IF(?type = lulcw:OverCover, "runs over the units covering", "is documented to exchange laterally with")) AS ?rel)
    BIND (IF(?pos = lulcw:UpstreamOfZone, CONCAT("upstream of the zone's reaches (", STR(xsd:integer(ROUND(?along))), " m along the river)"),
             IF(?pos = lulcw:DownstreamOfZone, CONCAT("downstream of the zone's reaches (", STR(xsd:integer(ROUND(?along))), " m along the river)"),
                IF(?pos = lulcw:AlongZoneStretch, "along the zone's stretch of the river", "off the main stem"))) AS ?where)
    BIND (CONCAT("Weekly discharge of gauge ", ?code, " (", STR(?glabel), ") on watercourse ", ?wcode,
                 ", which ", ?rel, " unit ", ?ucode, " within ", STR(xsd:integer(ROUND(?radius))), " m of the well. ",
                 "The gauge lies ", STR(xsd:integer(ROUND(?d))), " m from the zone's reaches, ", ?where,
                 "; its record covers ", STR(?nobs), " of the ", STR(?ntrain), " training weeks",
                 IF(BOUND(?infl), CONCAT("; local influence code ", STR(?infl), " (Hub'Eau)"), ""), ". ",
                 "The sign refers to an increase of the gauge's discharge with the other drivers held fixed.")
          AS ?cond)
    BIND (REPLACE(STR(?as), "^.*/", "") AS ?kind)
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/influence/river/", ?kind, "/", ?code, "/to/",
                     STRAFTER(STR(?aw), "/attribution/piezometer/"))) AS ?inf)
}
""" .

#################################################################
# CQ6, CQ8: canal-unit associations and canal influences
#################################################################

lulcwr:CanalInfluenceShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/canal-influence> ;
    sh:order 64 ;
    sh:rule lulcwr:canalOnOutcrop , lulcwr:canalApplicableStatement , lulcwr:canalInfluence .

# For each reach search zone and unit that a monitoring attribution of the zone's well names: the
# length of canal reach pieces on polygons where the unit is at outcrop. No command-area map exists
# for the plain (CQ6): a canal crossing an outcrop is a candidate seepage and return-flow pathway,
# not a mapped service area.
lulcwr:canalOnOutcrop a sh:SPARQLRule ;
    sh:order 1 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?ca a lulcw:CanalUnitAssociation ; lulcw:withinExtent ?z ; lulcw:associationUnit ?u ;
        lulcw:lengthOnOutcropM ?len ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {
        SELECT ?z ?u (SUM(?l) AS ?len) WHERE {
            {
                SELECT DISTINCT ?z ?u ?p ?l WHERE {
                    ?p lulcw:pieceOfReach ?r ; lulcw:withinExtent ?z ; lulcw:piecePolygon ?poly ;
                       lulcw:pieceLengthM ?l .
                    ?r lulcw:reachNature ?nat .
                    FILTER (?nat = "Canal")
                    ?z lulcw:zoneOf ?w .
                    ?aw lulcw:attributedEntity ?w ; lulcw:role ?role ; lulcw:candidateUnit ?u .
                    FILTER (?role = lulcw:MonitoringRole)
                    ?poly lulcw:hasStackLayer ?ly .
                    ?ly lulcw:layerUnit ?u ; lulcw:layerOrder ?o .
                    FILTER (?o = 1)
                }
            }
        }
        GROUP BY ?z ?u
    }
    BIND (IRI(CONCAT(STR(?z), "/canal/", STRAFTER(STR(?u), "/unit/"))) AS ?ca)
}
""" .

# Canal-return statements apply to the associations of the unit they name (they delimit no
# stretch: the unit locates them).
lulcwr:canalApplicableStatement a sh:SPARQLRule ;
    sh:order 2 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
CONSTRUCT { ?ca lulcw:applicableStatement ?s . }
WHERE {
    ?ca lulcw:derivationRule $this ; lulcw:associationUnit ?u .
    ?s lulcw:aboutUnit ?u ; lulcw:statedMechanism ?m .
    FILTER (?m = lulcw:CanalReturnFlow)
}
""" .

# One influence per canal-unit association and well attribution, from the plain's canal intake
# group (the canal input of the models, as in arm C), where a source documents canal return flow
# into the unit (a statement from surface water to the aquifer); none where nothing does (decided
# by Assil on 2026-11-06, analysis plan §14 item 16). Sign: canal return raises the alluvium head;
# eligible only with a stated (not hedged) return statement and no statement that the unit is not
# influenced by the canals; its use as a constraint is settled at Gate 3.
lulcwr:canalInfluence a sh:SPARQLRule ;
    sh:order 3 ;
    sh:prefixes <https://w3id.org/lulcw/rules> ;
    sh:construct """
BASE <https://w3id.org/lulcw/data/>
CONSTRUCT {
    ?inf a lulcw:Influence ;
        lulcw:driverEntity ?grp ; lulcw:targetEntity ?w ;
        lulcw:driverVariable lulcw:CanalDiversionVolume ;
        lulcw:mechanism lulcw:CanalReturnFlow ;
        lulcw:responseSign lulcw:PositiveResponse ;
        lulcw:driverGroup lulcw:SummerDemand ;
        lulcw:withinExtent ?z ;
        lulcw:resolution lulcw:ExactUnitResolution ;
        lulcw:confidence ?conf ;
        lulcw:constraintEligibility ?elig ;
        lulcw:eligibilityReason ?why ;
        lulcw:conditions ?cond ;
        lulcw:evidenceKind lulcw:DerivedAssertion ;
        lulcw:derivationRule $this ;
        prov:wasDerivedFrom ?aw , ?ca ;
        prov:wasGeneratedBy <execution/kg-rules> .
}
WHERE {
    {
        SELECT ?ca (COUNT(DISTINCT ?sr) AS ?nret) (COUNT(DISTINCT ?ss) AS ?nstated) WHERE {
            ?ca lulcw:derivationRule $this ; lulcw:applicableStatement ?sr .
            ?sr lulcw:exchangeDirection ?dr .
            FILTER (?dr = lulcw:SurfaceToAquifer)
            OPTIONAL { ?sr lulcw:hedging ?h . FILTER (?h = lulcw:StatedFinding) BIND (?sr AS ?ss) }
        }
        GROUP BY ?ca
    }
    ?ca lulcw:withinExtent ?z ; lulcw:associationUnit ?u ; lulcw:lengthOnOutcropM ?len .
    ?z lulcw:zoneOf ?w ; lulcw:zoneRadiusM ?radius .
    ?aw lulcw:attributedEntity ?w ; lulcw:role ?role ; lulcw:candidateUnit ?u ; lulcw:confidence ?conf .
    FILTER (?role = lulcw:MonitoringRole)
    ?grp lulcw:intakeMember ?i0 .
    ?u lulcw:bdlisaCode ?ucode .
    OPTIONAL {
        SELECT ?ca (COUNT(DISTINCT ?sn) AS ?nno) WHERE {
            ?ca lulcw:applicableStatement ?sn .
            ?sn lulcw:exchangeDirection ?dn .
            FILTER (?dn = lulcw:NoExchange)
        }
        GROUP BY ?ca
    }
    BIND (COALESCE(?nno, 0) AS ?kn)
    BIND (IF(?nstated > 0 && ?kn = 0, lulcw:EligibleConstraint, lulcw:IneligibleConstraint) AS ?elig)
    BIND (IF(?kn > 0,
             "The sources disagree: one documents canal return flow into this unit, another finds the unit not influenced by canal water; no sign is used.",
             IF(?nstated > 0,
                "A source states canal return flow into this unit (canal seepage and irrigation returns), so more canal water does not lower its head. A diverted volume is not a recharge volume, and no command-area map says which parcels a canal serves (CQ6); the use of this sign as a constraint is settled at Gate 3 (analysis plan, section 14 item 16).",
                "The canal return flow into this unit is only reported or hedged by the sources: no sign is used."))
          AS ?why)
    BIND (CONCAT("Weekly canal diversion volume of the plain's surface-water intakes (the canal input of the models); canal reaches run ",
                 STR(xsd:integer(ROUND(?len))), " m on the outcrop of unit ", ?ucode, " within ",
                 STR(xsd:integer(ROUND(?radius))), " m of the well, and ", STR(?nret),
                 " source statement(s) document canal return flow into the unit. No command area is mapped: which parcels the canals serve, and how much of the diverted water reaches the unit, are unknown. ",
                 "The sign refers to an increase of the diverted volume with the other drivers held fixed.")
          AS ?cond)
    BIND (IRI(CONCAT("https://w3id.org/lulcw/data/influence/canal/plain/to/",
                     STRAFTER(STR(?aw), "/attribution/piezometer/"))) AS ?inf)
}
""" .

#################################################################
# The rules as data: descriptions and parameters (copied into the graph by the runner, which
# adds lulcw:ruleVersion and the execution record)
#################################################################

<https://w3id.org/lulcw/data/rule/stratigraphic-relation> a lulcw:DerivationRule ;
    rdfs:label "stratigraphic relation"@en ;
    rdfs:seeAlso lulcwr:stratigraphicRelation ;
    rdfs:comment "For every BD LISA elementary polygon, each pair of units of its stack, the upper above the lower: a direct contact when no layer lies between them, else an indirect ordering with its intervening units. The polygon is the witness; orderings are never chained across polygons (CQ3)."@en .

<https://w3id.org/lulcw/data/rule/overlies> a lulcw:DerivationRule ;
    rdfs:label "overlies"@en ;
    rdfs:seeAlso lulcwr:overlies ;
    rdfs:comment "Shortcut lulcw:overlies between two units in direct contact in at least one witnessing polygon; not transitive, not a hydraulic relation."@en .

<https://w3id.org/lulcw/data/rule/policy-selection> a lulcw:DerivationRule ;
    rdfs:label "policy selection"@en ;
    rdfs:seeAlso lulcwr:selectAttributions , lulcwr:monitors , lulcwr:pumpsFrom ;
    rdfs:comment "Each export policy selects the unit attributions whose confidence it admits (lulcw:admitsConfidence), at the resolution they were assessed; lulcw:monitors and lulcw:pumpsFrom are the main policy's view of its exact-unit selections."@en .

<https://w3id.org/lulcw/data/rule/well-link> a lulcw:DerivationRule ;
    rdfs:label "same-unit well link"@en ;
    rdfs:seeAlso lulcwr:wellLink ;
    lulcw:searchRadiusM "5000.0"^^xsd:double ;
    rdfs:comment "Two piezometers attributed to the same exact unit within the search radius (5000 m, inclusive: the reference query of CQ11), stored once per unordered pair with their horizontal distance and, when both are known, their investigation-depth difference. A modelling descriptor, not evidence of a shared screened horizon or of hydraulic connection; a depth threshold is applied at export."@en .

<https://w3id.org/lulcw/data/rule/pumping-influence> a lulcw:DerivationRule ;
    rdfs:label "pumping influence"@en ;
    rdfs:seeAlso lulcwr:pumpingInfluenceExact , lulcwr:pumpingInfluenceGroup ;
    lulcw:searchRadiusM "5000.0"^^xsd:double ;
    rdfs:comment "A candidate pumping-drawdown influence of an abstraction facility on a piezometer, one per evidence path: the facility's attribution meets the well's at the exact unit the well monitors (non-increasing sign, eligible) or at a unit group containing it (sign unknown, not eligible), within the search radius (5000 m, inclusive; the baselines' pumping features use 3 km, and the export may apply a threshold frozen on the training period). Distance is a selection assumption, not hydraulic evidence (CQ8)."@en .

<https://w3id.org/lulcw/data/rule/path-selection> a lulcw:DerivationRule ;
    rdfs:label "path selection"@en ;
    rdfs:seeAlso lulcwr:selectPaths ;
    rdfs:comment "A well link or an influence is selected by an export policy only if every unit attribution it derives from is selected by that policy: a segment the policy does not accept blocks the path."@en .

<https://w3id.org/lulcw/data/rule/crop-class> a lulcw:DerivationRule ;
    rdfs:label "crop class of an RPG crop code"@en ;
    rdfs:seeAlso lulcwr:cropClassOfCode ;
    rdfs:comment "The class-mapping rule of configs/lu_crop_classes.csv: a code listed as an override of a class takes that class; otherwise the class that takes its RPG crop group; otherwise none, and its area is counted as unmapped (CQ7)."@en .

<https://w3id.org/lulcw/data/rule/crop-class-area> a lulcw:DerivationRule ;
    rdfs:label "crop class area"@en ;
    rdfs:seeAlso lulcwr:cropClassArea , lulcwr:cropClassAreaEvidence ;
    rdfs:comment "Clipped area of each crop class in each crop demand zone and RPG edition: the sum of the clipped areas of its codes, each edition for its own year; unmapped codes stay in the totals as the class 'unmapped' (CQ7)."@en .

<https://w3id.org/lulcw/data/rule/outcrop-coverage> a lulcw:DerivationRule ;
    rdfs:label "outcrop coverage and cell weights"@en ;
    rdfs:seeAlso lulcwr:outcropCoverage , lulcwr:outcropCoverageEvidence , lulcwr:cellWeight ;
    rdfs:comment "For each reference extent (an outcrop search zone or the forcing extent) and each unit mapped at outcrop (order 1 of an elementary polygon's stack) there: the outcrop area, the part inside weather cells, the covered fraction, and per cell the share of the covered area (weights renormalised over the covered area, summing to one). Built from the polygon-cell intersection areas, which it cites. A unit without outcrop in the extent gets no coverage. Outcrop is a mapped property, not proof of recharge (CQ4)."@en .

<https://w3id.org/lulcw/data/rule/recharge-influence> a lulcw:DerivationRule ;
    rdfs:label "recharge-proxy influence"@en ;
    rdfs:seeAlso lulcwr:rechargeInfluenceLocal , lulcwr:rechargeInfluenceUnitWide ;
    lulcw:appliesInExtent <https://w3id.org/lulcw/data/extent/forcing-cells> ;
    rdfs:comment "A candidate diffuse-recharge influence of a weather cell on a piezometer, one per cell and well attribution: the cell holds part of the outcrop of the exact unit the well is attributed to, inside the well's 5 km outcrop search zone (the main runs) or inside the forcing extent (the unit-wide sensitivity, lulcw:appliesInExtent), with the cell's share of that outcrop. Driver: the cell's weekly effective rainfall, a proxy of groundwater recharge (soil drainage replaces it only in a sensitivity, never added to it); sign non-decreasing, eligible, the use of the sign settled at Gate 3. Each influence names the pathways it omits (lateral inflow, vertical leakage, river exchange, canal return flow): for the Pliocene these are the main ones (analysis plan section 14 item 15). A unit without outcrop in the extent gives no influence, which is not zero recharge (CQ4, CQ8)."@en .

<https://w3id.org/lulcw/data/rule/high-irrigation-demand> a lulcw:DerivationRule ;
    rdfs:label "high irrigation demand"@en ;
    rdfs:seeAlso lulcwr:assessDemand ;
    rdfs:comment "Dated category of each zone and calendar year: high irrigation demand when the main potential demand estimate reaches the threshold, below otherwise. The threshold (lulcw:demandThresholdM3) is the upper tercile of the main estimates of the training years 2015-2019, computed by src/kg/apply_rules.py from the graph: it never uses a test-period value. A potential requirement, not observed irrigation."@en .

<https://w3id.org/lulcw/data/rule/river-association> a lulcw:DerivationRule ;
    rdfs:label "river-unit association"@en ;
    rdfs:seeAlso lulcwr:riverOnOutcrop , lulcwr:riverOverCover , lulcwr:riverCoverUnits ,
        lulcwr:riverDocumentedLateral , lulcwr:riverApplicableStatement ;
    rdfs:comment "For each reach search zone, watercourse and unit a monitoring attribution of the zone's well names: whether the watercourse's reach pieces in the zone run on the unit's outcrop (order 1), over the units covering it (listed), or, with neither, meet a section where a source documents an exchange with the unit (documented lateral); with the lengths and the exchange statements that apply (about the unit and a section holding a piece of the zone). A geometric or documentary association, not a hydraulic connection (CQ5)."@en .

<https://w3id.org/lulcw/data/rule/river-influence> a lulcw:DerivationRule ;
    rdfs:label "river influence"@en ;
    rdfs:seeAlso lulcwr:riverInfluence ;
    lulcw:usesGaugePool <https://w3id.org/lulcw/data/gauge-pool/arm-c> ;
    rdfs:comment "A candidate river-exchange influence of a gauge on a piezometer, one per river-unit association and well attribution, from the gauge of the pool (arm C's five full-record gauges, analysis plan section 14 item 16) on the association's watercourse nearest to the zone's reach pieces. Driver: the gauge's weekly discharge, a proxy of the river stage near the well. Sign non-decreasing on outcrop and for a documented lateral exchange, eligible only where a source documents an exchange and none states independence; conditional and never eligible over cover. An association without a pool gauge gives no influence (CQ5, CQ8)."@en .

<https://w3id.org/lulcw/data/rule/canal-influence> a lulcw:DerivationRule ;
    rdfs:label "canal-unit association and canal influence"@en ;
    rdfs:seeAlso lulcwr:canalOnOutcrop , lulcwr:canalApplicableStatement , lulcwr:canalInfluence ;
    rdfs:comment "For each reach search zone and unit a monitoring attribution of the zone's well names: the length of canal reaches on the unit's outcrop and the canal-return statements naming the unit; then, where a statement documents canal return flow into the unit, one influence of the plain's canal intake group (the canal input of the models) on the well per attribution, sign non-decreasing, eligible only with a stated return statement and no statement that the unit is not influenced by canal water. No command-area map exists (CQ6): a diverted volume is not a recharge volume (CQ6, CQ8)."@en .
