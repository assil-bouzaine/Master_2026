@prefix lulcw:   <https://w3id.org/lulcw#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix s4watr:  <https://saref.etsi.org/saref4watr/> .
@prefix s4agri:  <https://saref.etsi.org/saref4agri/> .

# Alignment of the lulcw module to SAREF4WATR v2.1.1 (ETSI TS 103 410-10, the SAREF extension for the
# water domain; ETSI's BSD-3-Clause licence), read at its versioned URL on 2026-11-26 (v5 plan R2.3).
# Subclass axioms only where every instance of the lulcw class fits the SAREF4WATR definition (the
# graph's instances were checked); a close match where a known instance does not, or where SAREF4WATR
# places the term in its supply-network asset hierarchy. The water uses and the discharge are concepts
# and properties (individuals): SKOS mapping relations between individuals. Each correspondence, the
# rejected ones included, is in ledger.csv with the two definitions compared. SAREF4AGRI v2.1.1 (added
# 2026-11-27): the registered parcel gets a close match, not a subclass, because SAREF4AGRI states that every
# parcel contains some crop (s4agri:Parcel subClassOf geo:sfContains some s4agri:Crop) and fallow or
# non-cropped registered parcels contain none.

<https://w3id.org/lulcw/alignments/saref> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/lulcw/alignments/saref/0.2.0> ;
    dcterms:title "Alignment of LULC-Water to SAREF4WATR"@en , "Alignement de LULC-Water sur SAREF4WATR"@fr ;
    dcterms:description "Subclass and SKOS mapping axioms linking lulcw monitoring stations, gauges, watercourses, intakes, canal reaches, aquifer types, water uses and river discharge to SAREF4WATR v2.1.1, and registered parcels to SAREF4AGRI v2.1.1."@en ;
    dcterms:created "2026-11-26"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:imports <https://w3id.org/lulcw> , <https://w3id.org/lulcw/imports/saref> .

lulcw:MonitoringStation rdfs:subClassOf s4watr:MonitoringInfrastructure .
lulcw:RiverGauge rdfs:subClassOf s4watr:GaugingStation .
lulcw:Watercourse rdfs:subClassOf s4watr:River .
lulcw:SurfaceWaterIntake skos:closeMatch s4watr:Intake .
lulcw:Intake skos:closeMatch s4watr:Intake .
lulcw:CanalReach skos:closeMatch s4watr:Channel .
lulcw:AlluvialAquifer skos:closeMatch s4watr:Aquifer .
lulcw:KarstAquifer skos:closeMatch s4watr:Aquifer .
lulcw:MultilayerAquiferSystem skos:closeMatch s4watr:Aquifer .
lulcw:WaterUse skos:closeMatch s4watr:WaterUse .
lulcw:DrinkingWaterUse skos:closeMatch s4watr:Domestic .
lulcw:IrrigationUse skos:broadMatch s4watr:Agriculture .
lulcw:IndustryUse skos:closeMatch s4watr:Industry .
lulcw:RiverDischarge skos:closeMatch s4watr:FlowRate .
lulcw:RegisteredParcel skos:closeMatch s4agri:Parcel .

dcterms:title a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
