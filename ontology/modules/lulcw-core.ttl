<https://w3id.org/lulcw/core> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/lulcw/core/0.12.0> ;
    owl:versionInfo "0.12.0" ;
    dcterms:title "LULC-Water core module"@en , "Module noyau LULC-Water"@fr ;
    dcterms:description "Country-agnostic core vocabulary of the LULC-Water ontology network: provenance (data releases, source records, derivation rules), qualified assertions, shared answer-contract and evidence schemes, and generic register-code and measurement properties."@en ,
        "Vocabulaire noyau indépendant des pays du réseau d'ontologies LULC-Water : provenance (versions de jeux de données, enregistrements sources, règles de dérivation), assertions qualifiées, schémas partagés du contrat de réponse et des preuves, et propriétés génériques de code de registre et de mesure."@fr ;
    dcterms:creator "Assil Bouzaine" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-11-26"^^xsd:date ;
    owl:imports <https://w3id.org/lulcw/imports/geo> , <https://w3id.org/lulcw/imports/prov> , <https://w3id.org/lulcw/imports/skos> .

