@prefix lulcw:   <https://w3id.org/lulcw#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix time:    <http://www.w3.org/2006/time#> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix vann:    <http://purl.org/vocab/vann/> .

# LULC-Water bridging module (task 12.4). It holds only what the reused vocabularies lack
# (docs/ontology_design.md); the alignment axioms to GWML2, HyFO and SWEET are in
# ontology/alignments/, and lulcw-meta.ttl puts the network together. Scope of version 0.1:
# the six MUST competency questions (CQ1, CQ2, CQ3, CQ8, CQ11, CQ12) and the common answer
# contract of docs/competency_questions.md §2. Units are part of the property names (M = metre,
# M2 = square metre, M3 = cubic metre) and are stated in each definition.

<https://w3id.org/lulcw> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/lulcw/0.7.0> ;
    owl:versionInfo "0.7.0" ;
    owl:priorVersion <https://w3id.org/lulcw/0.6.1> ;
    dcterms:title "LULC-Water bridging module"@en , "Module de liaison LULC-Water"@fr ;
    dcterms:description "Bridging module of the LULC-Water network of ontologies (SAVE Water, PRIMA): wells, abstraction facilities, hydrogeological units and the qualified, evidence-carrying assertions (unit attributions, stratigraphic relations, well links, influences, annual abstraction accounting) that structure, constrain and explain a groundwater-level model of the Roussillon multilayer aquifer."@en ,
        "Module de liaison du réseau d'ontologies LULC-Water (SAVE Water, PRIMA) : piézomètres, ouvrages de prélèvement, entités hydrogéologiques et assertions qualifiées, porteuses de preuves (attributions à une entité, relations stratigraphiques, liens entre piézomètres, influences, bilans annuels des prélèvements), qui structurent, contraignent et expliquent un modèle des niveaux piézométriques de l'aquifère multicouche du Roussillon."@fr ;
    dcterms:creator "Assil Bouzaine" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-24"^^xsd:date ;
    vann:preferredNamespacePrefix "lulcw" ;
    vann:preferredNamespaceUri "https://w3id.org/lulcw#" ;
    rdfs:comment "Namespace provisional until the w3id.org redirect is accepted (docs/ontology_design.md §6)."@en ,
        "0.1.1 (2026-10-24, task 12.5): water use EnergyUse (BNPE code ENE); GeoSPARQL hasMetricArea added to the reused terms for polygon areas."@en ,
        "0.2.0 (2026-10-25, task 12.6): admitsConfidence and searchRadiusM, so that export policies and spatial rules carry their parameters as data; constraint eligibility defined from the evidence of the pathway, applied only under a policy that selects every segment. The SHACL shapes and SHACL-AF rules are in ontology/shapes/ and ontology/rules/."@en ,
        "0.3.0 (2026-10-25, task 12.6, CQ7): land use and crops: RPG crop codes, crop classes with their FAO-56 parameters and irrigation assumptions, crop demand zones, clipped crop areas per RPG year, potential irrigation demand estimates and their dated categories."@en ,
        "0.4.0 (2026-10-26, CQ4): recharge-related forcing: SAFRAN weather cells, the mapped outcrop of units inside reference extents, polygon-cell intersection areas, outcrop coverage and cell weights; WellZone generalises the crop demand zone, so zoneOf and zoneRadiusM also serve the outcrop search zone; observable property SoilDrainage; the mapped outcrop area of each unit, so that a reference extent states how much of the unit it clips."@en ,
        "0.5.0 (2026-10-27, CQ4 and CQ8): recharge-proxy influences: the observable property GroundwaterRecharge, which no input of the graph measures; proxyFor, so that an influence states what its driver stands in for; omitsPathway, so that it names the pathways it does not represent; the mechanisms LateralInflow and VerticalLeakage; the driver group RechargeProxies; withinExtent also serves influences, and appliesInExtent names the fixed extents a rule derives in."@en,
        "0.6.0 (2026-11-06, CQ5 and CQ6): rivers, gauges and canals: watercourses, BD TOPO reaches (river and canal), reach search zones and the pieces of reaches over elementary polygons, river sections and WFD river water bodies, gauges with their discharge series, gauge pools and gauge-zone relations; documents, passages and exchange statements read from them (mechanism, direction, hedging, how the source names the unit); derived river-unit and canal-unit associations; surface-water intakes and the canal intake group; the observable property RiverStage."@en ,
        "0.6.1 (2026-11-06, CQ5, CQ6 and CQ8 rules): the driver group RiverDischargeGroup (river stage proxies) for the river influences; measuredAt, the site of the measurement behind an exchange statement; SurfaceWaterIntake is a geo:Feature, no longer an AbstractionFacility, whose instances are the groundwater facilities that carry unit attributions (CQ2); SummerDemand includes the canal diversion volumes."@en ,
        "0.7.0 (2026-11-06, Codex review of that day): an exchange statement is about a unit itself (aboutUnit) or about an aggregate of units (aggregateMemberUnit, aboutGroundwaterBody), so membership of a groundwater body never stands for evidence about each member; localizedStatement, the separate inference that localises an aggregate statement to the unit on whose outcrop the river or canal runs; evidenceMethod (differential gauging, geochemical tracing, water balance, synthesis), separate from hedging; overlapsSection, so that only statements about the same stretch can contradict each other; ConstraintDecision, the decision of an export policy about the signs of one mechanism (proxy review and approval, with their basis), separate from the evidence layer of constraintEligibility; Piezometer covers the few monitoring points that are springs (the GWML2 alignment 0.2.0 makes it a close match of GW_Well, no longer a subclass)."@en ;
    owl:imports <https://w3id.org/lulcw/imports/sosa> , <https://w3id.org/lulcw/imports/prov> ,
        <https://w3id.org/lulcw/imports/time> , <https://w3id.org/lulcw/imports/skos> ,
        <https://w3id.org/lulcw/imports/geo> .

dcterms:title a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:source a owl:AnnotationProperty .
vann:preferredNamespacePrefix a owl:AnnotationProperty .
vann:preferredNamespaceUri a owl:AnnotationProperty .

#################################################################
# Provenance: releases, records, rules and policies
#################################################################

lulcw:DataRelease a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "data release"@en , "version de jeu de données"@fr ;
    skos:definition "A versioned release or dated snapshot of a source dataset or of a derived table, e.g. BD LISA V3, the BNPE extract retrieved on 2026-10-20, or model-ready dataset v4."@en .

lulcw:SourceRecord a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "source record"@en , "enregistrement source"@fr ;
    skos:definition "One record of a data release (a table row, a mapped feature or a document entry), identified by its original identifier; the evidence an assertion cites."@en .

lulcw:DerivationRule a owl:Class ;
    rdfs:subClassOf prov:Plan ;
    rdfs:label "derivation rule"@en , "règle de dérivation"@fr ;
    skos:definition "A named, versioned procedure that derives assertions from source records, e.g. a pump-to-unit attribution rule or an influence-proposal rule."@en .

lulcw:RuleExecution a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "rule execution"@en , "exécution de règle"@fr ;
    skos:definition "One execution of a derivation rule on given data releases, with its code version and date."@en .

lulcw:RuleEvaluation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "rule evaluation"@en , "évaluation de règle"@fr ;
    skos:definition "A measurement of how often a derivation rule agrees with reference records, at a stated resolution (exact unit or unit group) and for a stated water use. A rule's measured precision is not the probability that one of its assertions is true."@en .

lulcw:ExportPolicy a owl:Class ;
    rdfs:subClassOf prov:Plan ;
    rdfs:label "export policy"@en , "politique d'export"@fr ;
    skos:definition "A named, versioned selection policy deciding which qualified assertions become model inputs or graph edges, e.g. confident and probable pump-to-unit links for the main runs. Changing the policy changes the selection, never the stored evidence."@en .

lulcw:ConstraintDecision a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "constraint decision"@en , "décision de contrainte"@fr ;
    skos:definition "The decision of an export policy about the response signs of one mechanism: whether its driver was reviewed as an adequate stand-in for what the mechanism responds to (proxy review), and whether the eligible signs of the mechanism constrain the model (approval), each with its basis. A sign constrains a model only when its influence is selected by the policy, eligible by its pathway evidence (lulcw:constraintEligibility), and the decision for its mechanism accepts both the proxy and the constraint; a candidate (pending) decision constrains nothing."@en .

#################################################################
# Wells, stations and series
#################################################################

lulcw:Piezometer a owl:Class ;
    rdfs:label "piezometer"@en , "piézomètre"@fr ;
    skos:definition "A groundwater-level monitoring point identified by its BSS code: the physical point, usually a borehole, in a few cases a spring (e.g. Fontestramar), distinct from the monitoring station it hosts and from the observations made there."@en .

lulcw:MonitoringStation a owl:Class ;
    rdfs:label "groundwater-level monitoring station"@en , "station de mesure piézométrique"@fr ;
    skos:definition "A station of the groundwater-level monitoring network (ADES, served by Hub'Eau), hosted by a piezometer, whose head observations form a series."@en .

lulcw:ObservationSeries a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "observation series"@en , "série d'observations"@fr ;
    skos:definition "A reference to a time series kept outside the graph (for example weekly heads in a parquet table), with its variable, unit, vertical datum, temporal coverage and quality policy."@en .

#################################################################
# Hydrogeological structure
#################################################################

lulcw:HydrogeologicalUnit a owl:Class ;
    rdfs:label "hydrogeological unit"@en , "entité hydrogéologique"@fr ;
    skos:definition "A hydrogeological entity of the BD LISA reference (level 3): an aquifer, an aquifer system or a unit of low permeability. Its subtype comes from the written typing rule of docs/ontology_design.md §4.4, never from the BD LISA nature code alone."@en .

lulcw:AlluvialAquifer a owl:Class ;
    rdfs:subClassOf lulcw:HydrogeologicalUnit ;
    rdfs:label "alluvial aquifer"@en , "aquifère alluvial"@fr ;
    skos:definition "A hydrogeological unit of recent or ancient alluvium (in the plain: 718BP0x, 718BG49, 671AB0x). The type says nothing about local confinement, which is assessed separately (CQ14)."@en .

lulcw:MultilayerAquiferSystem a owl:Class ;
    rdfs:subClassOf lulcw:HydrogeologicalUnit ;
    rdfs:label "multilayer aquifer system"@en , "système aquifère multicouche"@fr ;
    skos:definition "A hydrogeological unit made of several permeable horizons separated, at least locally, by poorly permeable beds; in the plain, the Pliocene sands and clays (671AA00), labelled semi-permeable at BD LISA level 3."@en .

lulcw:KarstAquifer a owl:Class ;
    rdfs:subClassOf lulcw:HydrogeologicalUnit ;
    rdfs:label "karst aquifer"@en , "aquifère karstique"@fr ;
    skos:definition "A hydrogeological unit whose BD LISA medium is karstic (in the study area: 681AM00, 681AN02, 699AB01)."@en .

lulcw:ConfiningUnit a owl:Class ;
    rdfs:subClassOf lulcw:HydrogeologicalUnit ;
    rdfs:label "confining unit"@en , "unité imperméable"@fr ;
    skos:definition "A hydrogeological unit mapped as impermeable in BD LISA (nature 7), which can act as a confining bed between aquifers. The type describes the mapped unit; it does not show that an adjacent aquifer is locally confined."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( lulcw:AlluvialAquifer lulcw:MultilayerAquiferSystem lulcw:KarstAquifer lulcw:ConfiningUnit ) .

lulcw:HydrogeologicalUnitGroup a owl:Class ;
    rdfs:label "hydrogeological unit group"@en , "groupe d'entités hydrogéologiques"@fr ;
    skos:definition "A named group of hydrogeological units (e.g. the recent alluvium of the Têt, Agly, Réart and Tech), used for reporting and when the evidence for an attribution resolves only to the group."@en .

lulcw:GroundwaterBody a owl:Class ;
    rdfs:label "groundwater body"@en , "masse d'eau souterraine"@fr ;
    skos:definition "A groundwater body of the Water Framework Directive: a management unit, distinct from a hydrogeological unit; a well may belong to several."@en .

lulcw:ElementaryPolygon a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "BD LISA elementary polygon"@en , "polygone élémentaire BD LISA"@fr ;
    skos:definition "An elementary polygon of BD LISA: an area over which the vertical stack of hydrogeological units is constant. It is the spatial witness of stack and contact statements."@en .

lulcw:StackLayer a owl:Class ;
    rdfs:label "stack layer"@en , "niveau de la pile"@fr ;
    skos:definition "The occurrence of one hydrogeological unit at a given relative order in the stack of one elementary polygon (order 1 = the unit mapped at the surface)."@en .

lulcw:StratigraphicRelation a owl:Class ;
    rdfs:label "stratigraphic relation"@en , "relation stratigraphique"@fr ;
    skos:definition "A spatially qualified statement that one hydrogeological unit lies above another, directly or with intervening units, within the elementary polygons that witness it. It describes geological arrangement, not hydraulic connection, flow direction or a head inequality; an ordering is never chained across polygons that do not share a stack."@en .

#################################################################
# Abstraction
#################################################################

lulcw:AbstractionFacility a owl:Class ;
    rdfs:label "abstraction facility"@en , "ouvrage de prélèvement"@fr ;
    skos:definition "A water abstraction facility as reported to the national withdrawal database (a BNPE ouvrage, identified by its BNPE code). It may group several intakes or boreholes; its declared volume is never duplicated across them."@en .

lulcw:Intake a owl:Class ;
    rdfs:label "intake"@en , "point de prélèvement"@fr ;
    skos:definition "An individual withdrawal point (borehole, well, spring or surface intake) of an abstraction facility, when the source distinguishes it."@en .

lulcw:AnnualAbstractionRecord a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "annual abstraction record"@en , "chronique annuelle de prélèvement"@fr ;
    skos:definition "A volume of water withdrawn by one facility in one calendar year for one use, as declared (or, separately, as imputed or reconstructed), kept as an observation with its source record and quality."@en .

lulcw:VolumeAllocation a owl:Class ;
    rdfs:label "volume allocation"@en , "répartition de volume"@fr ;
    skos:definition "An explicit allocation of a share of one annual abstraction record to a hydrogeological unit or group under a named policy. The weights of one record sum to at most 1; the remainder stays unresolved."@en .

lulcw:AccountingResult a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "abstraction accounting result"@en , "bilan des prélèvements"@fr ;
    skos:definition "The result, computed outside OWL, of an annual accounting of declared groundwater abstraction for a unit or group, a year, a use and a reporting extent under a named policy: eligible declared total = allocated + unresolved + explicitly excluded volume."@en .

#################################################################
# Qualified assertions
#################################################################

lulcw:UnitAttribution a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "unit attribution"@en , "attribution à une entité hydrogéologique"@fr ;
    skos:definition "A candidate assignment of a piezometer (monitoring role) or an abstraction facility (abstraction role) to a hydrogeological unit or unit group, with its evidence, rule, rank, confidence, resolution and assessment status. An explicit unknown assignment has a reason and no target; alternatives are competing assignments, not fractions of water."@en .

lulcw:WellLink a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "well link"@en , "lien entre piézomètres"@fr ;
    skos:definition "A qualified, unordered pair of piezometers that share a candidate hydrogeological unit, with their horizontal distance and, when both are known, their investigation-depth difference. A modelling descriptor: it does not show the same screened horizon or a direct hydraulic connection."@en .

lulcw:Influence a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "influence"@en , "influence"@fr ;
    skos:definition "A qualified driver-to-head pathway: a mechanism by which a named driver variable can change the head at a target, with its conditions, evidence path, response sign (possibly unknown) and constraint eligibility. A response sign refers to an increase of the driver with the stated conditions held fixed; it is not a measured causal effect."@en .

#################################################################
# Concept schemes (each value is a skos:Concept and an instance of the class of its scheme)
#################################################################

lulcw:AnswerStatus a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "answer status"@en , "statut de réponse"@fr ;
    skos:definition "Status of an answer to a competency question: supported by the cited evidence, partial, unknown, conflicting or not applicable. Supported does not mean established physical truth."@en .
lulcw:AnswerStatusScheme a skos:ConceptScheme ;
    rdfs:label "answer statuses"@en , "statuts de réponse"@fr ;
    skos:definition "Values of lulcw:AnswerStatus (docs/competency_questions.md §2)."@en .
lulcw:Supported a lulcw:AnswerStatus ; skos:inScheme lulcw:AnswerStatusScheme ; skos:topConceptOf lulcw:AnswerStatusScheme ;
    skos:prefLabel "supported"@en , "étayée"@fr ;
    rdfs:label "supported"@en , "étayée"@fr ;
    skos:definition "The answer is supported by the cited evidence within the declared scope."@en .
lulcw:Partial a lulcw:AnswerStatus ; skos:inScheme lulcw:AnswerStatusScheme ; skos:topConceptOf lulcw:AnswerStatusScheme ;
    skos:prefLabel "partial"@en , "partielle"@fr ;
    rdfs:label "partial"@en , "partielle"@fr ;
    skos:definition "Part of the requested scope is answered; the rest is reported as missing."@en .
lulcw:UnknownAnswer a lulcw:AnswerStatus ; skos:inScheme lulcw:AnswerStatusScheme ; skos:topConceptOf lulcw:AnswerStatusScheme ;
    skos:prefLabel "unknown"@en , "inconnue"@fr ;
    rdfs:label "unknown"@en , "inconnue"@fr ;
    skos:definition "The evidence needed to answer is missing; never read as false or zero."@en .
lulcw:Conflicting a lulcw:AnswerStatus ; skos:inScheme lulcw:AnswerStatusScheme ; skos:topConceptOf lulcw:AnswerStatusScheme ;
    skos:prefLabel "conflicting"@en , "contradictoire"@fr ;
    rdfs:label "conflicting"@en , "contradictoire"@fr ;
    skos:definition "Cited sources disagree; every alternative is returned with its source."@en .
lulcw:NotApplicable a lulcw:AnswerStatus ; skos:inScheme lulcw:AnswerStatusScheme ; skos:topConceptOf lulcw:AnswerStatusScheme ;
    skos:prefLabel "not applicable"@en , "sans objet"@fr ;
    rdfs:label "not applicable"@en , "sans objet"@fr ;
    skos:definition "The question does not apply to the requested entity or period, with a stated reason."@en .

lulcw:EvidenceKind a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "evidence kind"@en , "nature de la preuve"@fr ;
    skos:definition "Kind of evidence behind an assertion: reported observation, derived assertion, literature or expert hypothesis, or model or scenario result."@en .
lulcw:EvidenceKindScheme a skos:ConceptScheme ;
    rdfs:label "evidence kinds"@en , "natures de preuve"@fr ;
    skos:definition "Values of lulcw:EvidenceKind."@en .
lulcw:ReportedObservation a lulcw:EvidenceKind ; skos:inScheme lulcw:EvidenceKindScheme ; skos:topConceptOf lulcw:EvidenceKindScheme ;
    skos:prefLabel "reported observation"@en , "observation déclarée"@fr ;
    rdfs:label "reported observation"@en , "observation déclarée"@fr ;
    skos:definition "A value or fact as recorded by its producer (e.g. a BSS record or a BNPE declaration)."@en .
lulcw:DerivedAssertion a lulcw:EvidenceKind ; skos:inScheme lulcw:EvidenceKindScheme ; skos:topConceptOf lulcw:EvidenceKindScheme ;
    skos:prefLabel "derived assertion"@en , "assertion dérivée"@fr ;
    rdfs:label "derived assertion"@en , "assertion dérivée"@fr ;
    skos:definition "An assertion produced by a documented rule from source records."@en .
lulcw:ExpertHypothesis a lulcw:EvidenceKind ; skos:inScheme lulcw:EvidenceKindScheme ; skos:topConceptOf lulcw:EvidenceKindScheme ;
    skos:prefLabel "literature or expert hypothesis"@en , "hypothèse de la littérature ou d'expert"@fr ;
    rdfs:label "literature or expert hypothesis"@en , "hypothèse de la littérature ou d'expert"@fr ;
    skos:definition "A mechanism or relation stated in the literature or by an expert, with its passage and scope; unreviewed extracted text cannot enable a hard constraint."@en .
lulcw:ModelResult a lulcw:EvidenceKind ; skos:inScheme lulcw:EvidenceKindScheme ; skos:topConceptOf lulcw:EvidenceKindScheme ;
    skos:prefLabel "model or scenario result"@en , "résultat de modèle ou de scénario"@fr ;
    rdfs:label "model or scenario result"@en , "résultat de modèle ou de scénario"@fr ;
    skos:definition "An output of a model run or a scenario, kept distinct from observed facts."@en .

lulcw:AssessmentStatus a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "assessment status"@en , "statut d'évaluation"@fr ;
    skos:definition "Status of a qualified assertion: candidate, accepted, rejected or superseded."@en .
lulcw:AssessmentStatusScheme a skos:ConceptScheme ;
    rdfs:label "assessment statuses"@en , "statuts d'évaluation"@fr ;
    skos:definition "Values of lulcw:AssessmentStatus."@en .
lulcw:CandidateStatus a lulcw:AssessmentStatus ; skos:inScheme lulcw:AssessmentStatusScheme ; skos:topConceptOf lulcw:AssessmentStatusScheme ;
    skos:prefLabel "candidate"@en , "candidate"@fr ;
    rdfs:label "candidate"@en , "candidate"@fr ;
    skos:definition "Proposed by a rule or a record, not yet accepted or rejected."@en .
lulcw:AcceptedStatus a lulcw:AssessmentStatus ; skos:inScheme lulcw:AssessmentStatusScheme ; skos:topConceptOf lulcw:AssessmentStatusScheme ;
    skos:prefLabel "accepted"@en , "acceptée"@fr ;
    rdfs:label "accepted"@en , "acceptée"@fr ;
    skos:definition "Accepted after a stated check; acceptance does not raise its confidence."@en .
lulcw:RejectedStatus a lulcw:AssessmentStatus ; skos:inScheme lulcw:AssessmentStatusScheme ; skos:topConceptOf lulcw:AssessmentStatusScheme ;
    skos:prefLabel "rejected"@en , "rejetée"@fr ;
    rdfs:label "rejected"@en , "rejetée"@fr ;
    skos:definition "Rejected after a stated check; kept with its evidence."@en .
lulcw:SupersededStatus a lulcw:AssessmentStatus ; skos:inScheme lulcw:AssessmentStatusScheme ; skos:topConceptOf lulcw:AssessmentStatusScheme ;
    skos:prefLabel "superseded"@en , "remplacée"@fr ;
    rdfs:label "superseded"@en , "remplacée"@fr ;
    skos:definition "Replaced by a later assertion from a newer release or rule version."@en .

lulcw:ConfidenceLevel a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "confidence level"@en , "niveau de confiance"@fr ;
    skos:definition "Evidence-policy level of an assertion (confident, probable, possible). It is not a calibrated probability and is separate from answer status and from selection by an export policy. Unknown is not a confidence level: an unknown assignment has none."@en .
lulcw:ConfidenceScheme a skos:ConceptScheme ;
    rdfs:label "confidence levels"@en , "niveaux de confiance"@fr ;
    skos:definition "Values of lulcw:ConfidenceLevel (src/kg/pump_attribution.py)."@en .
lulcw:Confident a lulcw:ConfidenceLevel ; skos:inScheme lulcw:ConfidenceScheme ; skos:topConceptOf lulcw:ConfidenceScheme ;
    skos:prefLabel "confident"@en , "sûr"@fr ;
    rdfs:label "confident"@en , "sûr"@fr ;
    skos:definition "Supported by a direct record of the entity (e.g. the BSS record of the borehole, depth-checked)."@en .
lulcw:Probable a lulcw:ConfidenceLevel ; skos:inScheme lulcw:ConfidenceScheme ; skos:topConceptOf lulcw:ConfidenceScheme ;
    skos:prefLabel "probable"@en , "probable"@fr ;
    rdfs:label "probable"@en , "probable"@fr ;
    skos:definition "Produced by a rule whose precision was measured (at least 0.80 on at least 10 recorded cases) at the stated resolution and for the same water use."@en .
lulcw:Possible a lulcw:ConfidenceLevel ; skos:inScheme lulcw:ConfidenceScheme ; skos:topConceptOf lulcw:ConfidenceScheme ;
    skos:prefLabel "possible"@en , "possible"@fr ;
    rdfs:label "possible"@en , "possible"@fr ;
    skos:definition "Produced by a rule not measured for this use or resolution, or below the probable threshold."@en .

lulcw:Resolution a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "assessment resolution"@en , "résolution de l'évaluation"@fr ;
    skos:definition "The level at which an attribution or a rule evaluation is resolved: the exact hydrogeological unit, or only a unit group."@en .
lulcw:ResolutionScheme a skos:ConceptScheme ;
    rdfs:label "assessment resolutions"@en , "résolutions d'évaluation"@fr ;
    skos:definition "Values of lulcw:Resolution."@en .
lulcw:ExactUnitResolution a lulcw:Resolution ; skos:inScheme lulcw:ResolutionScheme ; skos:topConceptOf lulcw:ResolutionScheme ;
    skos:prefLabel "exact unit"@en , "entité exacte"@fr ;
    rdfs:label "exact unit"@en , "entité exacte"@fr ;
    skos:definition "Resolved to one hydrogeological unit."@en .
lulcw:UnitGroupResolution a lulcw:Resolution ; skos:inScheme lulcw:ResolutionScheme ; skos:topConceptOf lulcw:ResolutionScheme ;
    skos:prefLabel "unit group"@en , "groupe d'entités"@fr ;
    rdfs:label "unit group"@en , "groupe d'entités"@fr ;
    skos:definition "Resolved only to a hydrogeological unit group; cannot pass an exact-unit filter."@en .

lulcw:AttributionRole a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "attribution role"@en , "rôle de l'attribution"@fr ;
    skos:definition "Why an entity is attributed to a unit: it monitors the unit, or it abstracts water from it."@en .
lulcw:AttributionRoleScheme a skos:ConceptScheme ;
    rdfs:label "attribution roles"@en , "rôles d'attribution"@fr ;
    skos:definition "Values of lulcw:AttributionRole."@en .
lulcw:MonitoringRole a lulcw:AttributionRole ; skos:inScheme lulcw:AttributionRoleScheme ; skos:topConceptOf lulcw:AttributionRoleScheme ;
    skos:prefLabel "monitoring"@en , "surveillance"@fr ;
    rdfs:label "monitoring"@en , "surveillance"@fr ;
    skos:definition "A piezometer monitors the unit."@en .
lulcw:AbstractionRole a lulcw:AttributionRole ; skos:inScheme lulcw:AttributionRoleScheme ; skos:topConceptOf lulcw:AttributionRoleScheme ;
    skos:prefLabel "abstraction"@en , "prélèvement"@fr ;
    rdfs:label "abstraction"@en , "prélèvement"@fr ;
    skos:definition "A facility abstracts water from the unit."@en .

lulcw:WaterUse a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "water use"@en , "usage de l'eau"@fr ;
    skos:definition "The declared use of an abstracted volume, as coded in the BNPE. A use belongs to a dated volume record, not permanently to a facility."@en .
lulcw:WaterUseScheme a skos:ConceptScheme ;
    rdfs:label "water uses"@en , "usages de l'eau"@fr ;
    skos:definition "Values of lulcw:WaterUse found in the BNPE records of the study area."@en .
lulcw:DrinkingWaterUse a lulcw:WaterUse ; skos:inScheme lulcw:WaterUseScheme ; skos:topConceptOf lulcw:WaterUseScheme ;
    skos:prefLabel "drinking water"@en , "eau potable"@fr ;
    rdfs:label "drinking water"@en , "eau potable"@fr ;
    skos:definition "Abstraction for public drinking-water supply."@en .
lulcw:IrrigationUse a lulcw:WaterUse ; skos:inScheme lulcw:WaterUseScheme ; skos:topConceptOf lulcw:WaterUseScheme ;
    skos:prefLabel "irrigation"@en , "irrigation"@fr ;
    rdfs:label "irrigation"@en , "irrigation"@fr ;
    skos:definition "Abstraction for agricultural irrigation."@en .
lulcw:IndustryUse a lulcw:WaterUse ; skos:inScheme lulcw:WaterUseScheme ; skos:topConceptOf lulcw:WaterUseScheme ;
    skos:prefLabel "industry"@en , "industrie"@fr ;
    rdfs:label "industry"@en , "industrie"@fr ;
    skos:definition "Abstraction for industrial and economic uses."@en .
lulcw:CanalSupplyUse a lulcw:WaterUse ; skos:inScheme lulcw:WaterUseScheme ; skos:topConceptOf lulcw:WaterUseScheme ;
    skos:prefLabel "canal supply"@en , "alimentation de canal"@fr ;
    rdfs:label "canal supply"@en , "alimentation de canal"@fr ;
    skos:definition "Abstraction declared to feed a canal; diverted water is not recharge."@en .
lulcw:EnergyUse a lulcw:WaterUse ; skos:inScheme lulcw:WaterUseScheme ; skos:topConceptOf lulcw:WaterUseScheme ;
    skos:prefLabel "energy"@en , "énergie"@fr ;
    rdfs:label "energy"@en , "énergie"@fr ;
    skos:definition "Abstraction declared for energy production other than turbined water (BNPE usage code ENE)."@en .

lulcw:WaterSource a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "water source"@en , "milieu de prélèvement"@fr ;
    skos:definition "Whether a volume is withdrawn from groundwater or from surface water (BNPE code_type_milieu)."@en .
lulcw:WaterSourceScheme a skos:ConceptScheme ;
    rdfs:label "water sources"@en , "milieux de prélèvement"@fr ;
    skos:definition "Values of lulcw:WaterSource."@en .
lulcw:GroundwaterSource a lulcw:WaterSource ; skos:inScheme lulcw:WaterSourceScheme ; skos:topConceptOf lulcw:WaterSourceScheme ;
    skos:prefLabel "groundwater"@en , "eau souterraine"@fr ;
    rdfs:label "groundwater"@en , "eau souterraine"@fr ;
    skos:definition "Withdrawn from groundwater (BNPE SOUT)."@en .
lulcw:SurfaceWaterSource a lulcw:WaterSource ; skos:inScheme lulcw:WaterSourceScheme ; skos:topConceptOf lulcw:WaterSourceScheme ;
    skos:prefLabel "surface water"@en , "eau de surface"@fr ;
    rdfs:label "surface water"@en , "eau de surface"@fr ;
    skos:definition "Withdrawn from surface water (BNPE CONT)."@en .

lulcw:RecordKind a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "record kind"@en , "nature de l'enregistrement"@fr ;
    skos:definition "Whether an abstraction volume is an original declaration, an imputed value or a reconstruction; the three are never mixed in one total."@en .
lulcw:RecordKindScheme a skos:ConceptScheme ;
    rdfs:label "record kinds"@en , "natures d'enregistrement"@fr ;
    skos:definition "Values of lulcw:RecordKind."@en .
lulcw:DeclaredRecord a lulcw:RecordKind ; skos:inScheme lulcw:RecordKindScheme ; skos:topConceptOf lulcw:RecordKindScheme ;
    skos:prefLabel "declared"@en , "déclaré"@fr ;
    rdfs:label "declared"@en , "déclaré"@fr ;
    skos:definition "An annual volume as declared in the BNPE."@en .
lulcw:ImputedRecord a lulcw:RecordKind ; skos:inScheme lulcw:RecordKindScheme ; skos:topConceptOf lulcw:RecordKindScheme ;
    skos:prefLabel "imputed"@en , "imputé"@fr ;
    rdfs:label "imputed"@en , "imputé"@fr ;
    skos:definition "An annual volume filled by a documented imputation rule for a missing declaration."@en .
lulcw:ReconstructedRecord a lulcw:RecordKind ; skos:inScheme lulcw:RecordKindScheme ; skos:topConceptOf lulcw:RecordKindScheme ;
    skos:prefLabel "reconstructed"@en , "reconstitué"@fr ;
    rdfs:label "reconstructed"@en , "reconstitué"@fr ;
    skos:definition "A volume obtained by spreading or harmonising declarations (e.g. weekly volumes); not an independent observation."@en .

lulcw:ResponseSign a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "response sign"@en , "signe de la réponse"@fr ;
    skos:definition "Direction of the head response to an increase of a driver variable, with the stated conditions held fixed; distinct from the sign of a model contribution relative to a baseline."@en .
lulcw:ResponseSignScheme a skos:ConceptScheme ;
    rdfs:label "response signs"@en , "signes de réponse"@fr ;
    skos:definition "Values of lulcw:ResponseSign."@en .
lulcw:NegativeResponse a lulcw:ResponseSign ; skos:inScheme lulcw:ResponseSignScheme ; skos:topConceptOf lulcw:ResponseSignScheme ;
    skos:prefLabel "non-increasing"@en , "non croissante"@fr ;
    rdfs:label "non-increasing"@en , "non croissante"@fr ;
    skos:definition "More of the driver does not raise the head (e.g. abstraction from a connected unit)."@en .
lulcw:PositiveResponse a lulcw:ResponseSign ; skos:inScheme lulcw:ResponseSignScheme ; skos:topConceptOf lulcw:ResponseSignScheme ;
    skos:prefLabel "non-decreasing"@en , "non décroissante"@fr ;
    rdfs:label "non-decreasing"@en , "non décroissante"@fr ;
    skos:definition "More of the driver does not lower the head (e.g. effective rainfall over an outcrop)."@en .
lulcw:UnknownResponse a lulcw:ResponseSign ; skos:inScheme lulcw:ResponseSignScheme ; skos:topConceptOf lulcw:ResponseSignScheme ;
    skos:prefLabel "unknown or conditional"@en , "inconnue ou conditionnelle"@fr ;
    rdfs:label "unknown or conditional"@en , "inconnue ou conditionnelle"@fr ;
    skos:definition "The direction is unknown or changes with conditions; never turned into a hard constraint."@en .

lulcw:Mechanism a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "mechanism"@en , "mécanisme"@fr ;
    skos:definition "A physical process by which a driver can change groundwater head, stated as a conditional specification, not as a universal law about every instance."@en .
lulcw:MechanismScheme a skos:ConceptScheme ;
    rdfs:label "mechanisms"@en , "mécanismes"@fr ;
    skos:definition "Values of lulcw:Mechanism: the four constraint families of the design (pumping drawdown, diffuse recharge, canal return flow, river exchange), and pathways named so that a proxy is never presented as the complete supply (lateral inflow, vertical leakage)."@en .
lulcw:PumpingDrawdown a lulcw:Mechanism ; skos:inScheme lulcw:MechanismScheme ; skos:topConceptOf lulcw:MechanismScheme ;
    skos:prefLabel "pumping drawdown"@en , "rabattement par pompage"@fr ;
    rdfs:label "pumping drawdown"@en , "rabattement par pompage"@fr ;
    skos:definition "Abstraction from a unit lowers the head of that unit near the abstraction, under the stated connection and distance conditions."@en .
lulcw:DiffuseRecharge a lulcw:Mechanism ; skos:inScheme lulcw:MechanismScheme ; skos:topConceptOf lulcw:MechanismScheme ;
    skos:prefLabel "diffuse recharge"@en , "recharge diffuse"@fr ;
    rdfs:label "diffuse recharge"@en , "recharge diffuse"@fr ;
    skos:definition "Effective rainfall infiltrating where a unit is mapped at outcrop can raise its head; outcrop alone does not prove infiltration."@en .
lulcw:CanalReturnFlow a lulcw:Mechanism ; skos:inScheme lulcw:MechanismScheme ; skos:topConceptOf lulcw:MechanismScheme ;
    skos:prefLabel "canal return flow"@en , "retour d'irrigation par les canaux"@fr ;
    rdfs:label "canal return flow"@en , "retour d'irrigation par les canaux"@fr ;
    skos:definition "Canal seepage and irrigation return flow can raise the head of an alluvial unit; a diverted volume is not a recharge volume."@en .
lulcw:RiverExchange a lulcw:Mechanism ; skos:inScheme lulcw:MechanismScheme ; skos:topConceptOf lulcw:MechanismScheme ;
    skos:prefLabel "river exchange"@en , "échange nappe-rivière"@fr ;
    rdfs:label "river exchange"@en , "échange nappe-rivière"@fr ;
    skos:definition "Exchange between a river reach and a unit; its direction depends on hydraulic conditions and needs documented evidence before any sign is used."@en .
lulcw:LateralInflow a lulcw:Mechanism ; skos:inScheme lulcw:MechanismScheme ; skos:topConceptOf lulcw:MechanismScheme ;
    skos:prefLabel "lateral inflow"@en , "apport latéral"@fr ;
    rdfs:label "lateral inflow"@en , "apport latéral"@fr ;
    skos:definition "Groundwater flowing into a unit from adjacent formations (e.g. the Corbières karst and the massifs bordering the Roussillon plain) or from parts of the unit beyond a reference extent. Named so that a local recharge proxy is never presented as the whole supply; not yet derived as an influence."@en .
lulcw:VerticalLeakage a lulcw:Mechanism ; skos:inScheme lulcw:MechanismScheme ; skos:topConceptOf lulcw:MechanismScheme ;
    skos:prefLabel "vertical leakage"@en , "drainance verticale"@fr ;
    rdfs:label "vertical leakage"@en , "drainance verticale"@fr ;
    skos:definition "Exchange of water between superposed units through a semi-permeable bed or a direct contact (CQ3), e.g. the downward leakage from the Quaternary into the Pliocene that follows Pliocene pumping (BRGM/RP-71486-FR); its direction follows the head difference. Named so that a local recharge proxy is never presented as the whole supply; not yet derived as an influence."@en .

lulcw:DriverGroup a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "driver group"@en , "groupe de forçages"@fr ;
    skos:definition "A group of drivers whose effects are reported together because the data cannot separate them."@en .
lulcw:DriverGroupScheme a skos:ConceptScheme ;
    rdfs:label "driver groups"@en , "groupes de forçages"@fr ;
    skos:definition "Values of lulcw:DriverGroup (docs/analysis_plan.md §8)."@en .
lulcw:SummerDemand a lulcw:DriverGroup ; skos:inScheme lulcw:DriverGroupScheme ; skos:topConceptOf lulcw:DriverGroupScheme ;
    skos:prefLabel "summer demand"@en , "demande estivale"@fr ;
    rdfs:label "summer demand"@en , "demande estivale"@fr ;
    skos:definition "Reconstructed seasonal pumping, the canal diversion volumes and the climatic deficit, which move together within a year (r = 0.92 to 0.97: irrigation and canal volumes are spread with the deficit) and are attributed jointly."@en .
lulcw:RiverDischargeGroup a lulcw:DriverGroup ; skos:inScheme lulcw:DriverGroupScheme ; skos:topConceptOf lulcw:DriverGroupScheme ;
    skos:prefLabel "river stage proxies"@en , "indicateurs du niveau des cours d'eau"@fr ;
    rdfs:label "river stage proxies"@en , "indicateurs du niveau des cours d'eau"@fr ;
    skos:definition "The river influences of one well, reported together. A gauge's discharge rises with the storms that drive effective rainfall and, on the regulated Têt and Agly, with the summer dam releases for irrigation, so its separate contribution is read with the recharge proxies and the summer-demand group (docs/analysis_plan.md §8)."@en .
lulcw:RechargeProxies a lulcw:DriverGroup ; skos:inScheme lulcw:DriverGroupScheme ; skos:topConceptOf lulcw:DriverGroupScheme ;
    skos:prefLabel "recharge proxies"@en , "indicateurs de recharge"@fr ;
    rdfs:label "recharge proxies"@en , "indicateurs de recharge"@fr ;
    skos:definition "The recharge-proxy influences of one well, one per weather cell over the outcrop of its unit, reported together: neighbouring cells carry nearly the same weekly signal, so their separate contributions are not identifiable. In the irrigation season the proxy also moves with the climatic deficit of the summer-demand group (docs/analysis_plan.md §8)."@en .

lulcw:ConstraintEligibility a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "constraint eligibility"@en , "éligibilité à la contrainte"@fr ;
    skos:definition "Whether an influence may fix the sign of a model response under a named policy."@en .
lulcw:ConstraintEligibilityScheme a skos:ConceptScheme ;
    rdfs:label "constraint eligibilities"@en , "éligibilités à la contrainte"@fr ;
    skos:definition "Values of lulcw:ConstraintEligibility."@en .
lulcw:EligibleConstraint a lulcw:ConstraintEligibility ; skos:inScheme lulcw:ConstraintEligibilityScheme ; skos:topConceptOf lulcw:ConstraintEligibilityScheme ;
    skos:prefLabel "eligible"@en , "éligible"@fr ;
    rdfs:label "eligible"@en , "éligible"@fr ;
    skos:definition "Every segment of the pathway is resolved at the resolution its mechanism requires (for pumping drawdown: the exact unit on both sides; for river exchange and canal return flow: a statement about the unit itself, not about an aggregate it belongs to), and the sign, variable and conditions are supported. The constraint is applied only under a policy that selects every segment and accepts its mechanism's constraint decision."@en .
lulcw:IneligibleConstraint a lulcw:ConstraintEligibility ; skos:inScheme lulcw:ConstraintEligibilityScheme ; skos:topConceptOf lulcw:ConstraintEligibilityScheme ;
    skos:prefLabel "not eligible"@en , "non éligible"@fr ;
    rdfs:label "not eligible"@en , "non éligible"@fr ;
    skos:definition "A segment is missing or resolved more coarsely than its mechanism requires, or the sign is unknown or conditional; the influence may still be an unsigned graph edge."@en .

lulcw:StratigraphicRelationKind a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "stratigraphic relation kind"@en , "type de relation stratigraphique"@fr ;
    skos:definition "Whether two units are in direct contact in a stack or ordered with intervening units."@en .
lulcw:StratigraphicRelationKindScheme a skos:ConceptScheme ;
    rdfs:label "stratigraphic relation kinds"@en , "types de relation stratigraphique"@fr ;
    skos:definition "Values of lulcw:StratigraphicRelationKind."@en .
lulcw:DirectContact a lulcw:StratigraphicRelationKind ; skos:inScheme lulcw:StratigraphicRelationKindScheme ; skos:topConceptOf lulcw:StratigraphicRelationKindScheme ;
    skos:prefLabel "direct contact"@en , "contact direct"@fr ;
    rdfs:label "direct contact"@en , "contact direct"@fr ;
    skos:definition "The two units are consecutive in the stack of the witnessing polygon; no intervening mapped unit (which does not exclude a bed below map resolution)."@en .
lulcw:IndirectOrdering a lulcw:StratigraphicRelationKind ; skos:inScheme lulcw:StratigraphicRelationKindScheme ; skos:topConceptOf lulcw:StratigraphicRelationKindScheme ;
    skos:prefLabel "indirect ordering"@en , "superposition indirecte"@fr ;
    rdfs:label "indirect ordering"@en , "superposition indirecte"@fr ;
    skos:definition "The upper unit lies above the lower one in the stack of the same witnessing polygon, with intervening units."@en .

#################################################################
# Observable properties (driver and target variables)
#################################################################

lulcw:GroundwaterHead a sosa:ObservableProperty ;
    rdfs:label "groundwater head"@en , "niveau piézométrique"@fr ;
    skos:definition "Elevation of the groundwater level at a well, in metres above the NGF-IGN69 datum (m NGF)."@en .
lulcw:DeclaredAnnualVolume a sosa:ObservableProperty ;
    rdfs:label "declared annual volume"@en , "volume annuel déclaré"@fr ;
    skos:definition "Volume of water withdrawn in a calendar year, as declared to the BNPE, in cubic metres."@en .
lulcw:ReconstructedWeeklyVolume a sosa:ObservableProperty ;
    rdfs:label "reconstructed weekly abstraction"@en , "prélèvement hebdomadaire reconstitué"@fr ;
    skos:definition "Weekly volume obtained by spreading annual declarations with documented profiles, in cubic metres per week; a model driver, not an observation."@en .
lulcw:EffectiveRainfall a sosa:ObservableProperty ;
    rdfs:label "effective rainfall"@en , "pluie efficace"@fr ;
    skos:definition "SIM2 (SAFRAN-ISBA) daily effective rainfall (variable PE: rainfall minus actual evapotranspiration) summed over a week, in millimetres; negative in weeks when evapotranspiration exceeds rainfall. A recharge-related input, not a measured recharge."@en .
lulcw:GroundwaterRecharge a sosa:ObservableProperty ;
    rdfs:label "groundwater recharge"@en , "recharge des nappes"@fr ;
    skos:definition "Water reaching the saturated zone of a unit per unit of time, by any pathway (diffuse infiltration, lateral inflow, leakage, river or canal losses). Not observed in this graph: effective rainfall and soil drainage over a unit's outcrop stand in for one part of it."@en .
lulcw:CanalDiversionVolume a sosa:ObservableProperty ;
    rdfs:label "canal diversion volume"@en , "volume dérivé par les canaux"@fr ;
    skos:definition "Volume declared at canal intakes, spread over the irrigation season, in cubic metres; a proxy for return flow, not a recharge volume."@en .
lulcw:RiverDischarge a sosa:ObservableProperty ;
    rdfs:label "river discharge"@en , "débit de rivière"@fr ;
    skos:definition "Weekly mean discharge at a gauge, in cubic metres per second; it represents its own site, not recharge to a whole unit."@en .

#################################################################
# Object properties
#################################################################

lulcw:hostedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:MonitoringStation ; rdfs:range lulcw:Piezometer ;
    rdfs:label "hosted by"@en , "installée sur"@fr ;
    skos:definition "Links a monitoring station to the piezometer that hosts it."@en .

lulcw:hasObservationSeries a owl:ObjectProperty ;
    rdfs:domain lulcw:MonitoringStation ; rdfs:range lulcw:ObservationSeries ;
    rdfs:label "has observation series"@en , "a pour série d'observations"@fr ;
    skos:definition "Links a monitoring station to a series of its observations kept outside the graph."@en .

lulcw:seriesVariable a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ObservationSeries ; rdfs:range sosa:ObservableProperty ;
    rdfs:label "series variable"@en , "variable de la série"@fr ;
    skos:definition "The observed property of a series (e.g. groundwater head)."@en .

lulcw:inRelease a owl:ObjectProperty ;
    rdfs:range lulcw:DataRelease ;
    rdfs:label "in release"@en , "dans la version"@fr ;
    skos:definition "Links a source record, a series or a derived assertion to the data release it belongs to."@en .

lulcw:inGroundwaterBody a owl:ObjectProperty ;
    rdfs:domain lulcw:Piezometer ; rdfs:range lulcw:GroundwaterBody ;
    rdfs:label "in groundwater body"@en , "dans la masse d'eau"@fr ;
    skos:definition "Links a piezometer to a groundwater body it is recorded in; a well may belong to several."@en .

lulcw:locatedInPolygon a owl:ObjectProperty ;
    rdfs:range lulcw:ElementaryPolygon ;
    rdfs:label "located in polygon"@en , "situé dans le polygone"@fr ;
    skos:definition "Links a piezometer or an abstraction facility to the BD LISA elementary polygon containing its location (point in polygon, Lambert-93)."@en .

lulcw:hasStackLayer a owl:ObjectProperty ;
    rdfs:domain lulcw:ElementaryPolygon ; rdfs:range lulcw:StackLayer ;
    rdfs:label "has stack layer"@en , "a pour niveau de pile"@fr ;
    skos:definition "Links an elementary polygon to one layer of its stack."@en .

lulcw:layerUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:StackLayer ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "layer unit"@en , "entité du niveau"@fr ;
    skos:definition "The hydrogeological unit of a stack layer."@en .

lulcw:upperUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:StratigraphicRelation ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "upper unit"@en , "entité supérieure"@fr ;
    skos:definition "The unit that lies above in a stratigraphic relation."@en .

lulcw:lowerUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:StratigraphicRelation ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "lower unit"@en , "entité inférieure"@fr ;
    skos:definition "The unit that lies below in a stratigraphic relation."@en .

lulcw:relationKind a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:StratigraphicRelation ; rdfs:range lulcw:StratigraphicRelationKind ;
    rdfs:label "relation kind"@en , "type de relation"@fr ;
    skos:definition "Whether a stratigraphic relation is a direct contact or an indirect ordering."@en .

lulcw:witnessedBy a owl:ObjectProperty ;
    rdfs:domain lulcw:StratigraphicRelation ; rdfs:range lulcw:ElementaryPolygon ;
    rdfs:label "witnessed by"@en , "attestée par"@fr ;
    skos:definition "An elementary polygon whose stack shows the stratigraphic relation."@en .

lulcw:interveningUnit a owl:ObjectProperty ;
    rdfs:domain lulcw:StratigraphicRelation ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "intervening unit"@en , "entité intercalée"@fr ;
    skos:definition "A unit mapped between the upper and the lower unit of an indirect ordering, in the witnessing stack."@en .

lulcw:overlies a owl:ObjectProperty ;
    rdfs:domain lulcw:HydrogeologicalUnit ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "overlies"@en , "repose sur"@fr ;
    skos:definition "Shortcut: the first unit is in direct contact above the second in at least one elementary polygon (a lulcw:StratigraphicRelation of kind direct contact holds the witnesses). Deliberately not transitive; not a hydraulic relation."@en .

lulcw:hasMemberUnit a owl:ObjectProperty ;
    rdfs:domain lulcw:HydrogeologicalUnitGroup ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "has member unit"@en , "comprend l'entité"@fr ;
    skos:definition "Links a unit group to one of its hydrogeological units."@en .

lulcw:hasIntake a owl:ObjectProperty ;
    rdfs:domain lulcw:AbstractionFacility ; rdfs:range lulcw:Intake ;
    rdfs:label "has intake"@en , "a pour point de prélèvement"@fr ;
    skos:definition "Links an abstraction facility to one of its intakes."@en .

lulcw:attributedEntity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:UnitAttribution ;
    rdfs:label "attributed entity"@en , "entité attribuée"@fr ;
    skos:definition "The piezometer or abstraction facility that a unit attribution is about."@en .

lulcw:candidateUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:UnitAttribution ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "candidate unit"@en , "entité candidate"@fr ;
    skos:definition "The hydrogeological unit proposed by an attribution resolved to the exact unit."@en .

lulcw:candidateGroup a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:UnitAttribution ; rdfs:range lulcw:HydrogeologicalUnitGroup ;
    rdfs:label "candidate group"@en , "groupe candidat"@fr ;
    skos:definition "The unit group proposed by an attribution, the only target when the evidence resolves to the group."@en .

lulcw:role a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:UnitAttribution ; rdfs:range lulcw:AttributionRole ;
    rdfs:label "has role"@en , "a pour rôle"@fr ;
    skos:definition "Whether a unit attribution concerns monitoring or abstraction."@en .

lulcw:derivationRule a owl:ObjectProperty ;
    rdfs:range lulcw:DerivationRule ;
    rdfs:label "derived by rule"@en , "dérivée par la règle"@fr ;
    skos:definition "The rule that produced a qualified assertion."@en .

lulcw:evaluatedRule a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:RuleEvaluation ; rdfs:range lulcw:DerivationRule ;
    rdfs:label "evaluated rule"@en , "règle évaluée"@fr ;
    skos:definition "The rule a rule evaluation measures."@en .

lulcw:confidence a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range lulcw:ConfidenceLevel ;
    rdfs:label "has confidence level"@en , "a pour niveau de confiance"@fr ;
    skos:definition "The evidence-policy confidence level of a qualified assertion."@en .

lulcw:resolution a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range lulcw:Resolution ;
    rdfs:label "has resolution"@en , "a pour résolution"@fr ;
    skos:definition "The level (exact unit or unit group) at which an attribution or a rule evaluation is resolved."@en .

lulcw:assessmentStatus a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range lulcw:AssessmentStatus ;
    rdfs:label "has assessment status"@en , "a pour statut d'évaluation"@fr ;
    skos:definition "Candidate, accepted, rejected or superseded status of a qualified assertion."@en .

lulcw:evidenceKind a owl:ObjectProperty ;
    rdfs:range lulcw:EvidenceKind ;
    rdfs:label "has evidence kind"@en , "a pour nature de preuve"@fr ;
    skos:definition "The kind of evidence behind a qualified assertion."@en .

lulcw:applicableUse a owl:ObjectProperty ;
    rdfs:range lulcw:WaterUse ;
    rdfs:label "applicable use"@en , "usage concerné"@fr ;
    skos:definition "A water use for which an attribution's confidence or a rule evaluation was measured; an irrigation candidate cannot inherit a drinking-water evaluation."@en .

lulcw:waterUse a owl:ObjectProperty ;
    rdfs:range lulcw:WaterUse ;
    rdfs:label "has water use"@en , "a pour usage"@fr ;
    skos:definition "The declared use of the volume of an annual abstraction record, or the use an accounting result covers."@en .

lulcw:waterSource a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range lulcw:WaterSource ;
    rdfs:label "has water source"@en , "a pour milieu de prélèvement"@fr ;
    skos:definition "Groundwater or surface water, for an abstraction facility or record."@en .

lulcw:recordKind a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:AnnualAbstractionRecord ; rdfs:range lulcw:RecordKind ;
    rdfs:label "has record kind"@en , "a pour nature d'enregistrement"@fr ;
    skos:definition "Whether an annual abstraction record is declared, imputed or reconstructed."@en .

lulcw:selectedUnder a owl:ObjectProperty ;
    rdfs:range lulcw:ExportPolicy ;
    rdfs:label "selected under"@en , "retenue par"@fr ;
    skos:definition "An export policy that selects this qualified assertion as a model input or graph edge."@en .

lulcw:admitsConfidence a owl:ObjectProperty ;
    rdfs:domain lulcw:ExportPolicy ; rdfs:range lulcw:ConfidenceLevel ;
    rdfs:label "admits confidence level"@en , "admet le niveau de confiance"@fr ;
    skos:definition "A confidence level whose unit attributions the export policy selects, at the resolution they were assessed. Selection does not raise their confidence."@en .

lulcw:monitors a owl:ObjectProperty ;
    rdfs:domain lulcw:Piezometer ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "monitors"@en , "surveille"@fr ;
    skos:definition "Projection of the unit attributions with the monitoring role that a named export policy selects; the attributions remain the evidence."@en .

lulcw:pumpsFrom a owl:ObjectProperty ;
    rdfs:domain lulcw:AbstractionFacility ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "pumps from"@en , "prélève dans"@fr ;
    skos:definition "Projection of the unit attributions with the abstraction role that a named export policy selects (main runs: confident and probable). Selection does not raise certainty; the attributions remain the evidence."@en .

lulcw:wellA a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:WellLink ; rdfs:range lulcw:Piezometer ;
    rdfs:label "first well"@en , "premier piézomètre"@fr ;
    skos:definition "The piezometer of a well link whose BSS code sorts first, so that an unordered pair is stored once."@en .

lulcw:wellB a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:WellLink ; rdfs:range lulcw:Piezometer ;
    rdfs:label "second well"@en , "second piézomètre"@fr ;
    skos:definition "The piezometer of a well link whose BSS code sorts second."@en .

lulcw:sharedUnit a owl:ObjectProperty ;
    rdfs:domain lulcw:WellLink ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "shared unit"@en , "entité commune"@fr ;
    skos:definition "A hydrogeological unit that both wells of a link are attributed to under the stated policy."@en .

lulcw:driverEntity a owl:ObjectProperty ;
    rdfs:domain lulcw:Influence ;
    rdfs:label "driver entity"@en , "entité motrice"@fr ;
    skos:definition "The entity whose driver variable an influence is about (e.g. an abstraction facility, an outcrop area, a weather cell)."@en .

lulcw:targetEntity a owl:ObjectProperty ;
    rdfs:domain lulcw:Influence ;
    rdfs:label "target entity"@en , "entité cible"@fr ;
    skos:definition "The piezometer whose head an influence may change."@en .

lulcw:driverVariable a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:Influence ; rdfs:range sosa:ObservableProperty ;
    rdfs:label "driver variable"@en , "variable motrice"@fr ;
    skos:definition "The variable whose increase the response sign of an influence refers to."@en .

lulcw:mechanism a owl:ObjectProperty ;
    rdfs:domain lulcw:Influence ; rdfs:range lulcw:Mechanism ;
    rdfs:label "has mechanism"@en , "a pour mécanisme"@fr ;
    skos:definition "The physical mechanism an influence relies on."@en .

lulcw:responseSign a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:Influence ; rdfs:range lulcw:ResponseSign ;
    rdfs:label "has response sign"@en , "a pour signe de réponse"@fr ;
    skos:definition "The proposed direction of the head response to an increase of the driver variable."@en .

lulcw:driverGroup a owl:ObjectProperty ;
    rdfs:domain lulcw:Influence ; rdfs:range lulcw:DriverGroup ;
    rdfs:label "in driver group"@en , "dans le groupe de forçages"@fr ;
    skos:definition "A group within which the influence's effect is reported jointly with others."@en .

lulcw:constraintEligibility a owl:ObjectProperty ;
    rdfs:domain lulcw:Influence ; rdfs:range lulcw:ConstraintEligibility ;
    rdfs:label "has constraint eligibility"@en , "a pour éligibilité à la contrainte"@fr ;
    skos:definition "Whether the evidence of an influence allows its response sign to constrain a model: the evidence layer only. An eligible influence is constrained only under a policy that selects it (every segment of its pathway) and whose decision for its mechanism accepts both the driver as a proxy and the constraint (lulcw:ConstraintDecision)."@en .

lulcw:proxyFor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:Influence ; rdfs:range sosa:ObservableProperty ;
    rdfs:label "proxy for"@en , "indicateur de"@fr ;
    skos:definition "The quantity that an influence's driver variable stands in for, when the driver is a proxy (effective rainfall over an outcrop for groundwater recharge). The response sign refers to the proxy, never to the quantity it stands in for."@en .

lulcw:omitsPathway a owl:ObjectProperty ;
    rdfs:domain lulcw:Influence ; rdfs:range lulcw:Mechanism ;
    rdfs:label "omits pathway"@en , "omet la voie"@fr ;
    skos:definition "A mechanism that can also change the head at the target but that the influence does not represent: named so that an explanation never presents the influence as the complete pathway. It does not assert that the mechanism is active at the target."@en .

lulcw:allocatesRecord a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:VolumeAllocation ; rdfs:range lulcw:AnnualAbstractionRecord ;
    rdfs:label "allocates record"@en , "répartit l'enregistrement"@fr ;
    skos:definition "The annual abstraction record a volume allocation shares out."@en .

lulcw:allocatedTo a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:VolumeAllocation ;
    rdfs:label "allocated to"@en , "attribué à"@fr ;
    skos:definition "The hydrogeological unit or unit group a volume allocation gives its share to."@en .

lulcw:accountedFor a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:AccountingResult ;
    rdfs:label "accounted for"@en , "bilan de"@fr ;
    skos:definition "The hydrogeological unit or unit group an accounting result is about."@en .

lulcw:underPolicy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range lulcw:ExportPolicy ;
    rdfs:label "under policy"@en , "selon la politique"@fr ;
    skos:definition "The policy a volume allocation or an accounting result was computed under."@en .

lulcw:reportingExtent a owl:ObjectProperty ;
    rdfs:domain lulcw:AccountingResult ; rdfs:range geo:Feature ;
    rdfs:label "reporting extent"@en , "emprise du bilan"@fr ;
    skos:definition "The area whose facilities an accounting result includes, by an explicit selection rule; it does not imply that all abstraction from the unit occurs inside it."@en .

#################################################################
# Datatype properties (units in the names, stated in the definitions)
#################################################################

lulcw:bssCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "BSS code"@en , "code BSS"@fr ;
    skos:definition "Identifier of a borehole in the French subsurface database (BSS), e.g. 10906X0039/C2-1."@en .
lulcw:bssId a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "BSS identifier"@en , "identifiant BSS"@fr ;
    skos:definition "New-format BSS identifier of a borehole, e.g. BSS002MNYD."@en .
lulcw:bnpeCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "BNPE facility code"@en , "code d'ouvrage BNPE"@fr ;
    skos:definition "Identifier of an abstraction facility in the national withdrawal database (BNPE code_ouvrage)."@en .
lulcw:bdlisaCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "BD LISA code"@en , "code BD LISA"@fr ;
    skos:definition "Code of a BD LISA hydrogeological entity (CodeEH), e.g. 671AA00."@en .
lulcw:polygonCode a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "BD LISA polygon code"@en , "code de polygone BD LISA"@fr ;
    skos:definition "Code of a BD LISA elementary polygon (CodePoly)."@en .
lulcw:groundwaterBodyCode a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "groundwater body code"@en , "code de masse d'eau"@fr ;
    skos:definition "Code of a Water Framework Directive groundwater body, e.g. DG243."@en .
lulcw:sourceIdentifier a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "source identifier"@en , "identifiant source"@fr ;
    skos:definition "The original identifier of a source record in its data release."@en .
lulcw:bdlisaNatureCode a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "BD LISA nature code"@en , "code nature BD LISA"@fr ;
    skos:definition "BD LISA nature of an entity at level 3 (natureeh): 5 aquifer unit, 6 semi-permeable unit, 7 impermeable unit. It describes the BD LISA entity, not the hydraulic type of the unit in this ontology."@en .
lulcw:bdlisaThemeCode a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "BD LISA theme code"@en , "code thème BD LISA"@fr ;
    skos:definition "BD LISA theme (themeeh): 1 alluvial, 2 sedimentary, 3 basement, 4 intensely folded, 5 volcanic."@en .
lulcw:bdlisaMediumCode a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "BD LISA medium code"@en , "code milieu BD LISA"@fr ;
    skos:definition "BD LISA medium (milieueh, SANDRE nomenclature 353): 1 porous, 2 fissured, 3 karstic, 4 to 10 mixed porosity, 11 fractured."@en .
lulcw:layerOrder a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:StackLayer ; rdfs:range xsd:integer ;
    rdfs:label "layer order"@en , "ordre du niveau"@fr ;
    skos:definition "Relative order of a layer in its polygon's stack (BD LISA OrdRelatif; 1 = mapped at the surface)."@en .
lulcw:witnessAreaM2 a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "witness area (m²)"@en , "surface témoin (m²)"@fr ;
    skos:definition "Total area, in square metres (Lambert-93), of the polygons that witness a stratigraphic relation."@en .
lulcw:investigationDepthM a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "investigation depth (m)"@en , "profondeur d'investigation (m)"@fr ;
    skos:definition "Investigation depth of a borehole below ground, in metres (Hub'Eau profondeur_investigation). It is not the screened interval, and a missing value is never zero."@en .
lulcw:screenTopDepthM a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "screen top depth (m)"@en , "profondeur du haut de la crépine (m)"@fr ;
    skos:definition "Depth below ground, in metres, of the top of a documented screened interval; only from a construction record."@en .
lulcw:screenBottomDepthM a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "screen bottom depth (m)"@en , "profondeur du bas de la crépine (m)"@fr ;
    skos:definition "Depth below ground, in metres, of the bottom of a documented screened interval; only from a construction record."@en .
lulcw:groundElevationM a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "ground elevation (m NGF)"@en , "altitude du sol (m NGF)"@fr ;
    skos:definition "Elevation of the ground (or reference mark) at a station, in metres above the NGF-IGN69 datum."@en .
lulcw:verticalDatum a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "vertical datum"@en , "référence altimétrique"@fr ;
    skos:definition "The vertical datum of the head values of a series (e.g. NGF-IGN69)."@en .
lulcw:temporalResolution a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "temporal resolution"@en , "pas de temps"@fr ;
    skos:definition "Time step of a series, as an ISO 8601 duration (e.g. P7D)."@en .
lulcw:coverageStart a owl:DatatypeProperty ;
    rdfs:label "coverage start"@en , "début de couverture"@fr ;
    skos:definition "First date covered by a series (an xsd:date literal)."@en .
lulcw:coverageEnd a owl:DatatypeProperty ;
    rdfs:label "coverage end"@en , "fin de couverture"@fr ;
    skos:definition "Last date covered by a series (an xsd:date literal)."@en .
lulcw:storedIn a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "stored in"@en , "stockée dans"@fr ;
    skos:definition "Path of the table holding a series outside the graph, relative to the project root, with the key that selects it."@en .
lulcw:qualityPolicy a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "quality policy"@en , "politique qualité"@fr ;
    skos:definition "The quality filter applied to a series (e.g. values qualified 'Incorrecte' dropped before the weekly mean)."@en .
lulcw:releaseDate a owl:DatatypeProperty ;
    rdfs:label "release date"@en , "date de version"@fr ;
    skos:definition "Publication or build date of a data release (an xsd:date literal); not the date its facts apply to."@en .
lulcw:retrievalDate a owl:DatatypeProperty ;
    rdfs:label "retrieval date"@en , "date de récupération"@fr ;
    skos:definition "Date a data release was retrieved from its source (an xsd:date literal)."@en .
lulcw:codeVersion a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "code version"@en , "version du code"@fr ;
    skos:definition "Version of the code of a rule execution (a git commit)."@en .
lulcw:ruleVersion a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "rule version"@en , "version de la règle"@fr ;
    skos:definition "Version of a derivation rule or of an export policy."@en .
lulcw:rank a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:label "rank"@en , "rang"@fr ;
    skos:definition "Rank of an attribution among the candidates for the same entity and role (1 = main candidate)."@en .
lulcw:unknownReason a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "reason for unknown"@en , "raison de l'inconnu"@fr ;
    skos:definition "Why an attribution has no target (e.g. no record, no measured rule for this stack)."@en .
lulcw:precision a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "precision"@en , "précision"@fr ;
    skos:definition "Share of the cases where a rule fires that agree with the reference, at the evaluation's resolution."@en .
lulcw:sampleSize a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:label "sample size"@en , "effectif"@fr ;
    skos:definition "Number of reference cases a rule evaluation used."@en .
lulcw:searchRadiusM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:DerivationRule ; rdfs:range xsd:double ;
    rdfs:label "search radius (m)"@en , "rayon de recherche (m)"@fr ;
    skos:definition "Horizontal search radius in metres (Lambert-93, inclusive) that a spatial derivation rule applies: a named, reproducible reference query, not a hydraulic limit. A tighter threshold may be applied at export."@en .
lulcw:horizontalDistanceM a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "horizontal distance (m)"@en , "distance horizontale (m)"@fr ;
    skos:definition "Projected horizontal distance in metres (Lambert-93) between the two entities of a well link or an influence; a selection descriptor, not hydraulic evidence."@en .
lulcw:investigationDepthDifferenceM a owl:DatatypeProperty ; rdfs:range xsd:double ;
    rdfs:label "investigation-depth difference (m)"@en , "écart de profondeur d'investigation (m)"@fr ;
    skos:definition "Absolute difference of the investigation depths of the two wells of a link, in metres; absent when either depth is missing."@en .
lulcw:conditions a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "conditions"@en , "conditions"@fr ;
    skos:definition "The conditions under which an influence's response sign holds, stated in words (e.g. the facility pumps from the unit the well monitors, distance at most d)."@en .
lulcw:eligibilityReason a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "eligibility reason"@en , "motif d'éligibilité"@fr ;
    skos:definition "Why an influence is or is not eligible to constrain a model."@en .
lulcw:constraintDecision a owl:ObjectProperty ;
    rdfs:domain lulcw:ExportPolicy ; rdfs:range lulcw:ConstraintDecision ;
    rdfs:label "has constraint decision"@en , "a pour décision de contrainte"@fr ;
    skos:definition "A constraint decision of the policy, one per mechanism; a mechanism without one constrains nothing under the policy."@en .
lulcw:decisionMechanism a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ConstraintDecision ; rdfs:range lulcw:Mechanism ;
    rdfs:label "decision mechanism"@en , "mécanisme de la décision"@fr ;
    skos:definition "The mechanism whose influences the constraint decision is about."@en .
lulcw:proxyReview a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ConstraintDecision ; rdfs:range lulcw:AssessmentStatus ;
    rdfs:label "proxy review"@en , "examen du substitut"@fr ;
    skos:definition "Whether the driver of the mechanism's influences was reviewed as an adequate stand-in for what the mechanism responds to (e.g. a remote gauge's discharge for the river stage near a well, the plain's summed canal diversions for local canal seepage): candidate (not reviewed), accepted or rejected."@en .
lulcw:constraintApproval a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ConstraintDecision ; rdfs:range lulcw:AssessmentStatus ;
    rdfs:label "constraint approval"@en , "approbation de la contrainte"@fr ;
    skos:definition "Whether the policy applies the eligible response signs of the mechanism as model constraints: candidate (pending), accepted or rejected."@en .
lulcw:decisionBasis a owl:DatatypeProperty ; rdfs:range xsd:string ;
    rdfs:label "decision basis"@en , "fondement de la décision"@fr ;
    skos:definition "Who decided, when, and where the decision is recorded; or what a pending decision waits for."@en .
lulcw:allocationWeight a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "allocation weight"@en , "poids de répartition"@fr ;
    skos:definition "Share, between 0 and 1, of an annual record's volume given to the allocated unit or group."@en .
lulcw:accountingYear a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:label "accounting year"@en , "année du bilan"@fr ;
    skos:definition "Calendar year an accounting result covers."@en .
lulcw:eligibleDeclaredVolumeM3 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "eligible declared volume (m³)"@en , "volume déclaré éligible (m³)"@fr ;
    skos:definition "Total declared volume, in cubic metres, of the records an accounting covers, after documented deduplication."@en .
lulcw:allocatedVolumeM3 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "allocated volume (m³)"@en , "volume attribué (m³)"@fr ;
    skos:definition "Part of the eligible declared volume, in cubic metres, attributed to the unit or group under the policy."@en .
lulcw:unresolvedVolumeM3 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "unresolved volume (m³)"@en , "volume non attribué (m³)"@fr ;
    skos:definition "Part of the eligible declared volume, in cubic metres, without an accepted attribution under the policy."@en .
lulcw:excludedVolumeM3 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "excluded volume (m³)"@en , "volume exclu (m³)"@fr ;
    skos:definition "Part of the eligible declared volume, in cubic metres, explicitly excluded by the policy, with a stated reason."@en .
lulcw:facilityCount a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:label "facility count"@en , "nombre d'ouvrages"@fr ;
    skos:definition "Number of facilities an accounting result covers."@en .

#################################################################
# Land use and crops (0.3.0, task 12.6, CQ7): dated crop areas around the wells, crop classes
# with their FAO-56 parameters, potential irrigation demand and its dated category
#################################################################

lulcw:CropCode a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "RPG crop code"@en , "code culture RPG"@fr ;
    skos:definition "A crop code of the French land-parcel register (RPG, CODE_CULTU), with its official label and crop group; the concept a declared parcel's crop refers to, aligned to shared vocabularies separately (task 12.9)."@en .

lulcw:CropClass a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "crop class"@en , "classe de culture"@fr ;
    skos:definition "One of the harmonised crop classes of the project (configs/lu_crop_classes.csv), grouping RPG crop codes by a written rule (code overrides first, then the RPG crop group), with the FAO-56 single crop coefficients and growth stages used outside OWL and an irrigation assumption."@en .

lulcw:WellZone a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "well zone"@en , "zone autour d'un piézomètre"@fr ;
    skos:definition "The area within a fixed horizontal radius of a piezometer over which a named, reproducible reference query runs (clipping crop parcels, searching the outcrop of a unit): not a capture zone or a hydraulic limit."@en .

lulcw:CropDemandZone a owl:Class ;
    rdfs:subClassOf lulcw:WellZone ;
    rdfs:label "crop demand zone"@en , "zone de demande des cultures"@fr ;
    skos:definition "The area within a fixed horizontal radius of a piezometer (3 km in this project) over which declared parcels are clipped: a named, reproducible reference query, not a capture zone or a hydraulic limit."@en .

lulcw:CropAreaObservation a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "crop area observation"@en , "observation de surface cultivée"@fr ;
    skos:definition "The area, in hectares, of the parcels of one RPG crop code inside one crop demand zone in one RPG campaign year, clipped at the zone boundary (a parcel half inside counts half). Parcel geometries stay outside the graph."@en .

lulcw:CropClassArea a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "crop class area"@en , "surface par classe de culture"@fr ;
    skos:definition "The clipped area, in hectares, of one crop class in one crop demand zone and RPG campaign year, derived by a rule from the crop area observations of its codes; codes without a class are summed as unmapped area, never dropped."@en .

lulcw:CropDemandEstimate a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "potential irrigation demand estimate"@en , "estimation de la demande potentielle d'irrigation"@fr ;
    skos:definition "Potential irrigation demand of a crop demand zone over one calendar year, in cubic metres, computed outside OWL: for each week, the clipped area times max(0, Kc times the week's reference evapotranspiration minus its rainfall), summed over the year. A crop water requirement under stated assumptions, not a metered or declared irrigation volume."@en .

lulcw:IrrigationDemandAssessment a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "irrigation demand assessment"@en , "évaluation de la demande d'irrigation"@fr ;
    skos:definition "A dated categorical assessment of the potential irrigation demand of a crop demand zone in one calendar year, by a documented rule and threshold; it never gives a zone a timeless status."@en .

lulcw:IrrigationAssumption a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "irrigation assumption"@en , "hypothèse d'irrigation"@fr ;
    skos:definition "How commonly a crop class is irrigated in the study area, as an assumption backed by the 2020 agricultural census of the département; not the irrigation status of a parcel."@en .
lulcw:IrrigationAssumptionScheme a skos:ConceptScheme ;
    rdfs:label "irrigation assumptions"@en , "hypothèses d'irrigation"@fr ;
    skos:definition "Values of lulcw:IrrigationAssumption."@en .
lulcw:UsuallyIrrigated a lulcw:IrrigationAssumption ; skos:inScheme lulcw:IrrigationAssumptionScheme ; skos:topConceptOf lulcw:IrrigationAssumptionScheme ;
    skos:prefLabel "usually irrigated"@en , "généralement irriguée"@fr ;
    rdfs:label "usually irrigated"@en , "généralement irriguée"@fr ;
    skos:definition "Most of the area of the class is irrigated in the département (e.g. orchards, vegetables); the classes of the main demand index."@en .
lulcw:PartlyIrrigated a lulcw:IrrigationAssumption ; skos:inScheme lulcw:IrrigationAssumptionScheme ; skos:topConceptOf lulcw:IrrigationAssumptionScheme ;
    skos:prefLabel "partly irrigated"@en , "partiellement irriguée"@fr ;
    rdfs:label "partly irrigated"@en , "partiellement irriguée"@fr ;
    skos:definition "A minority of the area of the class is irrigated (e.g. vines); added only in the wide sensitivity index."@en .
lulcw:Rainfed a lulcw:IrrigationAssumption ; skos:inScheme lulcw:IrrigationAssumptionScheme ; skos:topConceptOf lulcw:IrrigationAssumptionScheme ;
    skos:prefLabel "rainfed"@en , "pluviale"@fr ;
    rdfs:label "rainfed"@en , "pluviale"@fr ;
    skos:definition "The class is assumed not irrigated in the study area (e.g. winter cereals, pasture)."@en .
lulcw:NotCropped a lulcw:IrrigationAssumption ; skos:inScheme lulcw:IrrigationAssumptionScheme ; skos:topConceptOf lulcw:IrrigationAssumptionScheme ;
    skos:prefLabel "not cropped"@en , "non cultivée"@fr ;
    rdfs:label "not cropped"@en , "non cultivée"@fr ;
    skos:definition "Fallow or non-productive declared land, with no crop water requirement."@en .

lulcw:DemandCategory a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "irrigation demand category"@en , "catégorie de demande d'irrigation"@fr ;
    skos:definition "Category of a zone's potential irrigation demand in one year, relative to a stated threshold."@en .
lulcw:DemandCategoryScheme a skos:ConceptScheme ;
    rdfs:label "irrigation demand categories"@en , "catégories de demande d'irrigation"@fr ;
    skos:definition "Values of lulcw:DemandCategory."@en .
lulcw:HighIrrigationDemand a lulcw:DemandCategory ; skos:inScheme lulcw:DemandCategoryScheme ; skos:topConceptOf lulcw:DemandCategoryScheme ;
    skos:prefLabel "high irrigation demand"@en , "forte demande d'irrigation"@fr ;
    rdfs:label "high irrigation demand"@en , "forte demande d'irrigation"@fr ;
    skos:definition "The zone's potential irrigation demand in the year reaches the threshold of the rule that assessed it (a potential requirement, not observed irrigation)."@en .
lulcw:BelowHighIrrigationDemand a lulcw:DemandCategory ; skos:inScheme lulcw:DemandCategoryScheme ; skos:topConceptOf lulcw:DemandCategoryScheme ;
    skos:prefLabel "below high irrigation demand"@en , "sous la forte demande d'irrigation"@fr ;
    rdfs:label "below high irrigation demand"@en , "sous la forte demande d'irrigation"@fr ;
    skos:definition "The zone's potential irrigation demand in the year is below the threshold of the rule that assessed it; not a statement that no irrigation occurs."@en .

lulcw:ClippedCropArea a sosa:ObservableProperty ;
    rdfs:label "clipped crop area"@en , "surface cultivée découpée"@fr ;
    skos:definition "Area of declared parcels inside a zone, clipped at its boundary, in hectares."@en .
lulcw:PotentialIrrigationDemandMain a sosa:ObservableProperty ;
    rdfs:label "potential irrigation demand, main classes"@en , "demande potentielle d'irrigation, classes principales"@fr ;
    skos:definition "Potential irrigation demand of the crop classes usually irrigated, over a calendar year, in cubic metres."@en .
lulcw:PotentialIrrigationDemandWide a sosa:ObservableProperty ;
    rdfs:label "potential irrigation demand, wide classes"@en , "demande potentielle d'irrigation, classes élargies"@fr ;
    skos:definition "Potential irrigation demand of the crop classes usually or partly irrigated, over a calendar year, in cubic metres."@en .

lulcw:cropCode a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:CropAreaObservation ; rdfs:range lulcw:CropCode ;
    rdfs:label "has crop code"@en , "a pour code culture"@fr ;
    skos:definition "The RPG crop code whose parcels a crop area observation measures."@en .
lulcw:cropClass a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range lulcw:CropClass ;
    rdfs:label "has crop class"@en , "a pour classe de culture"@fr ;
    skos:definition "The crop class of an RPG crop code under the class-mapping rule, or the class a crop class area is about."@en .
lulcw:irrigationAssumption a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:CropClass ; rdfs:range lulcw:IrrigationAssumption ;
    rdfs:label "has irrigation assumption"@en , "a pour hypothèse d'irrigation"@fr ;
    skos:definition "How commonly the crop class is assumed to be irrigated in the study area."@en .
lulcw:zoneOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:WellZone ; rdfs:range lulcw:Piezometer ;
    rdfs:label "zone of"@en , "zone de"@fr ;
    skos:definition "The piezometer at the centre of a well zone (a crop demand zone or an outcrop search zone); queries name the kind of zone they want."@en .
lulcw:demandCategory a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:IrrigationDemandAssessment ; rdfs:range lulcw:DemandCategory ;
    rdfs:label "has demand category"@en , "a pour catégorie de demande"@fr ;
    skos:definition "The category an irrigation demand assessment gives the zone for its year."@en .

lulcw:rpgGroupCode a owl:DatatypeProperty ; rdfs:range xsd:integer ;
    rdfs:label "RPG crop group code"@en , "code du groupe de cultures RPG"@fr ;
    skos:definition "Number of an RPG crop group (CODE_GROUP): the group of a crop code, or a group a crop class takes by the mapping rule."@en .
lulcw:overrideCode a owl:DatatypeProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:string ;
    rdfs:label "override crop code"@en , "code culture prioritaire"@fr ;
    skos:definition "An RPG crop code assigned to the crop class whatever its group (the mapping rule applies overrides first)."@en .
lulcw:kcInitial a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:double ;
    rdfs:label "initial crop coefficient"@en , "coefficient cultural initial"@fr ;
    skos:definition "FAO-56 single crop coefficient of the initial stage (Kc ini), dimensionless."@en .
lulcw:kcMid a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:double ;
    rdfs:label "mid-season crop coefficient"@en , "coefficient cultural de mi-saison"@fr ;
    skos:definition "FAO-56 single crop coefficient of the mid-season stage (Kc mid), dimensionless."@en .
lulcw:kcEnd a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:double ;
    rdfs:label "end-season crop coefficient"@en , "coefficient cultural de fin de saison"@fr ;
    skos:definition "FAO-56 single crop coefficient at the end of the late season (Kc end), dimensionless."@en .
lulcw:initialStageDays a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:integer ;
    rdfs:label "initial stage length (days)"@en , "durée de la phase initiale (jours)"@fr ;
    skos:definition "Length in days of the FAO-56 initial growth stage."@en .
lulcw:developmentStageDays a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:integer ;
    rdfs:label "development stage length (days)"@en , "durée de la phase de développement (jours)"@fr ;
    skos:definition "Length in days of the FAO-56 crop development stage."@en .
lulcw:midSeasonStageDays a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:integer ;
    rdfs:label "mid-season stage length (days)"@en , "durée de la mi-saison (jours)"@fr ;
    skos:definition "Length in days of the FAO-56 mid-season stage."@en .
lulcw:lateSeasonStageDays a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:integer ;
    rdfs:label "late-season stage length (days)"@en , "durée de l'arrière-saison (jours)"@fr ;
    skos:definition "Length in days of the FAO-56 late-season stage."@en .
lulcw:plantingMonth a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:integer ;
    rdfs:label "season start month"@en , "mois de début de saison"@fr ;
    skos:definition "Month (1 to 12) whose first day starts the crop season in the demand computation."@en .
lulcw:perennial a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CropClass ; rdfs:range xsd:boolean ;
    rdfs:label "perennial"@en , "pérenne"@fr ;
    skos:definition "Whether the crop class is perennial (it keeps its initial coefficient off season) rather than annual (no requirement off season)."@en .
lulcw:zoneRadiusM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:WellZone ; rdfs:range xsd:double ;
    rdfs:label "zone radius (m)"@en , "rayon de la zone (m)"@fr ;
    skos:definition "Radius in metres (Lambert-93) of a well zone around its piezometer."@en .
lulcw:rpgEdition a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:integer ;
    rdfs:label "RPG edition"@en , "édition du RPG"@fr ;
    skos:definition "The annual RPG edition (campaign year) a crop area observation or a demand estimate uses."@en .
lulcw:demandThresholdM3 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:DerivationRule ; rdfs:range xsd:double ;
    rdfs:label "demand threshold (m³)"@en , "seuil de demande (m³)"@fr ;
    skos:definition "Annual potential irrigation demand of a zone, in cubic metres, at or above which an assessment rule gives the high category; frozen on the training years before any test evaluation."@en .

#################################################################
# Recharge-related forcing (0.4.0, CQ4): weather cells over the mapped outcrop of units
#################################################################

lulcw:WeatherCell a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "weather cell"@en , "maille météorologique"@fr ;
    skos:definition "A point of the 8 km SAFRAN grid of Météo-France's SIM2 reanalysis, taken as the 8 km square centred on it (Lambert II étendu), whose daily forcing is summed weekly outside the graph: a spatial support for model inputs, not a measurement site."@en .

lulcw:OutcropSearchZone a owl:Class ;
    rdfs:subClassOf lulcw:WellZone ;
    rdfs:label "outcrop search zone"@en , "zone de recherche des affleurements"@fr ;
    skos:definition "The area within a fixed horizontal radius of a piezometer (5 km here, the radius of the pumping influences) inside which the mapped outcrop of units is intersected with weather cells: a reference extent for recharge-related inputs, not a recharge area or a capture zone."@en .

lulcw:PolygonCellIntersection a owl:Class ;
    rdfs:label "polygon-cell intersection"@en , "intersection polygone-maille"@fr ;
    skos:definition "The part of one BD LISA elementary polygon that lies inside one reference extent and inside one weather cell, or outside every weather cell when no cell is given, with its area in square metres, computed outside OWL (GeoPandas, Lambert-93). The geometric support of recharge-related weights, not a statement about recharge."@en .

lulcw:OutcropCoverage a owl:Class ;
    rdfs:label "outcrop coverage"@en , "couverture d'un affleurement"@fr ;
    skos:definition "For one hydrogeological unit and one reference extent, derived by a rule: the area where the unit is mapped at outcrop (order 1 of an elementary polygon's stack) inside the extent, the part of it inside weather cells, and the covered fraction. Outcrop is a mapped geological property: it does not prove infiltration, effective recharge or a complete contributing area, and recharge may also come by leakage, lateral inflow or return flow."@en .

lulcw:CellWeight a owl:Class ;
    rdfs:label "cell weight"@en , "poids d'une maille"@fr ;
    skos:definition "The share, derived by a rule, of a unit's covered outcrop area in a reference extent that lies inside one weather cell. Weights are renormalised over the covered area and sum to one over the cells of an outcrop coverage; the covered fraction says how much of the outcrop they represent."@en .

lulcw:SoilDrainage a sosa:ObservableProperty ;
    rdfs:label "soil drainage"@en , "drainage du sol"@fr ;
    skos:definition "SIM2 (SAFRAN-ISBA) daily drainage (variable DRAINC, 'Drainage' in Météo-France's parameter list) summed over a week, in millimetres: modelled water leaving the soil, a recharge-related input, not a measured recharge."@en .

lulcw:intersectedPolygon a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:PolygonCellIntersection ; rdfs:range lulcw:ElementaryPolygon ;
    rdfs:label "intersected polygon"@en , "polygone intersecté"@fr ;
    skos:definition "The elementary polygon a polygon-cell intersection is a part of."@en .
lulcw:intersectedCell a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:PolygonCellIntersection ; rdfs:range lulcw:WeatherCell ;
    rdfs:label "intersected cell"@en , "maille intersectée"@fr ;
    skos:definition "The weather cell a polygon-cell intersection lies in; absent for the part of the polygon outside every cell."@en .
lulcw:withinExtent a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range geo:Feature ;
    rdfs:label "within extent"@en , "dans l'emprise"@fr ;
    skos:definition "The reference extent (an outcrop search zone or a named extent) a polygon-cell intersection, an outcrop coverage or a recharge-proxy influence is computed in."@en .
lulcw:appliesInExtent a owl:ObjectProperty ;
    rdfs:domain lulcw:DerivationRule ; rdfs:range geo:Feature ;
    rdfs:label "applies in extent"@en , "s'applique dans l'emprise"@fr ;
    skos:definition "A named reference extent in which a rule derives its assertions, besides any per-well zone it uses (e.g. the forcing extent of the unit-wide sensitivity of the recharge proxies)."@en .
lulcw:coverageUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:OutcropCoverage ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "coverage unit"@en , "entité couverte"@fr ;
    skos:definition "The hydrogeological unit whose mapped outcrop an outcrop coverage describes."@en .
lulcw:hasCellWeight a owl:ObjectProperty ;
    rdfs:domain lulcw:OutcropCoverage ; rdfs:range lulcw:CellWeight ;
    rdfs:label "has cell weight"@en , "a pour poids de maille"@fr ;
    skos:definition "Links an outcrop coverage to the weight of each weather cell its covered area lies in."@en .
lulcw:hasForcingSeries a owl:ObjectProperty ;
    rdfs:domain lulcw:WeatherCell ; rdfs:range lulcw:ObservationSeries ;
    rdfs:label "has forcing series"@en , "a pour série de forçage"@fr ;
    skos:definition "Links a weather cell to a series of its forcing kept outside the graph (one series per variable)."@en .
lulcw:weightCell a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:CellWeight ; rdfs:range lulcw:WeatherCell ;
    rdfs:label "weighted cell"@en , "maille pondérée"@fr ;
    skos:definition "The weather cell a cell weight is about."@en .

lulcw:safranGridXHm a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:WeatherCell ; rdfs:range xsd:integer ;
    rdfs:label "SAFRAN grid X (hm)"@en , "X de la grille SAFRAN (hm)"@fr ;
    skos:definition "Easting of the SAFRAN grid point, in hectometres of Lambert II étendu (LAMBX)."@en .
lulcw:safranGridYHm a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:WeatherCell ; rdfs:range xsd:integer ;
    rdfs:label "SAFRAN grid Y (hm)"@en , "Y de la grille SAFRAN (hm)"@fr ;
    skos:definition "Northing of the SAFRAN grid point, in hectometres of Lambert II étendu (LAMBY)."@en .
lulcw:intersectionAreaM2 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:PolygonCellIntersection ; rdfs:range xsd:double ;
    rdfs:label "intersection area (m²)"@en , "surface de l'intersection (m²)"@fr ;
    skos:definition "Area of a polygon-cell intersection, in square metres (Lambert-93)."@en .
lulcw:outcropAreaM2 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:OutcropCoverage ; rdfs:range xsd:double ;
    rdfs:label "outcrop area (m²)"@en , "surface d'affleurement (m²)"@fr ;
    skos:definition "Area, in square metres, where the unit is mapped at outcrop inside the reference extent."@en .
lulcw:coveredAreaM2 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "covered area (m²)"@en , "surface couverte (m²)"@fr ;
    skos:definition "Area, in square metres, of the unit's outcrop inside the reference extent that lies inside weather cells: in all of them for an outcrop coverage, in one cell for a cell weight."@en .
lulcw:coveredFraction a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:OutcropCoverage ; rdfs:range xsd:double ;
    rdfs:label "covered fraction"@en , "fraction couverte"@fr ;
    skos:definition "Covered area divided by outcrop area, between 0 and 1: the share of the outcrop in the extent that the cell weights represent."@en .
lulcw:mappedOutcropAreaM2 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:HydrogeologicalUnit ; rdfs:range xsd:double ;
    rdfs:label "mapped outcrop area (m²)"@en , "surface d'affleurement cartographiée (m²)"@fr ;
    skos:definition "Total area, in square metres, of the elementary polygons of the geological release where the unit is mapped at outcrop (order 1 of the stack), wherever they lie: the reference against which a reference extent states how much of the unit's outcrop it clips. Zero for a unit never at outcrop in the release."@en .
lulcw:cellWeight a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:CellWeight ; rdfs:range xsd:double ;
    rdfs:label "cell weight value"@en , "valeur du poids de la maille"@fr ;
    skos:definition "Covered outcrop area inside the cell divided by the covered outcrop area of the coverage, between 0 and 1 (renormalised over the covered area)."@en .

#################################################################
# Rivers, gauges and canals (0.6.0, CQ5 and CQ6): reaches, their parts over the units, the
# documented exchanges read from the literature, and the gauges that stand in for a river
#################################################################

lulcw:Watercourse a owl:Class ;
    rdfs:label "watercourse"@en , "cours d'eau"@fr ;
    skos:definition "A river identified by its BD Carthage code (Sandre), e.g. Y04-0400 for the Têt; its reaches are the BD TOPO reaches that carry this code, and a gauge belongs to it through the same code."@en .

lulcw:HydrographicReach a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "hydrographic reach"@en , "tronçon hydrographique"@fr ;
    skos:definition "One reach of the BD TOPO hydrographic network between two of its nodes, with its geometry and nature (natural flow, canal, reservoir ...): a mapped line, not a statement about its exchange with groundwater."@en .

lulcw:RiverReach a owl:Class ;
    rdfs:subClassOf lulcw:HydrographicReach ;
    rdfs:label "river reach"@en , "tronçon de cours d'eau"@fr ;
    skos:definition "A hydrographic reach that carries the BD Carthage code of a watercourse."@en .

lulcw:CanalReach a owl:Class ;
    rdfs:subClassOf lulcw:HydrographicReach ;
    rdfs:label "canal reach"@en , "tronçon de canal"@fr ;
    skos:definition "A hydrographic reach whose BD TOPO nature is canal: a mapped conveyance line. Which parcels a canal serves is not mapped here (no command-area map exists for the plain, CQ6)."@en .

lulcw:ReachSearchZone a owl:Class ;
    rdfs:subClassOf lulcw:WellZone ;
    rdfs:label "reach search zone"@en , "zone de recherche des tronçons"@fr ;
    skos:definition "The area within a fixed horizontal radius of a piezometer (5 km here, the radius of the pumping influences) inside which river and canal reaches are intersected with the elementary polygons of the geological release: a reference extent for river and canal inputs, not a capture zone or a hydraulic limit."@en .

lulcw:ReachPiece a owl:Class ;
    rdfs:label "reach piece"@en , "portion de tronçon"@fr ;
    skos:definition "The part of one hydrographic reach that lies inside one reach search zone and one elementary polygon, with its length in metres, computed outside OWL (GeoPandas, Lambert-93); it carries the river sections it lies in. The geometric support of river-unit and canal-unit associations, not a statement about exchange."@en .

lulcw:RiverSection a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "river section"@en , "secteur de cours d'eau"@fr ;
    skos:definition "A delimited stretch of one or more watercourses that a statement is about: a river water body of the Water Framework Directive, or the stretch between two points a source locates."@en .

lulcw:SurfaceWaterBody a owl:Class ;
    rdfs:subClassOf lulcw:RiverSection ;
    rdfs:label "river water body"@en , "masse d'eau cours d'eau"@fr ;
    skos:definition "A river water body of the Water Framework Directive (Sandre référentiel, 2022 reporting), identified by its European code (e.g. FRDR224): a management unit delimiting stretches of watercourses, the scale at which the groundwater-body sheets qualify river-aquifer exchanges."@en .

lulcw:RiverGauge a owl:Class ;
    rdfs:subClassOf sosa:Platform ;
    rdfs:label "river gauge"@en , "station hydrométrique"@fr ;
    skos:definition "A hydrometric station of the Hub'Eau référentiel, identified by its station code, with its position, its watercourse and its discharge series: it measures at its own site, not along a whole river or for a whole unit."@en .

lulcw:GaugeZoneRelation a owl:Class ;
    rdfs:label "gauge-zone relation"@en , "relation station-zone"@fr ;
    skos:definition "For one gauge and one reach search zone in which the gauge's watercourse has reach pieces: the horizontal distance from the gauge to the nearest of those pieces and the gauge's position along the watercourse's main stem relative to them, computed outside OWL. Describes how well the gauge can represent the river near the well; not a hydraulic statement."@en .

lulcw:GaugePool a owl:Class ;
    rdfs:label "gauge pool"@en , "ensemble de stations"@fr ;
    skos:definition "A named set of gauges that a rule may connect to wells, e.g. the five full-record gauges of arm C's distance rule, which arm D also draws from (analysis plan §14 item 16)."@en .

lulcw:Document a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "document"@en , "document"@fr ;
    skos:definition "A published report or sheet that statements of the graph are read from, kept as a dated local copy with its checksum."@en .

lulcw:DocumentPassage a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "document passage"@en , "passage de document"@fr ;
    skos:definition "A located passage of a document: its printed page (or sheet page) and a short verbatim quote."@en .

lulcw:ExchangeStatement a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "exchange statement"@en , "énoncé d'échange"@fr ;
    skos:definition "A statement read from a document about water exchange between surface water (a river section, a watercourse or the canals) and hydrogeological units: its mechanism, direction, state or period, quantity, hedging, method, how the source names its subject, and the passage it comes from. The subject is a unit itself (lulcw:aboutUnit) or an aggregate of units (lulcw:aggregateMemberUnit, and lulcw:aboutGroundwaterBody when the source states a WFD body). The graph records what the source says, at the scale the source says it; it is not a measured effect, and statements that disagree are kept side by side."@en .

lulcw:RiverUnitAssociation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "river-unit association"@en , "association cours d'eau-entité"@fr ;
    skos:definition "Derived by a rule, for one reach search zone, one watercourse and the unit a well is attributed to: whether reaches of the watercourse in the zone run on the unit's outcrop, over the units that cover it (listed), or meet a section where a source documents an exchange with the unit itself (documented lateral); with the lengths, the statements about the unit that apply and, on outcrop, the aggregate statements localised to it. A geometric or documentary association, not proof of hydraulic connection (CQ5)."@en .

lulcw:CanalUnitAssociation a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "canal-unit association"@en , "association canal-entité"@fr ;
    skos:definition "Derived by a rule, for one reach search zone and the unit a well is attributed to: the length of canal reaches in the zone that run on the unit's outcrop, and the canal-return statements that name the unit. A canal crossing an outcrop is a candidate seepage or return-flow pathway, not a mapped service area and not a recharge amount (CQ6)."@en .

lulcw:SurfaceWaterIntake a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "surface-water intake"@en , "prise d'eau superficielle"@fr ;
    skos:definition "A BNPE facility (ouvrage) that withdraws surface water for irrigation or to feed a canal, identified by its BNPE code; where its water goes is not recorded. Kept apart from lulcw:AbstractionFacility, whose instances are the groundwater facilities that carry unit attributions (CQ2)."@en .

lulcw:CanalIntakeGroup a owl:Class ;
    rdfs:label "canal intake group"@en , "ensemble des prises des canaux"@fr ;
    skos:definition "The surface-water irrigation and canal intakes of the plain taken together, whose declared volumes, spread weekly, form the canal input of the models (src/dataset/pumping.py canal_series); the series is kept outside the graph. A diverted volume, not a recharge volume."@en .

lulcw:RiverStage a sosa:ObservableProperty ;
    rdfs:label "river stage"@en , "hauteur d'eau de la rivière"@fr ;
    skos:definition "Water level of a river at a reach. Not observed in this graph: the weekly discharge of a gauge stands in for it near the gauge, through the gauge's rating curve and up to the withdrawals and inflows between the gauge and the reach."@en .

lulcw:AssociationType a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "association type"@en , "type d'association"@fr ;
    skos:definition "How the surface water of a reach search zone relates to a unit: on its outcrop, over the units covering it, or through a documented lateral exchange."@en .
lulcw:AssociationTypeScheme a skos:ConceptScheme ;
    rdfs:label "association types"@en , "types d'association"@fr ;
    skos:definition "Values of lulcw:AssociationType."@en .
lulcw:OnOutcrop a lulcw:AssociationType ; skos:inScheme lulcw:AssociationTypeScheme ; skos:topConceptOf lulcw:AssociationTypeScheme ;
    skos:prefLabel "on outcrop"@en , "sur l'affleurement"@fr ;
    rdfs:label "on outcrop"@en , "sur l'affleurement"@fr ;
    skos:definition "Reaches of the zone run on polygons where the unit is mapped at outcrop (order 1): direct contact is possible."@en .
lulcw:OverCover a lulcw:AssociationType ; skos:inScheme lulcw:AssociationTypeScheme ; skos:topConceptOf lulcw:AssociationTypeScheme ;
    skos:prefLabel "over cover"@en , "sur la couverture"@fr ;
    rdfs:label "over cover"@en , "sur la couverture"@fr ;
    skos:definition "Reaches of the zone run on polygons where the unit lies below other mapped units (listed as the cover): any exchange passes through the cover, e.g. leakage from the Quaternary into the Pliocene."@en .
lulcw:DocumentedLateral a lulcw:AssociationType ; skos:inScheme lulcw:AssociationTypeScheme ; skos:topConceptOf lulcw:AssociationTypeScheme ;
    skos:prefLabel "documented lateral"@en , "latéral documenté"@fr ;
    rdfs:label "documented lateral"@en , "latéral documenté"@fr ;
    skos:definition "No reach of the zone runs on or over the unit, but a source documents an exchange between the unit itself and a section that has reaches in the zone (e.g. an alluvial terrace draining laterally to the river). A statement about an aggregate of units (a groundwater body, a group of formations) never makes one: membership does not locate the exchange."@en .

lulcw:ExchangeDirection a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "exchange direction"@en , "sens de l'échange"@fr ;
    skos:definition "Direction of a documented exchange between surface water and a unit, at the state or period the source states; a state, not a timeless property, and not the sign of a head response."@en .
lulcw:ExchangeDirectionScheme a skos:ConceptScheme ;
    rdfs:label "exchange directions"@en , "sens d'échange"@fr ;
    skos:definition "Values of lulcw:ExchangeDirection."@en .
lulcw:AquiferToSurface a lulcw:ExchangeDirection ; skos:inScheme lulcw:ExchangeDirectionScheme ; skos:topConceptOf lulcw:ExchangeDirectionScheme ;
    skos:prefLabel "from the aquifer to surface water"@en , "de la nappe vers les eaux de surface"@fr ;
    rdfs:label "from the aquifer to surface water"@en , "de la nappe vers les eaux de surface"@fr ;
    skos:definition "The surface water gains from the unit: a draining (gaining) river, 'drainant' in the groundwater-body sheets."@en .
lulcw:SurfaceToAquifer a lulcw:ExchangeDirection ; skos:inScheme lulcw:ExchangeDirectionScheme ; skos:topConceptOf lulcw:ExchangeDirectionScheme ;
    skos:prefLabel "from surface water to the aquifer"@en , "des eaux de surface vers la nappe"@fr ;
    rdfs:label "from surface water to the aquifer"@en , "des eaux de surface vers la nappe"@fr ;
    skos:definition "The unit gains from the surface water: a losing river ('perdant'), canal seepage or irrigation return flow."@en .
lulcw:ExchangeEquilibrium a lulcw:ExchangeDirection ; skos:inScheme lulcw:ExchangeDirectionScheme ; skos:topConceptOf lulcw:ExchangeDirectionScheme ;
    skos:prefLabel "in equilibrium"@en , "en équilibre"@fr ;
    rdfs:label "in equilibrium"@en , "en équilibre"@fr ;
    skos:definition "River and unit are connected and their exchange is balanced at the stated scale ('en équilibre')."@en .
lulcw:NoExchange a lulcw:ExchangeDirection ; skos:inScheme lulcw:ExchangeDirectionScheme ; skos:topConceptOf lulcw:ExchangeDirectionScheme ;
    skos:prefLabel "no exchange"@en , "pas d'échange"@fr ;
    rdfs:label "no exchange"@en , "pas d'échange"@fr ;
    skos:definition "The source states that the surface water is independent of the unit, or that the unit does not seem influenced by it."@en .
lulcw:NotQualified a lulcw:ExchangeDirection ; skos:inScheme lulcw:ExchangeDirectionScheme ; skos:topConceptOf lulcw:ExchangeDirectionScheme ;
    skos:prefLabel "not qualified"@en , "non qualifié"@fr ;
    rdfs:label "not qualified"@en , "non qualifié"@fr ;
    skos:definition "The source names the section but gives no information on the exchange ('pas d'information / non qualifiable')."@en .

lulcw:Hedging a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "hedging"@en , "modalité"@fr ;
    skos:definition "Whether a source states a finding or hedges it (conditional mood, 'could', 'seems', reported speech)."@en .
lulcw:HedgingScheme a skos:ConceptScheme ;
    rdfs:label "hedging levels"@en , "modalités"@fr ;
    skos:definition "Values of lulcw:Hedging."@en .
lulcw:StatedFinding a lulcw:Hedging ; skos:inScheme lulcw:HedgingScheme ; skos:topConceptOf lulcw:HedgingScheme ;
    skos:prefLabel "stated"@en , "affirmé"@fr ;
    rdfs:label "stated"@en , "affirmé"@fr ;
    skos:definition "The source states the finding without qualification."@en .
lulcw:HedgedFinding a lulcw:Hedging ; skos:inScheme lulcw:HedgingScheme ; skos:topConceptOf lulcw:HedgingScheme ;
    skos:prefLabel "hedged"@en , "conditionnel"@fr ;
    rdfs:label "hedged"@en , "conditionnel"@fr ;
    skos:definition "The source hedges the finding (conditional, 'could', 'seems') or reports another study's result."@en .

lulcw:EvidenceMethod a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "evidence method"@en , "méthode de la preuve"@fr ;
    skos:definition "How the finding behind an exchange statement was obtained, as far as its source says. Separate from the hedging (how assertively the source words it) and from any confidence: assertive wording is not evidence calibration."@en .
lulcw:EvidenceMethodScheme a skos:ConceptScheme ;
    rdfs:label "evidence methods"@en , "méthodes de preuve"@fr ;
    skos:definition "Values of lulcw:EvidenceMethod."@en .
lulcw:DifferentialGauging a lulcw:EvidenceMethod ; skos:inScheme lulcw:EvidenceMethodScheme ; skos:topConceptOf lulcw:EvidenceMethodScheme ;
    skos:prefLabel "differential gauging"@en , "jaugeages différentiels"@fr ;
    rdfs:label "differential gauging"@en , "jaugeages différentiels"@fr ;
    skos:definition "Discharge measured at successive points of a river or canal and differenced: the exchange is the measured gain or loss between them (a canal's loss also includes the water it delivers to parcels and secondary networks)."@en .
lulcw:GeochemicalTracing a lulcw:EvidenceMethod ; skos:inScheme lulcw:EvidenceMethodScheme ; skos:topConceptOf lulcw:EvidenceMethodScheme ;
    skos:prefLabel "geochemical tracing"@en , "traçage géochimique"@fr ;
    rdfs:label "geochemical tracing"@en , "traçage géochimique"@fr ;
    skos:definition "Chemical or isotopic signatures of the waters and their mixing proportions between end-members, alone or combined with a measured discharge."@en .
lulcw:WaterBalanceEstimate a lulcw:EvidenceMethod ; skos:inScheme lulcw:EvidenceMethodScheme ; skos:topConceptOf lulcw:EvidenceMethodScheme ;
    skos:prefLabel "water balance"@en , "bilan hydrologique"@fr ;
    rdfs:label "water balance"@en , "bilan hydrologique"@fr ;
    skos:definition "Inferred from a water balance or a volume study (inputs minus outputs), possibly as reported by another document."@en .
lulcw:SynthesisStatement a lulcw:EvidenceMethod ; skos:inScheme lulcw:EvidenceMethodScheme ; skos:topConceptOf lulcw:EvidenceMethodScheme ;
    skos:prefLabel "synthesis"@en , "synthèse"@fr ;
    rdfs:label "synthesis"@en , "synthèse"@fr ;
    skos:definition "A qualification in a synthesis or characterisation document (an agency's groundwater-body sheet, a syndicate's description) that does not state the method behind it."@en .

lulcw:UnitMapping a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "unit mapping"@en , "correspondance d'entité"@fr ;
    skos:definition "How the units a statement is about were identified in the graph's BD LISA release."@en .
lulcw:UnitMappingScheme a skos:ConceptScheme ;
    rdfs:label "unit mappings"@en , "correspondances d'entité"@fr ;
    skos:definition "Values of lulcw:UnitMapping."@en .
lulcw:UnitListedBySource a lulcw:UnitMapping ; skos:inScheme lulcw:UnitMappingScheme ; skos:topConceptOf lulcw:UnitMappingScheme ;
    skos:prefLabel "listed by the source"@en , "listée par la source"@fr ;
    rdfs:label "listed by the source"@en , "listée par la source"@fr ;
    skos:definition "The source itself lists the BD LISA V3 codes (e.g. a groundwater-body sheet lists the units of its body)."@en .
lulcw:UnitMappedByName a lulcw:UnitMapping ; skos:inScheme lulcw:UnitMappingScheme ; skos:topConceptOf lulcw:UnitMappingScheme ;
    skos:prefLabel "mapped by name"@en , "par le nom"@fr ;
    rdfs:label "mapped by name"@en , "par le nom"@fr ;
    skos:definition "The source names the unit in words or with a code absent from the release (e.g. 750PP02), and the graph maps it to BD LISA V3 units by that name; the mapping is a judgement, stated as such."@en .

lulcw:AlongRiverPosition a owl:Class ; rdfs:subClassOf skos:Concept ;
    rdfs:label "position along the river"@en , "position le long du cours d'eau"@fr ;
    skos:definition "Position of a gauge along its watercourse's main stem relative to the reach pieces of a zone."@en .
lulcw:AlongRiverPositionScheme a skos:ConceptScheme ;
    rdfs:label "positions along the river"@en , "positions le long du cours d'eau"@fr ;
    skos:definition "Values of lulcw:AlongRiverPosition."@en .
lulcw:UpstreamOfZone a lulcw:AlongRiverPosition ; skos:inScheme lulcw:AlongRiverPositionScheme ; skos:topConceptOf lulcw:AlongRiverPositionScheme ;
    skos:prefLabel "upstream of the zone"@en , "en amont de la zone"@fr ;
    rdfs:label "upstream of the zone"@en , "en amont de la zone"@fr ;
    skos:definition "The gauge lies on the main stem upstream of every main-stem piece of the zone: withdrawals and inflows in between are not in its record."@en .
lulcw:DownstreamOfZone a lulcw:AlongRiverPosition ; skos:inScheme lulcw:AlongRiverPositionScheme ; skos:topConceptOf lulcw:AlongRiverPositionScheme ;
    skos:prefLabel "downstream of the zone"@en , "en aval de la zone"@fr ;
    rdfs:label "downstream of the zone"@en , "en aval de la zone"@fr ;
    skos:definition "The gauge lies on the main stem downstream of every main-stem piece of the zone: its record also holds what joins or leaves the river in between."@en .
lulcw:AlongZoneStretch a lulcw:AlongRiverPosition ; skos:inScheme lulcw:AlongRiverPositionScheme ; skos:topConceptOf lulcw:AlongRiverPositionScheme ;
    skos:prefLabel "along the zone's stretch"@en , "le long du secteur de la zone"@fr ;
    rdfs:label "along the zone's stretch"@en , "le long du secteur de la zone"@fr ;
    skos:definition "The gauge lies on the main stem between the most upstream and the most downstream main-stem pieces of the zone."@en .
lulcw:OffMainStem a lulcw:AlongRiverPosition ; skos:inScheme lulcw:AlongRiverPositionScheme ; skos:topConceptOf lulcw:AlongRiverPositionScheme ;
    skos:prefLabel "off the main stem"@en , "hors du cours principal"@fr ;
    rdfs:label "off the main stem"@en , "hors du cours principal"@fr ;
    skos:definition "The gauge or the zone's pieces are not on the main stem (more than the snapping tolerance from it): no upstream or downstream relation is stated."@en .

lulcw:reachOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:RiverReach ; rdfs:range lulcw:Watercourse ;
    rdfs:label "reach of"@en , "tronçon de"@fr ;
    skos:definition "The watercourse whose BD Carthage code a river reach carries."@en .
lulcw:pieceOfReach a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ReachPiece ; rdfs:range lulcw:HydrographicReach ;
    rdfs:label "piece of reach"@en , "portion du tronçon"@fr ;
    skos:definition "The hydrographic reach a reach piece is a part of."@en .
lulcw:piecePolygon a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ReachPiece ; rdfs:range lulcw:ElementaryPolygon ;
    rdfs:label "piece polygon"@en , "polygone de la portion"@fr ;
    skos:definition "The elementary polygon a reach piece lies in; absent for a piece outside every polygon of the geological release."@en .
lulcw:inSection a owl:ObjectProperty ;
    rdfs:range lulcw:RiverSection ;
    rdfs:label "in section"@en , "dans le secteur"@fr ;
    skos:definition "A river section that a reach piece or a gauge lies in: at least half of the piece's length (for a gauge, its point) within the matching tolerance of the section's line (src/kg/rivers.py)."@en .
lulcw:sectionOf a owl:ObjectProperty ;
    rdfs:domain lulcw:RiverSection ; rdfs:range lulcw:Watercourse ;
    rdfs:label "section of"@en , "secteur de"@fr ;
    skos:definition "A watercourse a river section is a stretch of (a water body may hold stretches of several)."@en .
lulcw:onWatercourse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:RiverGauge ; rdfs:range lulcw:Watercourse ;
    rdfs:label "on watercourse"@en , "sur le cours d'eau"@fr ;
    skos:definition "The watercourse a gauge measures, by the BD Carthage code Hub'Eau gives it."@en .
lulcw:hasDischargeSeries a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:RiverGauge ; rdfs:range lulcw:ObservationSeries ;
    rdfs:label "has discharge series"@en , "a pour série de débits"@fr ;
    skos:definition "Links a gauge to its weekly discharge series kept outside the graph."@en .
lulcw:relatedGauge a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:GaugeZoneRelation ; rdfs:range lulcw:RiverGauge ;
    rdfs:label "related gauge"@en , "station concernée"@fr ;
    skos:definition "The gauge a gauge-zone relation is about."@en .
lulcw:alongRiverPosition a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:GaugeZoneRelation ; rdfs:range lulcw:AlongRiverPosition ;
    rdfs:label "has position along the river"@en , "a pour position le long du cours d'eau"@fr ;
    skos:definition "Where the gauge lies along the main stem relative to the zone's main-stem pieces."@en .
lulcw:poolMember a owl:ObjectProperty ;
    rdfs:domain lulcw:GaugePool ; rdfs:range lulcw:RiverGauge ;
    rdfs:label "pool member"@en , "station de l'ensemble"@fr ;
    skos:definition "A gauge that belongs to a gauge pool."@en .
lulcw:usesGaugePool a owl:ObjectProperty ;
    rdfs:domain lulcw:DerivationRule ; rdfs:range lulcw:GaugePool ;
    rdfs:label "uses gauge pool"@en , "utilise l'ensemble de stations"@fr ;
    skos:definition "The gauge pool a rule draws the gauges it connects from."@en .
lulcw:inDocument a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:DocumentPassage ; rdfs:range lulcw:Document ;
    rdfs:label "in document"@en , "dans le document"@fr ;
    skos:definition "The document a passage is taken from."@en .
lulcw:statedMechanism a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:Mechanism ;
    rdfs:label "stated mechanism"@en , "mécanisme énoncé"@fr ;
    skos:definition "The mechanism an exchange statement is about (river exchange, canal return flow, vertical leakage)."@en .
lulcw:aboutSection a owl:ObjectProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:RiverSection ;
    rdfs:label "about section"@en , "porte sur le secteur"@fr ;
    skos:definition "The river section an exchange statement is about, when the source delimits it."@en .
lulcw:overlapsSection a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:domain lulcw:RiverSection ; rdfs:range lulcw:RiverSection ;
    rdfs:label "overlaps section"@en , "chevauche le secteur"@fr ;
    skos:definition "Two different sections of the same watercourse whose lines run together over at least 500 metres within the section tolerance (src/kg/rivers.py): statements about them describe, at least in part, the same stretch. Adjacent sections that only meet at a junction do not overlap."@en .
lulcw:aboutWatercourse a owl:ObjectProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:Watercourse ;
    rdfs:label "about watercourse"@en , "porte sur le cours d'eau"@fr ;
    skos:definition "The watercourse an exchange statement is about. Without lulcw:aboutSection, the source does not delimit the stretch, and the statement is listed for the watercourse but never applied to a zone."@en .
lulcw:aboutUnit a owl:ObjectProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "about unit"@en , "porte sur l'entité"@fr ;
    skos:definition "A hydrogeological unit an exchange statement is about itself, as identified by lulcw:unitMapping: the source names this unit (a formation or a code mapped to exactly this unit, or a groundwater body made of this unit alone). A statement about an aggregate of several units uses lulcw:aggregateMemberUnit instead."@en .
lulcw:aggregateMemberUnit a owl:ObjectProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "aggregate member unit"@en , "entité membre de l'agrégat"@fr ;
    skos:definition "A unit that belongs to the aggregate an exchange statement is about (a groundwater body of several units, or a group the source names, such as 'the Quaternary formations'). Membership does not say that this unit takes part in the exchange: the statement is localised to the unit only by a separate, stated inference (lulcw:localizedStatement), never by membership alone."@en .
lulcw:aboutGroundwaterBody a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:GroundwaterBody ;
    rdfs:label "about groundwater body"@en , "porte sur la masse d'eau souterraine"@fr ;
    skos:definition "The WFD groundwater body an exchange statement is about, when the source states the exchange at that scale (e.g. a characterisation sheet's table of river exchanges)."@en .
lulcw:unitMapping a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:UnitMapping ;
    rdfs:label "has unit mapping"@en , "a pour correspondance d'entité"@fr ;
    skos:definition "How the statement's units were identified in the BD LISA release."@en .
lulcw:exchangeDirection a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:ExchangeDirection ;
    rdfs:label "has exchange direction"@en , "a pour sens d'échange"@fr ;
    skos:definition "The direction the statement gives, at its state or period."@en .
lulcw:hedging a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:Hedging ;
    rdfs:label "has hedging"@en , "a pour modalité"@fr ;
    skos:definition "Whether the source states or hedges the finding."@en .
lulcw:evidenceMethod a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range lulcw:EvidenceMethod ;
    rdfs:label "has evidence method"@en , "a pour méthode de preuve"@fr ;
    skos:definition "How the source obtained the finding (differential gauging, geochemical tracing, water balance, or a synthesis that does not say)."@en .
lulcw:associationType a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:RiverUnitAssociation ; rdfs:range lulcw:AssociationType ;
    rdfs:label "has association type"@en , "a pour type d'association"@fr ;
    skos:definition "How the watercourse relates to the unit in the zone."@en .
lulcw:associationWatercourse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:RiverUnitAssociation ; rdfs:range lulcw:Watercourse ;
    rdfs:label "associated watercourse"@en , "cours d'eau associé"@fr ;
    skos:definition "The watercourse of a river-unit association."@en .
lulcw:associationUnit a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "associated unit"@en , "entité associée"@fr ;
    skos:definition "The unit (the one the well is attributed to) of a river-unit or canal-unit association."@en .
lulcw:coverUnit a owl:ObjectProperty ;
    rdfs:domain lulcw:RiverUnitAssociation ; rdfs:range lulcw:HydrogeologicalUnit ;
    rdfs:label "cover unit"@en , "entité de couverture"@fr ;
    skos:definition "A unit mapped above the associated unit under the reaches of an over-cover association: exchange with the river passes through it."@en .
lulcw:applicableStatement a owl:ObjectProperty ;
    rdfs:range lulcw:ExchangeStatement ;
    rdfs:label "applicable statement"@en , "énoncé applicable"@fr ;
    skos:definition "An exchange statement about the association's unit itself (lulcw:aboutUnit) and about a section that holds reach pieces of the association's zone and watercourse (for a canal-unit association: a canal-return statement naming the unit). A statement measured at a site (lulcw:measuredAt) applies only to the associations of that site's zone. Statements about an aggregate are never applicable; see lulcw:localizedStatement."@en .
lulcw:localizedStatement a owl:ObjectProperty ;
    rdfs:range lulcw:ExchangeStatement ;
    rdfs:label "localised aggregate statement"@en , "énoncé d'agrégat localisé"@fr ;
    skos:definition "Derived by a rule: a statement about an aggregate that the association's unit belongs to (lulcw:aggregateMemberUnit), localised to the unit because the association's river reaches (about a section that holds pieces of them in the zone) or canal reaches run on the unit's outcrop, where the unit is the member in contact with the surface water. A separate inference from lulcw:applicableStatement: it documents the exchange at the aggregate's scale and makes no response sign eligible until the localisation is reviewed (Gate 3)."@en .
lulcw:candidateWatercourse a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:SurfaceWaterIntake ; rdfs:range lulcw:Watercourse ;
    rdfs:label "candidate watercourse"@en , "cours d'eau candidat"@fr ;
    skos:definition "The watercourse nearest to an intake's declared position within the matching tolerance: the river it probably draws from, a geometric candidate, not a declared source."@en .
lulcw:measuredAt a owl:ObjectProperty ;
    rdfs:domain lulcw:ExchangeStatement ; rdfs:range geo:Feature ;
    rdfs:label "measured at"@en , "mesuré au point"@fr ;
    skos:definition "The site (e.g. a piezometer) where the measurement behind an exchange statement was made, when the source names one. The statement is evidence at that site: it applies only to the associations of the site's own zone, and another well of the same unit does not inherit it."@en .
lulcw:intakeMember a owl:ObjectProperty ;
    rdfs:domain lulcw:CanalIntakeGroup ; rdfs:range lulcw:SurfaceWaterIntake ;
    rdfs:label "intake member"@en , "prise membre"@fr ;
    skos:definition "An intake whose declared volume is part of a canal intake group's series."@en .
lulcw:hasVolumeSeries a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain lulcw:CanalIntakeGroup ; rdfs:range lulcw:ObservationSeries ;
    rdfs:label "has volume series"@en , "a pour série de volumes"@fr ;
    skos:definition "Links a canal intake group to its weekly volume series kept outside the graph."@en .

lulcw:bdCarthageCode a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:label "BD Carthage code"@en , "code BD Carthage"@fr ;
    skos:definition "The Sandre generic code of a watercourse (BD Carthage), e.g. Y04-0400."@en .
lulcw:bdtopoId a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:label "BD TOPO identifier"@en , "identifiant BD TOPO"@fr ;
    skos:definition "The BD TOPO identifier (cleabs) of a hydrographic reach."@en .
lulcw:reachNature a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:HydrographicReach ; rdfs:range xsd:string ;
    rdfs:label "reach nature"@en , "nature du tronçon"@fr ;
    skos:definition "The BD TOPO nature of a reach, as recorded (e.g. 'Ecoulement naturel', 'Canal', 'Retenue-barrage')."@en .
lulcw:onMainNetwork a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:HydrographicReach ; rdfs:range xsd:boolean ;
    rdfs:label "on main flowing network"@en , "sur le réseau principal coulant"@fr ;
    skos:definition "BD TOPO's flag reseau_principal_coulant: the reach belongs to the main flowing network."@en .
lulcw:onMainStem a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:RiverReach ; rdfs:range xsd:boolean ;
    rdfs:label "on main stem"@en , "sur le cours principal"@fr ;
    skos:definition "The reach belongs to the main stem computed for its watercourse (src/kg/rivers.py): the longest path of the watercourse's flow network, main-network reaches first."@en .
lulcw:persistence a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:HydrographicReach ; rdfs:range xsd:string ;
    rdfs:label "persistence"@en , "persistance"@fr ;
    skos:definition "BD TOPO's persistence of the flow in a reach, as recorded (e.g. 'Permanent', 'Intermittent')."@en .
lulcw:chainageFromM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "chainage from (m)"@en , "abscisse de début (m)"@fr ;
    skos:definition "Distance in metres along the watercourse's main stem, from its upstream end, of the upstream end of a main-stem reach or of a river section."@en .
lulcw:chainageToM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "chainage to (m)"@en , "abscisse de fin (m)"@fr ;
    skos:definition "Distance in metres along the watercourse's main stem, from its upstream end, of the downstream end of a main-stem reach or of a river section."@en .
lulcw:chainageM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "chainage (m)"@en , "abscisse (m)"@fr ;
    skos:definition "Distance in metres along the watercourse's main stem, from its upstream end, of the point of the stem nearest to a gauge."@en .
lulcw:offsetFromStemM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "offset from the main stem (m)"@en , "distance au cours principal (m)"@fr ;
    skos:definition "Horizontal distance in metres from a gauge to its watercourse's main stem."@en .
lulcw:mainStemLengthM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:Watercourse ; rdfs:range xsd:double ;
    rdfs:label "main stem length (m)"@en , "longueur du cours principal (m)"@fr ;
    skos:definition "Length in metres of the computed main stem of a watercourse inside the département box of the BD TOPO extract."@en .
lulcw:pieceLengthM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:ReachPiece ; rdfs:range xsd:double ;
    rdfs:label "piece length (m)"@en , "longueur de la portion (m)"@fr ;
    skos:definition "Length in metres of a reach piece (Lambert-93)."@en .
lulcw:wfdCode a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:SurfaceWaterBody ; rdfs:range xsd:string ;
    rdfs:label "WFD water-body code"@en , "code européen de masse d'eau"@fr ;
    skos:definition "European code of a WFD water body (CdEuMasseDEau), e.g. FRDR224."@en .
lulcw:gaugeCode a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:RiverGauge ; rdfs:range xsd:string ;
    rdfs:label "gauge code"@en , "code de la station"@fr ;
    skos:definition "Hub'Eau hydrometric station code (code_station), e.g. Y047403001."@en .
lulcw:localInfluenceCode a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:RiverGauge ; rdfs:range xsd:integer ;
    rdfs:label "local influence code"@en , "code d'influence locale"@fr ;
    skos:definition "The Hub'Eau code for how strongly local works and withdrawals influence the flow at the station (influence_locale_station), as recorded; its labels are the producer's, and a missing code stays missing."@en .
lulcw:localInfluenceComment a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:RiverGauge ; rdfs:range xsd:string ;
    rdfs:label "local influence comment"@en , "commentaire sur l'influence locale"@fr ;
    skos:definition "The producer's comment on the local influences at a station, as recorded (e.g. dam releases and canal withdrawals upstream)."@en .
lulcw:observedTrainingWeeks a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:ObservationSeries ; rdfs:range xsd:integer ;
    rdfs:label "observed training weeks"@en , "semaines observées de l'apprentissage"@fr ;
    skos:definition "Number of weeks of the training period (2005 to 2019) with an observed value in a series; the model inputs fill the others outside the graph."@en .
lulcw:trainingWeeks a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:ObservationSeries ; rdfs:range xsd:integer ;
    rdfs:label "training weeks"@en , "semaines de l'apprentissage"@fr ;
    skos:definition "Number of weeks of the training period (2005 to 2019) in the dataset's weekly calendar, the denominator of lulcw:observedTrainingWeeks."@en .
lulcw:alongRiverDistanceM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:GaugeZoneRelation ; rdfs:range xsd:double ;
    rdfs:label "distance along the river (m)"@en , "distance le long du cours d'eau (m)"@fr ;
    skos:definition "Distance in metres along the main stem from a gauge to the nearest main-stem piece of the zone (0 when the gauge lies along the zone's stretch)."@en .
lulcw:sourceUrl a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:anyURI ;
    rdfs:label "source URL"@en , "URL de la source"@fr ;
    skos:definition "The address a document or release was retrieved from."@en .
lulcw:md5 a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:string ;
    rdfs:label "MD5 checksum"@en , "somme MD5"@fr ;
    skos:definition "MD5 checksum of the local copy of a document, in hexadecimal."@en .
lulcw:pageLabel a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:DocumentPassage ; rdfs:range xsd:string ;
    rdfs:label "page"@en , "page"@fr ;
    skos:definition "The printed page (or sheet page) of a passage, as the document numbers it."@en .
lulcw:quote a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:DocumentPassage ; rdfs:range xsd:string ;
    rdfs:label "quote"@en , "citation"@fr ;
    skos:definition "A short verbatim quote of the passage, in the document's language."@en .
lulcw:unitAsNamed a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:ExchangeStatement ; rdfs:range xsd:string ;
    rdfs:label "unit as named"@en , "entité telle que nommée"@fr ;
    skos:definition "How the source names the unit or groundwater body the statement is about, verbatim."@en .
lulcw:stateDescription a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:ExchangeStatement ; rdfs:range xsd:string ;
    rdfs:label "state described"@en , "état décrit"@fr ;
    skos:definition "The hydrological state or scale the statement holds for, in words (e.g. 'low flow, at the scale of the water body'; 'irrigation season, 11-13 September 2017')."@en .
lulcw:periodStart a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:date ;
    rdfs:label "period start"@en , "début de la période"@fr ;
    skos:definition "First day of the period a dated statement observed (an xsd:date literal); absent for a statement about a typical state."@en .
lulcw:periodEnd a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:date ;
    rdfs:label "period end"@en , "fin de la période"@fr ;
    skos:definition "Last day of the period a dated statement observed (an xsd:date literal)."@en .
lulcw:fluxM3s a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:ExchangeStatement ; rdfs:range xsd:double ;
    rdfs:label "flux (m³/s)"@en , "flux (m³/s)"@fr ;
    skos:definition "The exchange flux the statement gives, in cubic metres per second, positive in the stated direction."@en .
lulcw:fluxUncertaintyM3s a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:ExchangeStatement ; rdfs:range xsd:double ;
    rdfs:label "flux uncertainty (m³/s)"@en , "incertitude du flux (m³/s)"@fr ;
    skos:definition "The plus-or-minus uncertainty the source gives for the flux, in cubic metres per second."@en .
lulcw:lengthOnOutcropM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:range xsd:double ;
    rdfs:label "length on outcrop (m)"@en , "longueur sur l'affleurement (m)"@fr ;
    skos:definition "Total length in metres of the association's reach pieces that run on polygons where its unit is at outcrop."@en .
lulcw:lengthOverCoverM a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:domain lulcw:RiverUnitAssociation ; rdfs:range xsd:double ;
    rdfs:label "length over cover (m)"@en , "longueur sur la couverture (m)"@fr ;
    skos:definition "Total length in metres of the association's reach pieces that run on polygons where its unit lies below other units."@en .
