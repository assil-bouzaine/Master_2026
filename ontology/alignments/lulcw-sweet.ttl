@prefix lulcw:   <https://w3id.org/lulcw#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sohydro: <http://sweetontology.net/realmHydro/> .
@prefix sohydrobody: <http://sweetontology.net/realmHydroBody/> .
@prefix sophenhydro: <http://sweetontology.net/phenHydro/> .
@prefix sohumanagri: <http://sweetontology.net/humanAgriculture/> .

# Alignment of the lulcw module to SWEET (ESIP, CC0), the ontology the subject names. Only SKOS
# mapping relations (close and broad matches): SWEET's classes are broader, differently axiomatised and
# carry no textual definitions, so no subclass or equivalence is asserted. SWEET's ConfinedAquifer and
# UnconfinedAquifer are deliberately not matched to unit types: confinement is a local assessment (CQ14),
# not a property of a unit. Version 0.2.0 (2026-11-26, v5 plan R2.3) adds the deeper modules: rivers and
# canals (realmHydroBody), recharge, discharge and percolation (phenHydro), irrigation (humanAgriculture).

<https://w3id.org/lulcw/alignments/sweet> a owl:Ontology ;
    owl:versionIRI <https://w3id.org/lulcw/alignments/sweet/0.2.0> ;
    dcterms:title "Alignment of LULC-Water to SWEET"@en , "Alignement de LULC-Water sur SWEET"@fr ;
    dcterms:description "SKOS mapping axioms linking lulcw unit types, watercourses, canal reaches, recharge, discharge, soil drainage and irrigation to SWEET classes; no subclass or equivalence is asserted."@en ;
    dcterms:created "2026-10-24"^^xsd:date ;
    dcterms:modified "2026-11-26"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:imports <https://w3id.org/lulcw> , <https://w3id.org/lulcw/imports/sweet> .

lulcw:AlluvialAquifer skos:closeMatch sohydro:Aquifer .
lulcw:KarstAquifer skos:closeMatch sohydro:Aquifer .
lulcw:MultilayerAquiferSystem skos:closeMatch sohydro:Aquifer .
lulcw:ConfiningUnit skos:closeMatch sohydro:Aquitard .
lulcw:Watercourse skos:closeMatch sohydrobody:River .
lulcw:CanalReach skos:closeMatch sohydrobody:Canal .
lulcw:GroundwaterRecharge skos:closeMatch sophenhydro:Recharge .
lulcw:DiffuseRecharge skos:broadMatch sophenhydro:Recharge .
lulcw:RiverDischarge skos:closeMatch sophenhydro:StreamDischarge .
lulcw:SoilDrainage skos:closeMatch sophenhydro:DeepPercolation .
lulcw:IrrigationUse skos:closeMatch sohumanagri:Irrigation .

dcterms:title a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:modified a owl:AnnotationProperty .
dcterms:license a owl:AnnotationProperty .
