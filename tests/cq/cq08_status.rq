# CQ8 · Answer status for the influences on a well (common answer contract,
# docs/competency_questions.md §2)
#
# Parameters  ?W  any IRI
# Reads       asserted facts and the SHACL-AF rule outputs
# Returns     one row: ?status not_applicable (?W is not a piezometer), unknown (no unit is
#             attributed to ?W, so no pathway through a unit can be stated), partial (the graph
#             derives pumping-drawdown pathways only: rain recharge, canal return flow and river
#             exchange are not yet lulcw:Influence records, so their absence says nothing);
#             ?drivers lists the mechanisms present for ?W; ?reason in words.
PREFIX lulcw: <https://w3id.org/lulcw#>
SELECT ?W (GROUP_CONCAT(DISTINCT STRAFTER(STR(?mech), "#"); separator=" ") AS ?drivers)
       (IF(!?isWell, "not_applicable", IF(!?hasUnit, "unknown", "partial")) AS ?status)
       (IF(!?isWell, "not a piezometer of the graph",
         IF(!?hasUnit, "no unit is attributed to the well, so no pathway through a unit can be stated",
            "pumping-drawdown pathways only: rain recharge, canal return flow and river exchange are not yet derived, so their absence says nothing")) AS ?reason)
WHERE {
    OPTIONAL { ?i a lulcw:Influence ; lulcw:targetEntity ?W ; lulcw:mechanism ?mech . }
    BIND (EXISTS { ?W a lulcw:Piezometer } AS ?isWell)
    BIND (EXISTS { ?m lulcw:attributedEntity ?W ; lulcw:role lulcw:MonitoringRole ;
                      lulcw:candidateUnit ?u . } AS ?hasUnit)
}
GROUP BY ?W ?isWell ?hasUnit
