@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gwml2:   <http://gwml2.org/def/gwml2#> .
@prefix hyfo:    <http://hyfo.spatialai.org/v1/hyfo#> .

# Local copy of the GWML2 and HyFO terms that LULC-Water reuses, in the OWL rendering of
# SAWGraph's hydrology (water) ontology v1.0 (http://purl.org/spatialai/spatial/water-full).
# GWML2 has no official OWL (OGC 16-032r2 is UML + GML/XML; Brodaric et al. 2018,
# doi:10.1007/s10040-018-1747-9). SAWGraph publishes no Turtle file (its URL returned 404 on
# 2026-10-23) and states no licence, so the terms are copied by hand, with attribution, from
# its documentation page, read on 2026-10-24: IRIs, labels, definitions, subclass axioms,
# domains and ranges exactly as listed there (MIREOT-style extract, CLAUDE.md rule 12).

<https://w3id.org/lulcw/imports/gwml2-hyfo> a owl:Ontology ;
    dcterms:title "GWML2 and HyFO terms reused by LULC-Water"@en ;
    dcterms:source <https://ontologies.geoconnex.us/sawgraph-water-ontology> ;
    dcterms:created "2026-10-24"^^xsd:date ;
    rdfs:comment "Copied from the SAWGraph documentation page on 2026-10-24. GWML2 terms are defined by OGC 19-013 (https://docs.ogc.org/is/19-013/19-013.html); HyFO terms by doi:10.1080/13658816.2018.1443751."@en .

dcterms:title a owl:AnnotationProperty .
dcterms:source a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .

hyfo:WaterFeature a owl:Class ;
    rdfs:subClassOf geo:Feature ;
    rdfs:label "water feature"@en ;
    skos:definition "A complete water feature including water, container, and void; includes surface and subsurface water features"@en ;
    rdfs:isDefinedBy <https://doi.org/10.1080/13658816.2018.1443751> .

hyfo:SubsurfaceWaterFeature a owl:Class ;
    rdfs:subClassOf hyfo:WaterFeature ;
    rdfs:label "subsurface water feature"@en ;
    skos:definition "A complete subsurface water feature including water, container, and void (for example, aquifer, well, et al.)"@en ;
    rdfs:isDefinedBy <https://doi.org/10.1080/13658816.2018.1443751> .

hyfo:AquiferWaterFeature a owl:Class ;
    rdfs:subClassOf hyfo:SubsurfaceWaterFeature ;
    rdfs:label "aquifer water feature"@en ;
    skos:definition "An aquifer water feature including water, container, and void"@en ;
    rdfs:isDefinedBy <https://doi.org/10.1080/13658816.2018.1443751> .

hyfo:WaterWell a owl:Class ;
    rdfs:subClassOf hyfo:SubsurfaceWaterFeature ;
    rdfs:label "water well"@en ;
    skos:definition "A water well, with focus on the hole/shaft itself (see gwml2:GW_Well)"@en ;
    rdfs:isDefinedBy <https://doi.org/10.1080/13658816.2018.1443751> .

hyfo:tapsAquifer a owl:ObjectProperty ;
    rdfs:label "taps aquifer"@en ;
    skos:definition "Identifies the aquifer a well taps"@en ;
    rdfs:isDefinedBy <https://doi.org/10.1080/13658816.2018.1443751> .

gwml2:GW_Well a owl:Class ;
    rdfs:subClassOf hyfo:SubsurfaceWaterFeature ;
    rdfs:label "GW_Well"@en ;
    skos:definition "A shaft or hole sunk, dug or drilled into the Earth to observe, extract or inject water (after IGH1397)"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

gwml2:GW_MonitoringSite a owl:Class ;
    rdfs:label "GW_MonitoringSite"@en ;
    skos:definition "Site of observation related to groundwater"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

gwml2:GW_HydrogeoUnit a owl:Class ;
    rdfs:label "GW_HydrogeoUnit"@en ;
    skos:definition "Any soil or rock unit or zone that by virtue of its hydraulic properties has a distinct influence on the storage or movement of groundwater (after ANS, 1980)"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

gwml2:GW_AquiferUnit a owl:Class ;
    rdfs:subClassOf gwml2:GW_HydrogeoUnit , hyfo:AquiferWaterFeature ;
    rdfs:label "GW_AquiferUnit"@en ;
    skos:definition "Denotes aquifer-related hydrogeological units: aquifer systems, aquifers, or confining beds"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

gwml2:GW_Aquifer a owl:Class ;
    rdfs:subClassOf gwml2:GW_AquiferUnit ;
    rdfs:label "GW_Aquifer"@en ;
    skos:definition "A body of earth material that contains / potentially contains / potentially contained sufficient saturated permeable material to yield significant quantities of water to wells and springs (after Lohman, 1972)"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

gwml2:GW_AquiferSystem a owl:Class ;
    rdfs:subClassOf gwml2:GW_AquiferUnit ;
    rdfs:label "GW_AquiferSystem"@en ;
    skos:definition "A body of permeable and poorly permeable material that functions regionally as a water-yielding unit; it comprises two or more permeable beds separated at least locally by confining beds that impede groundwater movement but do not greatly affect the regional hydraulic continuity of the system; includes both saturated and unsaturated parts of permeable material (after ASCE, 1987)"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

gwml2:gwWellUnit a owl:ObjectProperty ;
    rdfs:domain gwml2:GW_Well ;
    rdfs:range gwml2:GW_AquiferUnit ;
    rdfs:label "gwWellUnit"@en ;
    skos:definition "Identifies the aquifers or confining beds intersecting the well"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

gwml2:gwMonitoringHost a owl:ObjectProperty ;
    rdfs:domain gwml2:GW_MonitoringSite ;
    rdfs:range hyfo:WaterFeature ;
    rdfs:label "gwMonitoringHost"@en ;
    skos:definition "Identifies the feature hosting the site [GW_MonitoringSite], e.g., a well, spring, lake or stream"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

gwml2:gwAquiferSystemPart a owl:ObjectProperty ;
    rdfs:label "gwAquiferSystemPart"@en ;
    skos:definition "Relates an aquifer system with its parts, which can be other systems, aquifers or confining beds"@en ;
    rdfs:isDefinedBy <https://docs.ogc.org/is/19-013/19-013.html> .

geo:Feature a owl:Class .
