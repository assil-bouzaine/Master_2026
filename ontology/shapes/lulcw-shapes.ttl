@prefix lulcw:   <https://w3id.org/lulcw#> .
@prefix lulcwsh: <https://w3id.org/lulcw/shapes#> .
@prefix sh:      <http://www.w3.org/ns/shacl#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix geo:     <http://www.opengis.net/ont/geosparql#> .
@prefix sosa:    <http://www.w3.org/ns/sosa/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .

# SHACL shapes of the LULC-Water knowledge graph (task 12.6; docs/ontology_design.md §5, gate 4).
# Validated by src/kg/apply_rules.py on the facts (src/kg/build_kg.py) plus the outputs of the
# SHACL-AF rules (ontology/rules/lulcw-rules.ttl), with the ontology network mixed in so that
# sh:class follows rdfs:subClassOf. Violations fail the gate; warnings and infos are reported.
# Incomplete evidence stays incomplete: several candidates are allowed, an explicit unknown is
# allowed, a missing depth is reported (sh:Info), never forced to one answer.
# The "French and English labels and a definition for every term" gate is checked on the TBox
# by tests/test_ontology.py (gate 3).

<https://w3id.org/lulcw/shapes> a owl:Ontology ;
    dcterms:title "LULC-Water SHACL shapes"@en , "Formes SHACL LULC-Water"@fr ;
    dcterms:description "SHACL shapes that validate the facts and the derived links of the LULC-Water knowledge graph: qualified unit attributions, stratigraphic relations with their witnesses, well links, influences, policy selections and annual abstraction records."@en ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-10-25"^^xsd:date ;
    sh:declare
        [ sh:prefix "lulcw" ; sh:namespace "https://w3id.org/lulcw#"^^xsd:anyURI ] ,
        [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
        [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
        [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] ,
        [ sh:prefix "sosa" ; sh:namespace "http://www.w3.org/ns/sosa/"^^xsd:anyURI ] ,
        [ sh:prefix "time" ; sh:namespace "http://www.w3.org/2006/time#"^^xsd:anyURI ] ,
        [ sh:prefix "geo" ; sh:namespace "http://www.opengis.net/ont/geosparql#"^^xsd:anyURI ] .

#################################################################
# Wells and facilities: identity, and at least one attribution (CQ1, CQ2)
#################################################################

lulcwsh:PiezometerShape a sh:NodeShape ;
    sh:targetClass lulcw:Piezometer ;
    sh:property [ sh:path lulcw:bssCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ,
        [ sh:path geo:hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ] ,
        [ sh:path [ sh:inversePath lulcw:hostedBy ] ; sh:minCount 1 ;
          sh:message "a piezometer hosts its monitoring station" ] ,
        [ sh:path lulcw:investigationDepthM ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minInclusive 0 ] ,
        [ sh:path [ sh:inversePath lulcw:attributedEntity ] ;
          sh:qualifiedValueShape [ sh:path lulcw:role ; sh:hasValue lulcw:MonitoringRole ] ;
          sh:qualifiedMinCount 1 ;
          sh:message "every piezometer has at least one monitoring attribution (an explicit unknown is allowed)" ] .

lulcwsh:MissingDepthShape a sh:NodeShape ;
    sh:targetClass lulcw:Piezometer ;
    sh:property [ sh:path lulcw:investigationDepthM ; sh:minCount 1 ; sh:severity sh:Info ;
        sh:message "investigation depth missing: reported; the well stays in the graph and in distance-only policies" ] .

lulcwsh:FacilityShape a sh:NodeShape ;
    sh:targetClass lulcw:AbstractionFacility ;
    sh:property [ sh:path lulcw:bnpeCode ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:waterSource ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path geo:hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:hasIntake ; sh:minCount 1 ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ] ,
        [ sh:path [ sh:inversePath lulcw:attributedEntity ] ;
          sh:qualifiedValueShape [ sh:path lulcw:role ; sh:hasValue lulcw:AbstractionRole ] ;
          sh:qualifiedMinCount 1 ;
          sh:message "every groundwater facility has at least one abstraction attribution (an explicit unknown is allowed)" ] .

#################################################################
# Unit attributions (docs/ontology_design.md §4.3)
#################################################################

lulcwsh:UnitAttributionShape a sh:NodeShape ;
    sh:targetClass lulcw:UnitAttribution ;
    sh:property [ sh:path lulcw:attributedEntity ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:role ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:in ( lulcw:MonitoringRole lulcw:AbstractionRole ) ] ,
        [ sh:path lulcw:assessmentStatus ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:AssessmentStatus ] ,
        [ sh:path lulcw:evidenceKind ; sh:minCount 1 ; sh:class lulcw:EvidenceKind ] ,
        [ sh:path lulcw:derivationRule ; sh:minCount 1 ; sh:class lulcw:DerivationRule ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ] ,
        [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:rank ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
          sh:minInclusive 1 ] ;
    sh:xone ( lulcwsh:ResolvedAttribution lulcwsh:UnknownAttribution ) ;
    sh:sparql [
        sh:message "the target and the resolution disagree: a unit target is resolved at the exact unit, a group target at the unit group" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    { $this lulcw:candidateUnit ?t . FILTER NOT EXISTS { $this lulcw:resolution lulcw:ExactUnitResolution } }
    UNION
    { $this lulcw:candidateGroup ?t . FILTER NOT EXISTS { $this lulcw:resolution lulcw:UnitGroupResolution } }
}""" ] , [
        sh:message "the role and the entity disagree: monitoring attributions are about piezometers, abstraction attributions about facilities" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:attributedEntity ?value .
    { $this lulcw:role lulcw:MonitoringRole . FILTER NOT EXISTS { ?value a lulcw:Piezometer } }
    UNION
    { $this lulcw:role lulcw:AbstractionRole . FILTER NOT EXISTS { ?value a lulcw:AbstractionFacility } }
}""" ] , [
        sh:message "selected by a policy that does not admit its confidence level" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:selectedUnder ?value .
    FILTER NOT EXISTS { $this lulcw:confidence ?c . ?value lulcw:admitsConfidence ?c . }
}""" ] .

lulcwsh:ResolvedAttribution a sh:NodeShape ;
    rdfs:comment "A candidate with a target: exactly one unit or one group, a confidence level and a resolution, and no reason for unknown."@en ;
    sh:xone ( [ sh:path lulcw:candidateUnit ; sh:minCount 1 ]
              [ sh:path lulcw:candidateGroup ; sh:minCount 1 ] ) ;
    sh:property [ sh:path lulcw:candidateUnit ; sh:maxCount 1 ; sh:class lulcw:HydrogeologicalUnit ] ,
        [ sh:path lulcw:candidateGroup ; sh:maxCount 1 ; sh:class lulcw:HydrogeologicalUnitGroup ] ,
        [ sh:path lulcw:confidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:ConfidenceLevel ] ,
        [ sh:path lulcw:resolution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:Resolution ] ,
        [ sh:path lulcw:unknownReason ; sh:maxCount 0 ] .

lulcwsh:UnknownAttribution a sh:NodeShape ;
    rdfs:comment "An explicit unknown: a stated reason, and no target, confidence or resolution (no fictional unit)."@en ;
    sh:property [ sh:path lulcw:unknownReason ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:candidateUnit ; sh:maxCount 0 ] ,
        [ sh:path lulcw:candidateGroup ; sh:maxCount 0 ] ,
        [ sh:path lulcw:confidence ; sh:maxCount 0 ] ,
        [ sh:path lulcw:resolution ; sh:maxCount 0 ] .

# One main candidate per entity, role and resolution (a candidate stated at two resolutions
# keeps one rank: docs/ontology_design.md §8); an explicit unknown main candidate excludes a
# resolved one for the same role.
lulcwsh:MainCandidateShape a sh:NodeShape ;
    sh:targetClass lulcw:Piezometer , lulcw:AbstractionFacility ;
    sh:sparql [
        sh:message "more than one rank-1 attribution for the same role and resolution" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?role ?res WHERE {
    ?a lulcw:attributedEntity $this ; lulcw:rank 1 ; lulcw:role ?role ; lulcw:resolution ?res .
    ?b lulcw:attributedEntity $this ; lulcw:rank 1 ; lulcw:role ?role ; lulcw:resolution ?res .
    FILTER (?a != ?b)
}""" ] , [
        sh:message "an explicit unknown rank-1 attribution next to another rank-1 attribution for the same role" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?role WHERE {
    ?u lulcw:attributedEntity $this ; lulcw:rank 1 ; lulcw:role ?role ; lulcw:unknownReason ?why .
    ?a lulcw:attributedEntity $this ; lulcw:rank 1 ; lulcw:role ?role .
    FILTER (?a != ?u)
}""" ] .

#################################################################
# Stratigraphic relations and `overlies` (CQ3)
#################################################################

lulcwsh:StratigraphicRelationShape a sh:NodeShape ;
    sh:targetClass lulcw:StratigraphicRelation ;
    sh:property [ sh:path lulcw:upperUnit ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:HydrogeologicalUnit ; sh:disjoint lulcw:lowerUnit ] ,
        [ sh:path lulcw:lowerUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:HydrogeologicalUnit ] ,
        [ sh:path lulcw:relationKind ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:in ( lulcw:DirectContact lulcw:IndirectOrdering ) ] ,
        [ sh:path lulcw:witnessedBy ; sh:minCount 1 ; sh:class lulcw:ElementaryPolygon ] ,
        [ sh:path lulcw:interveningUnit ; sh:class lulcw:HydrogeologicalUnit ] ,
        [ sh:path lulcw:derivationRule ; sh:minCount 1 ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 2 ] ,
        [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:message "a witness polygon's stack does not show the upper unit above the lower one: an ordering is never chained across polygons" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:witnessedBy ?value ; lulcw:upperUnit ?u1 ; lulcw:lowerUnit ?u2 .
    FILTER NOT EXISTS {
        ?value lulcw:hasStackLayer ?l1 , ?l2 .
        ?l1 lulcw:layerUnit ?u1 ; lulcw:layerOrder ?o1 .
        ?l2 lulcw:layerUnit ?u2 ; lulcw:layerOrder ?o2 .
        FILTER (?o1 < ?o2)
    }
}""" ] , [
        sh:message "an intervening unit is not between the two units in a witness stack" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:interveningUnit ?value ; lulcw:witnessedBy ?p ;
          lulcw:upperUnit ?u1 ; lulcw:lowerUnit ?u2 .
    FILTER NOT EXISTS {
        ?p lulcw:hasStackLayer ?l1 , ?l2 , ?lm .
        ?l1 lulcw:layerUnit ?u1 ; lulcw:layerOrder ?o1 .
        ?l2 lulcw:layerUnit ?u2 ; lulcw:layerOrder ?o2 .
        ?lm lulcw:layerUnit ?value ; lulcw:layerOrder ?om .
        FILTER (?o1 < ?om && ?om < ?o2)
    }
}""" ] , [
        sh:message "a unit mapped between the two units in a witness stack is missing from the relation" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:witnessedBy ?p ; lulcw:upperUnit ?u1 ; lulcw:lowerUnit ?u2 .
    ?p lulcw:hasStackLayer ?l1 , ?l2 , ?lm .
    ?l1 lulcw:layerUnit ?u1 ; lulcw:layerOrder ?o1 .
    ?l2 lulcw:layerUnit ?u2 ; lulcw:layerOrder ?o2 .
    ?lm lulcw:layerUnit ?value ; lulcw:layerOrder ?om .
    FILTER (?o1 < ?om && ?om < ?o2)
    FILTER NOT EXISTS { $this lulcw:interveningUnit ?value }
}""" ] , [
        sh:message "the relation kind disagrees with its intervening units (direct contact: none; indirect ordering: at least one)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    { $this lulcw:relationKind lulcw:DirectContact ; lulcw:interveningUnit ?x }
    UNION
    { $this lulcw:relationKind lulcw:IndirectOrdering . FILTER NOT EXISTS { $this lulcw:interveningUnit ?y } }
}""" ] .

lulcwsh:ReversedOrderShape a sh:NodeShape ;
    sh:targetClass lulcw:StratigraphicRelation ;
    sh:severity sh:Warning ;
    sh:sparql [
        sh:message "the two units are stacked in the opposite order in another polygon (folding or a mapping inconsistency); both relations are kept" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:upperUnit ?a ; lulcw:lowerUnit ?b .
    ?value lulcw:upperUnit ?b ; lulcw:lowerUnit ?a .
}""" ] .

lulcwsh:OverliesShape a sh:NodeShape ;
    sh:targetSubjectsOf lulcw:overlies ;
    sh:sparql [
        sh:message "lulcw:overlies without a direct-contact stratigraphic relation that witnesses it" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:overlies ?value .
    FILTER NOT EXISTS {
        ?r lulcw:upperUnit $this ; lulcw:lowerUnit ?value ; lulcw:relationKind lulcw:DirectContact .
    }
}""" ] .

#################################################################
# Policy views (CQ1, CQ2)
#################################################################

lulcwsh:MonitorsShape a sh:NodeShape ;
    sh:targetSubjectsOf lulcw:monitors ;
    sh:sparql [
        sh:message "lulcw:monitors without an exact-unit monitoring attribution selected by the main policy" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:monitors ?value .
    FILTER NOT EXISTS {
        ?a lulcw:attributedEntity $this ; lulcw:role lulcw:MonitoringRole ; lulcw:candidateUnit ?value ;
           lulcw:selectedUnder <https://w3id.org/lulcw/data/policy/main> .
    }
}""" ] .

lulcwsh:PumpsFromShape a sh:NodeShape ;
    sh:targetSubjectsOf lulcw:pumpsFrom ;
    sh:sparql [
        sh:message "lulcw:pumpsFrom without an exact-unit abstraction attribution selected by the main policy (group-level evidence never becomes an exact unit)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:pumpsFrom ?value .
    FILTER NOT EXISTS {
        ?a lulcw:attributedEntity $this ; lulcw:role lulcw:AbstractionRole ; lulcw:candidateUnit ?value ;
           lulcw:selectedUnder <https://w3id.org/lulcw/data/policy/main> .
    }
}""" ] .

lulcwsh:ExportPolicyShape a sh:NodeShape ;
    sh:targetClass lulcw:ExportPolicy ;
    sh:property [ sh:path lulcw:admitsConfidence ; sh:minCount 1 ; sh:class lulcw:ConfidenceLevel ] ,
        [ sh:path lulcw:ruleVersion ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path rdfs:comment ; sh:minCount 1 ] .

lulcwsh:DerivationRuleShape a sh:NodeShape ;
    sh:targetClass lulcw:DerivationRule ;
    sh:property [ sh:path rdfs:comment ; sh:minCount 1 ] ,
        [ sh:path lulcw:ruleVersion ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:searchRadiusM ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ] ,
        [ sh:path lulcw:demandThresholdM3 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ] .

#################################################################
# Well links (CQ11)
#################################################################

lulcwsh:WellLinkShape a sh:NodeShape ;
    sh:targetClass lulcw:WellLink ;
    sh:property [ sh:path lulcw:wellA ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:Piezometer ;
          sh:disjoint lulcw:wellB ; sh:message "a well link joins two different piezometers" ] ,
        [ sh:path lulcw:wellB ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:Piezometer ] ,
        [ sh:path lulcw:sharedUnit ; sh:minCount 1 ; sh:class lulcw:HydrogeologicalUnit ] ,
        [ sh:path lulcw:horizontalDistanceM ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minInclusive 0 ] ,
        [ sh:path lulcw:investigationDepthDifferenceM ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minInclusive 0 ] ,
        [ sh:path lulcw:confidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:ConfidenceLevel ] ,
        [ sh:path lulcw:derivationRule ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 2 ] ,
        [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:message "wellA must be the well whose BSS code sorts first (an unordered pair is stored once)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    $this lulcw:wellA ?a ; lulcw:wellB ?b . ?a lulcw:bssCode ?ca . ?b lulcw:bssCode ?cb .
    FILTER (?ca >= ?cb)
}""" ] , [
        sh:message "another well link joins the same two wells" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:wellA ?a ; lulcw:wellB ?b .
    ?value a lulcw:WellLink ; lulcw:wellA ?a ; lulcw:wellB ?b .
    FILTER (?value != $this)
}""" ] , [
        sh:message "the depth difference is stated iff both investigation depths are known, and equals their absolute difference (a missing depth is never 0)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    $this lulcw:wellA ?a ; lulcw:wellB ?b .
    OPTIONAL { ?a lulcw:investigationDepthM ?za }
    OPTIONAL { ?b lulcw:investigationDepthM ?zb }
    OPTIONAL { $this lulcw:investigationDepthDifferenceM ?dz }
    FILTER ((BOUND(?za) && BOUND(?zb)) != BOUND(?dz)
            || (BOUND(?dz) && ABS(?dz - ABS(?za - ?zb)) > 1e-6))
}""" ] , [
        sh:message "a shared unit is not the candidate unit of a monitoring attribution of both wells" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:sharedUnit ?value ; lulcw:wellA ?a ; lulcw:wellB ?b .
    FILTER (NOT EXISTS { ?x lulcw:attributedEntity ?a ; lulcw:role lulcw:MonitoringRole ; lulcw:candidateUnit ?value }
            || NOT EXISTS { ?y lulcw:attributedEntity ?b ; lulcw:role lulcw:MonitoringRole ; lulcw:candidateUnit ?value })
}""" ] , [
        sh:message "the distance exceeds the search radius of the rule that derived the link" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:horizontalDistanceM ?value ; lulcw:derivationRule ?r .
    ?r lulcw:searchRadiusM ?radius .
    FILTER (?value > ?radius)
}""" ] .

#################################################################
# Influences (CQ8)
#################################################################

lulcwsh:InfluenceShape a sh:NodeShape ;
    sh:targetClass lulcw:Influence ;
    sh:property [ sh:path lulcw:driverEntity ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:targetEntity ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:Piezometer ] ,
        [ sh:path lulcw:driverVariable ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:mechanism ; sh:minCount 1 ; sh:class lulcw:Mechanism ] ,
        [ sh:path lulcw:responseSign ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:ResponseSign ] ,
        [ sh:path lulcw:constraintEligibility ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:in ( lulcw:EligibleConstraint lulcw:IneligibleConstraint ) ] ,
        [ sh:path lulcw:eligibilityReason ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:conditions ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:resolution ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:Resolution ] ,
        [ sh:path lulcw:confidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:ConfidenceLevel ] ,
        [ sh:path lulcw:horizontalDistanceM ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ] ,
        [ sh:path lulcw:derivationRule ; sh:minCount 1 ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ;
          sh:message "an influence cites its evidence path" ] ,
        [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:message "an eligible influence needs a supported sign (not unknown or conditional)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    $this lulcw:constraintEligibility lulcw:EligibleConstraint ; lulcw:responseSign lulcw:UnknownResponse .
}""" ] , [
        sh:message "an eligible pumping-drawdown influence rests on exact-unit attributions only" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:constraintEligibility lulcw:EligibleConstraint ; lulcw:mechanism lulcw:PumpingDrawdown ;
          prov:wasDerivedFrom ?value .
    ?value a lulcw:UnitAttribution .
    FILTER NOT EXISTS { ?value lulcw:resolution lulcw:ExactUnitResolution }
}""" ] , [
        sh:message "an attribution without a target (an explicit unknown) supports an influence: missing targets never become model edges" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this prov:wasDerivedFrom ?value .
    ?value a lulcw:UnitAttribution .
    FILTER NOT EXISTS { { ?value lulcw:candidateUnit ?t } UNION { ?value lulcw:candidateGroup ?t } }
}""" ] , [
        sh:message "the evidence path does not join the driver facility to the target well" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    $this lulcw:targetEntity ?w ; lulcw:driverEntity ?f .
    FILTER (NOT EXISTS { $this prov:wasDerivedFrom ?a . ?a lulcw:attributedEntity ?w ; lulcw:role lulcw:MonitoringRole . }
            || NOT EXISTS { $this prov:wasDerivedFrom ?b . ?b lulcw:attributedEntity ?f ; lulcw:role lulcw:AbstractionRole . })
}""" ] , [
        sh:message "the distance exceeds the search radius of the rule that derived the influence" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:horizontalDistanceM ?value ; lulcw:derivationRule ?r .
    ?r lulcw:searchRadiusM ?radius .
    FILTER (?value > ?radius)
}""" ] .

# A path is selected by a policy only if each of its segments is (CQ8: an unaccepted segment
# blocks the path).
lulcwsh:PathSelectionShape a sh:NodeShape ;
    sh:targetClass lulcw:WellLink , lulcw:Influence ;
    sh:sparql [
        sh:message "selected by a policy that does not select every attribution of its evidence path" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:selectedUnder ?value ; prov:wasDerivedFrom ?a .
    ?a a lulcw:UnitAttribution .
    FILTER NOT EXISTS { ?a lulcw:selectedUnder ?value }
}""" ] .

#################################################################
# Geology facts and annual records
#################################################################

lulcwsh:ElementaryPolygonShape a sh:NodeShape ;
    sh:targetClass lulcw:ElementaryPolygon ;
    sh:property [ sh:path lulcw:polygonCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path geo:hasMetricArea ; sh:minCount 1 ; sh:maxCount 1 ; sh:minExclusive 0 ] ,
        [ sh:path geo:hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:hasStackLayer ; sh:minCount 1 ; sh:class lulcw:StackLayer ] ,
        [ sh:path lulcw:inRelease ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:message "two layers of one stack have the same order" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:hasStackLayer ?l1 , ?l2 .
    ?l1 lulcw:layerOrder ?value . ?l2 lulcw:layerOrder ?value .
    FILTER (?l1 != ?l2)
}""" ] .

lulcwsh:StackLayerShape a sh:NodeShape ;
    sh:targetClass lulcw:StackLayer ;
    sh:property [ sh:path lulcw:layerUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:HydrogeologicalUnit ] ,
        [ sh:path lulcw:layerOrder ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ;
          sh:minInclusive 1 ] .

lulcwsh:AnnualAbstractionRecordShape a sh:NodeShape ;
    sh:targetClass lulcw:AnnualAbstractionRecord ;
    sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:AbstractionFacility ] ,
        [ sh:path sosa:observedProperty ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path sosa:hasSimpleResult ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minInclusive 0 ] ,
        [ sh:path sosa:phenomenonTime ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:recordKind ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:waterSource ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:inRelease ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:waterUse ; sh:maxCount 1 ] ,
        [ sh:path sosa:usedProcedure ; sh:maxCount 1 ] .

#################################################################
# Land use (CQ7)
#################################################################

lulcwsh:CropCodeShape a sh:NodeShape ;
    sh:targetClass lulcw:CropCode ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path skos:prefLabel ; sh:minCount 1 ] ,
        [ sh:path skos:inScheme ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:rpgGroupCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path lulcw:cropClass ; sh:maxCount 1 ; sh:class lulcw:CropClass ;
          sh:message "a crop code has at most one crop class (code overrides come before groups)" ] .

lulcwsh:CropClassShape a sh:NodeShape ;
    sh:targetClass lulcw:CropClass ;
    sh:property [ sh:path skos:notation ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:irrigationAssumption ; sh:maxCount 1 ; sh:class lulcw:IrrigationAssumption ] ,
        [ sh:path lulcw:kcInitial ; sh:maxCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 2 ] ,
        [ sh:path lulcw:kcMid ; sh:maxCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 2 ] ,
        [ sh:path lulcw:kcEnd ; sh:maxCount 1 ; sh:minInclusive 0 ; sh:maxInclusive 2 ] ,
        [ sh:path lulcw:plantingMonth ; sh:maxCount 1 ; sh:minInclusive 1 ; sh:maxInclusive 12 ] ;
    sh:sparql [
        sh:message "a crop class other than 'unmapped' states its irrigation assumption" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    $this a lulcw:CropClass .
    FILTER NOT EXISTS { $this lulcw:irrigationAssumption ?a }
    FILTER NOT EXISTS { $this skos:notation "unmapped" }
}""" ] , [
        sh:message "a cropped class states its FAO-56 coefficients, stage lengths and season start" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    $this lulcw:irrigationAssumption ?a .
    FILTER (?a != lulcw:NotCropped)
    FILTER (NOT EXISTS { $this lulcw:kcInitial ?k1 } || NOT EXISTS { $this lulcw:kcMid ?k2 }
            || NOT EXISTS { $this lulcw:kcEnd ?k3 } || NOT EXISTS { $this lulcw:initialStageDays ?s1 }
            || NOT EXISTS { $this lulcw:developmentStageDays ?s2 } || NOT EXISTS { $this lulcw:midSeasonStageDays ?s3 }
            || NOT EXISTS { $this lulcw:lateSeasonStageDays ?s4 } || NOT EXISTS { $this lulcw:plantingMonth ?m })
}""" ] .

lulcwsh:CropDemandZoneShape a sh:NodeShape ;
    sh:targetClass lulcw:CropDemandZone ;
    sh:property [ sh:path lulcw:zoneOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:Piezometer ] ,
        [ sh:path lulcw:zoneRadiusM ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minExclusive 0 ] .

lulcwsh:CropAreaObservationShape a sh:NodeShape ;
    sh:targetClass lulcw:CropAreaObservation ;
    sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:CropDemandZone ] ,
        [ sh:path sosa:observedProperty ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue lulcw:ClippedCropArea ] ,
        [ sh:path sosa:hasSimpleResult ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minInclusive 0 ] ,
        [ sh:path sosa:phenomenonTime ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path sosa:usedProcedure ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:cropCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:CropCode ] ,
        [ sh:path lulcw:rpgEdition ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        # With the class-area checks below (each cited code area matches its class area's zone,
        # year and class; one class area per zone, year and class), every code area is counted
        # once, by the class area of its own zone, year and class.
        [ sh:path [ sh:inversePath prov:wasDerivedFrom ] ;
          sh:qualifiedValueShape [ sh:class lulcw:CropClassArea ] ;
          sh:qualifiedMinCount 1 ; sh:qualifiedMaxCount 1 ;
          sh:message "a code area is counted by exactly one class area" ] ;
    sh:sparql [
        sh:message "an RPG edition states the crops of its own year only (a 2023 observation never answers 2020)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:rpgEdition ?value ; sosa:phenomenonTime ?t .
    ?t time:hasBeginning ?b . ?b time:inXSDDate ?d .
    FILTER (YEAR(?d) != ?value)
}""" ] .

lulcwsh:CropClassAreaShape a sh:NodeShape ;
    sh:targetClass lulcw:CropClassArea ;
    sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:CropDemandZone ] ,
        [ sh:path sosa:hasSimpleResult ; sh:minCount 1 ; sh:maxCount 1 ; sh:minInclusive 0 ] ,
        [ sh:path lulcw:cropClass ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:CropClass ] ,
        [ sh:path lulcw:rpgEdition ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:derivationRule ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:class lulcw:CropAreaObservation ] ;
    sh:sparql [
        sh:message "the class area differs from the sum of the code areas it cites" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this sosa:hasSimpleResult ?value ; prov:wasDerivedFrom ?o .
    ?o sosa:hasSimpleResult ?a .
}
GROUP BY $this ?value
HAVING (ABS(?value - SUM(?a)) > 1e-6)""" ] , [
        sh:message "a cited code area is from another zone, year or class" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this prov:wasDerivedFrom ?value ; sosa:hasFeatureOfInterest ?z ; lulcw:rpgEdition ?ed ;
          lulcw:cropClass ?cls .
    ?value lulcw:cropCode ?code .
    OPTIONAL { ?code lulcw:cropClass ?c . }
    FILTER (NOT EXISTS { ?value sosa:hasFeatureOfInterest ?z ; lulcw:rpgEdition ?ed . }
            || COALESCE(?c, <https://w3id.org/lulcw/data/crop-class/unmapped>) != ?cls)
}""" ] .

# One query over the whole graph, run once (its focus is the class-area rule): a search for the
# class areas of the same zone, year and class, run from each class area, took 0.4 s per class
# area in rdflib (36 min for the 5,465 of dataset v4).
lulcwsh:CropClassAreaKeyShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/crop-class-area> ;
    sh:sparql [
        sh:message "two class areas share a zone, an RPG year and a class" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this (SAMPLE(?ca) AS ?value) WHERE {
    ?ca a lulcw:CropClassArea ; sosa:hasFeatureOfInterest ?z ; lulcw:rpgEdition ?ed ;
        lulcw:cropClass ?cls .
}
GROUP BY $this ?z ?ed ?cls
HAVING (COUNT(DISTINCT ?ca) > 1)""" ] .

lulcwsh:CropDemandEstimateShape a sh:NodeShape ;
    sh:targetClass lulcw:CropDemandEstimate ;
    sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:CropDemandZone ] ,
        [ sh:path sosa:observedProperty ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:in ( lulcw:PotentialIrrigationDemandMain lulcw:PotentialIrrigationDemandWide ) ] ,
        [ sh:path sosa:hasSimpleResult ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minInclusive 0 ] ,
        [ sh:path sosa:phenomenonTime ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path sosa:usedProcedure ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:rpgEdition ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:sparql [
        sh:message "the wide-class estimate is below the main-class estimate of the same zone and year (the wide set contains the main classes)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this sosa:observedProperty lulcw:PotentialIrrigationDemandWide ; sosa:hasSimpleResult ?w ;
          sosa:hasFeatureOfInterest ?z ; lulcw:rpgEdition ?ed .
    ?value sosa:observedProperty lulcw:PotentialIrrigationDemandMain ; sosa:hasFeatureOfInterest ?z ;
           lulcw:rpgEdition ?ed ; sosa:hasSimpleResult ?m .
    FILTER (?w < ?m - 0.5)
}""" ] .

lulcwsh:IrrigationDemandAssessmentShape a sh:NodeShape ;
    sh:targetClass lulcw:IrrigationDemandAssessment ;
    sh:property [ sh:path sosa:hasFeatureOfInterest ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:CropDemandZone ] ,
        [ sh:path lulcw:demandCategory ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:in ( lulcw:HighIrrigationDemand lulcw:BelowHighIrrigationDemand ) ] ,
        [ sh:path sosa:phenomenonTime ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:CropDemandEstimate ] ,
        [ sh:path lulcw:derivationRule ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:sparql [
        sh:message "the category disagrees with the estimate and the threshold of the rule that assessed it" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:demandCategory ?value ; prov:wasDerivedFrom ?e ; lulcw:derivationRule ?r .
    ?e sosa:hasSimpleResult ?v . ?r lulcw:demandThresholdM3 ?thr .
    FILTER ((?v >= ?thr) != (?value = lulcw:HighIrrigationDemand))
}""" ] , [
        sh:message "the assessment's zone or year differs from those of its estimate" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this WHERE {
    $this prov:wasDerivedFrom ?e ; sosa:hasFeatureOfInterest ?z ; sosa:phenomenonTime ?t .
    FILTER NOT EXISTS { ?e sosa:hasFeatureOfInterest ?z ; sosa:phenomenonTime ?t . }
}""" ] .

#################################################################
# Recharge-related forcing (CQ4): weather cells, search zones, intersections, coverage, weights
#################################################################

lulcwsh:WeatherCellShape a sh:NodeShape ;
    sh:targetClass lulcw:WeatherCell ;
    sh:property [ sh:path lulcw:safranGridXHm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path lulcw:safranGridYHm ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ,
        [ sh:path geo:hasGeometry ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path lulcw:hasForcingSeries ; sh:minCount 1 ; sh:class lulcw:ObservationSeries ] ,
        [ sh:path lulcw:inRelease ; sh:minCount 1 ; sh:maxCount 1 ] .

lulcwsh:OutcropSearchZoneShape a sh:NodeShape ;
    sh:targetClass lulcw:OutcropSearchZone ;
    sh:property [ sh:path lulcw:zoneOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:Piezometer ] ,
        [ sh:path lulcw:zoneRadiusM ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minExclusive 0 ] .

lulcwsh:PolygonCellIntersectionShape a sh:NodeShape ;
    sh:targetClass lulcw:PolygonCellIntersection ;
    sh:property [ sh:path lulcw:intersectedPolygon ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:ElementaryPolygon ] ,
        [ sh:path lulcw:intersectedCell ; sh:maxCount 1 ; sh:class lulcw:WeatherCell ] ,
        [ sh:path lulcw:withinExtent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class geo:Feature ] ,
        [ sh:path lulcw:intersectionAreaM2 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minInclusive 1.0 ; sh:message "a piece under 1 m² (a sliver) or a negative area" ] ,
        [ sh:path prov:wasGeneratedBy ; sh:minCount 1 ; sh:maxCount 1 ] .

# Whole-graph checks of the intersections, run once (focus: the execution that computed them).
lulcwsh:PolygonCellIntersectionKeyShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/execution/polygon-cell-intersection> ;
    sh:sparql [
        sh:message "two pieces share a polygon, an extent and a cell (or both are outside every cell)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this (SAMPLE(?x) AS ?value) WHERE {
    ?x a lulcw:PolygonCellIntersection ; lulcw:intersectedPolygon ?p ; lulcw:withinExtent ?s .
    OPTIONAL { ?x lulcw:intersectedCell ?c . }
    BIND (COALESCE(?c, <https://w3id.org/lulcw/data/no-cell>) AS ?cell)
}
GROUP BY $this ?p ?s ?cell
HAVING (COUNT(DISTINCT ?x) > 1)""" ] , [
        sh:message "the pieces of a polygon in one extent exceed the polygon's area (1 m² tolerance: areas are stored to 0.1 m²)" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this (SAMPLE(?p) AS ?value) WHERE {
    ?x a lulcw:PolygonCellIntersection ; lulcw:intersectedPolygon ?p ; lulcw:withinExtent ?s ;
       lulcw:intersectionAreaM2 ?a .
    ?p geo:hasMetricArea ?pa .
}
GROUP BY $this ?p ?s ?pa
HAVING (SUM(?a) > ?pa + 1.0)""" ] .

lulcwsh:OutcropCoverageShape a sh:NodeShape ;
    sh:targetClass lulcw:OutcropCoverage ;
    sh:property [ sh:path lulcw:coverageUnit ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:HydrogeologicalUnit ] ,
        [ sh:path lulcw:withinExtent ; sh:minCount 1 ; sh:maxCount 1 ; sh:class geo:Feature ] ,
        [ sh:path lulcw:outcropAreaM2 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ] ,
        [ sh:path lulcw:coveredAreaM2 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ] ,
        [ sh:path lulcw:coveredFraction ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minInclusive 0 ; sh:maxInclusive 1 ] ,
        [ sh:path lulcw:derivationRule ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path prov:wasDerivedFrom ; sh:minCount 1 ; sh:class lulcw:PolygonCellIntersection ] ,
        [ sh:path lulcw:hasCellWeight ; sh:class lulcw:CellWeight ] ;
    sh:sparql [
        sh:message "the outcrop area differs from the sum of the pieces it cites" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:outcropAreaM2 ?value ; prov:wasDerivedFrom ?x .
    ?x lulcw:intersectionAreaM2 ?a .
}
GROUP BY $this ?value
HAVING (ABS(?value - SUM(?a)) > 1e-6 * ?value)""" ] , [
        sh:message "a cited piece is from another extent, or from a polygon where the unit is not at outcrop" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this prov:wasDerivedFrom ?value ; lulcw:withinExtent ?s ; lulcw:coverageUnit ?u .
    ?value lulcw:intersectedPolygon ?p .
    FILTER (NOT EXISTS { ?value lulcw:withinExtent ?s . }
            || NOT EXISTS { ?p lulcw:hasStackLayer ?l . ?l lulcw:layerOrder 1 ; lulcw:layerUnit ?u . })
}""" ] , [
        sh:message "the covered fraction is not the covered area divided by the outcrop area" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:coveredFraction ?value ; lulcw:coveredAreaM2 ?c ; lulcw:outcropAreaM2 ?o .
    FILTER (ABS(?value - ?c / ?o) > 1e-9)
}""" ] , [
        sh:message "the cell weights of a covered outcrop do not sum to one, or do not add up to its covered area" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this (SUM(?w) AS ?value) WHERE {
    $this lulcw:coveredAreaM2 ?tot .
    FILTER (?tot > 0)
    OPTIONAL { $this lulcw:hasCellWeight ?cw . ?cw lulcw:cellWeight ?w0 ; lulcw:coveredAreaM2 ?a0 . }
    BIND (COALESCE(?w0, 0.0) AS ?w)
    BIND (COALESCE(?a0, 0.0) AS ?a)
}
GROUP BY $this ?tot
HAVING (ABS(SUM(?w) - 1) > 1e-9 || ABS(SUM(?a) - ?tot) > 1e-6 * ?tot)""" ] .

lulcwsh:MappedOutcropShape a sh:NodeShape ;
    sh:targetSubjectsOf lulcw:mappedOutcropAreaM2 ;
    sh:property [ sh:path lulcw:mappedOutcropAreaM2 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minInclusive 0 ] ;
    sh:sparql [
        sh:message "an outcrop coverage exceeds the unit's whole mapped outcrop" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this ?value WHERE {
    $this lulcw:mappedOutcropAreaM2 ?m .
    ?value lulcw:coverageUnit $this ; lulcw:outcropAreaM2 ?a .
    FILTER (?a > ?m * (1 + 1e-6) + 1.0)
}""" ] .

lulcwsh:CellWeightShape a sh:NodeShape ;
    sh:targetClass lulcw:CellWeight ;
    sh:property [ sh:path lulcw:weightCell ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lulcw:WeatherCell ] ,
        [ sh:path lulcw:cellWeight ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ;
          sh:minExclusive 0 ; sh:maxInclusive 1 ] ,
        [ sh:path lulcw:coveredAreaM2 ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:double ; sh:minExclusive 0 ] ,
        [ sh:path [ sh:inversePath lulcw:hasCellWeight ] ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:class lulcw:OutcropCoverage ; sh:message "a cell weight belongs to exactly one outcrop coverage" ] .

lulcwsh:OutcropCoverageKeyShape a sh:NodeShape ;
    sh:targetNode <https://w3id.org/lulcw/data/rule/outcrop-coverage> ;
    sh:sparql [
        sh:message "two outcrop coverages share an extent and a unit" ;
        sh:prefixes <https://w3id.org/lulcw/shapes> ;
        sh:select """
SELECT $this (SAMPLE(?v) AS ?value) WHERE {
    ?v a lulcw:OutcropCoverage ; lulcw:withinExtent ?s ; lulcw:coverageUnit ?u .
}
GROUP BY $this ?s ?u
HAVING (COUNT(DISTINCT ?v) > 1)""" ] .
