    owl:versionIRI <https://w3id.org/lulcw/profile/fr/0.11.0> ;
    owl:versionInfo "0.11.0" ;
    dcterms:title "LULC-Water France profile"@en , "Profil France LULC-Water"@fr ;
    dcterms:description "Thin French country adapter profile for the LULC-Water ontology network, declaring French national agency register codes and reference dataset attributes (BD LISA, BNPE, BSS, BD Carthage, BD TOPO, RPG, SAFRAN) outside the pan-Mediterranean core."@en ,
        "Profil adaptateur France du réseau d'ontologies LULC-Water, déclarant les codes de registres nationaux et attributs de jeux de données français (BD LISA, BNPE, BSS, BD Carthage, BD TOPO, RPG, SAFRAN) hors du noyau pan-méditerranéen."@fr ;
    dcterms:creator "Assil Bouzaine" ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:created "2026-11-26"^^xsd:date ;
    owl:imports <https://w3id.org/lulcw/core> , <https://w3id.org/lulcw/hydro> , <https://w3id.org/lulcw/imports/skos> .

